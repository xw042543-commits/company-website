# Copy this file to an untracked .env.production file and replace every placeholder.
# Never commit real credentials.

PUBLIC_SITE_URL=https://preview.yangdoujiao.com
PUBLIC_INDEXING_ENABLED=false
API_BASE_URL=http://backend:8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://preview.yangdoujiao.com

POSTGRES_DB=company_website
POSTGRES_USER=company_app
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200

# Private preview safeguards
APP_CONSULTATION_SUBMISSION_ENABLED=false
APP_CONSULTATION_PRIVACY_NOTICE_VERSION=
APP_CONSULTATION_MAXIMUM_BODY_SIZE=16KB
APP_CONSULTATION_RATE_LIMIT_MAXIMUM_SUBMISSIONS=5
APP_CONSULTATION_RATE_LIMIT_WINDOW=10m

# Authentication stays closed until the real notification provider and legal versions are approved.
APP_AUTH_REGISTRATION_ENABLED=false
APP_AUTH_AGREEMENT_VERSION=
APP_AUTH_PRIVACY_VERSION=
APP_SESSION_COOKIE_SECURE=true
APP_AUTH_PRODUCTION_NOTIFICATION_PROVIDER=NONE
APP_AUTH_APPROVED_DOMAIN=YANGDOUJIAO_COM
APP_AUTH_PUBLIC_SITE_ORIGIN=https://preview.yangdoujiao.com
APP_AUTH_PRODUCTION_LAUNCH_APPROVED=false

# WeChat Open Platform website QR login. Keep disabled until the official
# company-owned application and HTTPS callback domain have been approved.
APP_AUTH_WECHAT_ENABLED=false
APP_AUTH_WECHAT_APP_ID=
APP_AUTH_WECHAT_APP_SECRET=
APP_AUTH_WECHAT_CALLBACK_URL=
APP_AUTH_WECHAT_STATE_TTL=5m
APP_AUTH_WECHAT_BINDING_TTL=15m

# Frontend host binding for a local reverse proxy or hosting edge
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# Choose a private subnet that does not overlap the host, VPN, or existing Docker networks.
DEPLOYMENT_NETWORK_SUBNET=172.30.0.0/24
FRONTEND_INTERNAL_IP=172.30.0.10
BACKEND_INTERNAL_IP=172.30.0.20

# Optional immutable registry images. Keep the defaults for a host build.
FRONTEND_IMAGE=udajo/frontend:preview
BACKEND_IMAGE=udajo/backend:preview
