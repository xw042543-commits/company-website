{
	email {$CADDY_ACME_EMAIL}
	log default {
		exclude http.log.error.review_media
	}
	log review_media_errors {
		include http.log.error.review_media
		format filter {
			request>uri replace /api/v1/community/image-review/media/REDACTED
			request>headers delete
			request>remote_ip delete
			request>client_ip delete
		}
	}
}

{$CADDY_SITE_ADDRESSES} {
	@www host www.yangdoujiao.com
	redir @www https://yangdoujiao.com{uri} permanent
	log review_media {
		no_hostname
		format filter {
			request>uri replace /api/v1/community/image-review/media/REDACTED
			request>headers delete
			request>remote_ip delete
			request>client_ip delete
		}
	}

	encode zstd gzip

	@imageUpload path /api/v1/community/images
	request_body @imageUpload {
		max_size 6MB
	}
	@imageCallback path /api/v1/community/image-review/callback
	request_body @imageCallback {
		max_size 100KB
	}
	@communityReviewMedia path /api/v1/community/image-review/media/*
	log_name @communityReviewMedia review_media
	reverse_proxy @communityReviewMedia backend:8080 {
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -X-Real-IP
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
	}

	reverse_proxy frontend:3000 {
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -X-Real-IP
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
	}
}
