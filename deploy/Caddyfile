{
	email {$CADDY_ACME_EMAIL}
}

{$CADDY_SITE_ADDRESSES} {
	@www host www.yangdoujiao.com
	redir @www https://yangdoujiao.com{uri} permanent

	encode zstd gzip

	@imageUpload path /api/v1/community/images
	request_body @imageUpload {
		max_size 6MB
	}
	@imageCallback path /api/v1/community/image-review/callback
	request_body @imageCallback {
		max_size 100KB
	}

	reverse_proxy frontend:3000 {
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -X-Real-IP
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
	}
}
