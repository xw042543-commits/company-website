# Copy this file to deploy/.env on the server. Never commit deploy/.env.
SITE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=company_website
POSTGRES_USER=company_app
POSTGRES_PASSWORD=replace_with_a_long_random_password

REDIS_PASSWORD=replace_with_a_different_long_random_password

ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace_with_another_long_random_password

CORS_ALLOWED_ORIGINS=https://example.com
API_BASE_URL=http://backend:8080

# Java container memory limit is 2 GB; keep the heap below that limit.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=25
DB_POOL_SIZE=10
