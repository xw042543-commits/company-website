.app-state { padding: 64rpx 32rpx; text-align: center; }
.state-symbol { color: #16865f; font-size: 52rpx; font-weight: 800; }
.state-title { margin-top: 20rpx; color: #123f35; font-size: 30rpx; font-weight: 750; }
.state-description { margin-top: 12rpx; color: #697d78; font-size: 25rpx; line-height: 1.65; }
.retry-button { width: 240rpx; margin-top: 28rpx; background: #16865f; color: #fff; font-size: 26rpx; }
.skeleton{display:flex;max-width:650rpx;margin:0 auto 34rpx;flex-direction:column;gap:18rpx;text-align:left}.skeleton-row{display:flex;padding:20rpx;border:1rpx solid #e0ebe7;border-radius:20rpx;background:#fff}.skeleton-thumb,.skeleton-lines view{position:relative;overflow:hidden;background:#e9f1ee}.skeleton-thumb::after,.skeleton-lines view::after{position:absolute;top:0;bottom:0;left:-80%;width:65%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.8),transparent);content:"";animation:skeleton-shine 1.35s ease-in-out infinite}.skeleton-thumb{width:116rpx;height:92rpx;flex:0 0 auto;border-radius:14rpx}.skeleton-lines{display:flex;flex:1;margin-left:20rpx;flex-direction:column;gap:12rpx}.skeleton-lines view{height:17rpx;border-radius:999rpx}.skeleton-lines view:first-child{width:72%;height:23rpx}.skeleton-lines view:last-child{width:46%}@keyframes skeleton-shine{to{left:125%}}@media (prefers-reduced-motion:reduce){.skeleton-thumb::after,.skeleton-lines view::after{animation:none}}
