<view class="app-state app-state--{{kind}}">
  <view wx:if="{{kind === 'loading'}}" class="skeleton" aria-hidden="true">
    <view class="skeleton-row"><view class="skeleton-thumb"></view><view class="skeleton-lines"><view></view><view></view><view></view></view></view>
    <view class="skeleton-row"><view class="skeleton-thumb"></view><view class="skeleton-lines"><view></view><view></view><view></view></view></view>
    <view class="skeleton-row"><view class="skeleton-thumb"></view><view class="skeleton-lines"><view></view><view></view><view></view></view></view>
  </view>
  <view class="state-symbol">{{kind === 'loading' ? '…' : kind === 'empty' ? '○' : '!'}}</view>
  <view class="state-title">{{title}}</view>
  <view class="state-description">{{description}}</view>
  <button wx:if="{{retryable}}" class="retry-button" bindtap="retry">重新加载</button>
</view>
