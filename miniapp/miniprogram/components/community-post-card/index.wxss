.post-card {
  box-sizing: border-box;
  padding: 28rpx;
  border: 1rpx solid rgba(200, 217, 210, 0.86);
  border-radius: var(--radius-card);
  background: #fff;
  box-shadow: var(--shadow-card);
}
.post-head { display: flex; min-width: 0; align-items: center; }
.avatar,
.avatar-fallback { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 50%; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; background: #e5f2ed; color: var(--color-action); font-size: 32rpx; font-weight: 800; }
.author-copy { min-width: 0; flex: 1; margin-left: 20rpx; }
.author-name { overflow: hidden; color: var(--color-deep); font-size: 28rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.post-time { margin-top: 4rpx; color: var(--color-muted); font-size: 22rpx; }
.text-action,
.metric-button { min-height: 88rpx; margin: 0; background: transparent; color: var(--color-muted); font-size: 24rpx; line-height: 88rpx; }
.text-action { min-width: 96rpx; padding: 0 10rpx; }
.text-action:active,
.metric-button:active { opacity: 0.58; }
.post-body { padding: 20rpx 0 10rpx; color: var(--color-ink); font-size: 29rpx; line-height: 1.7; overflow-wrap: anywhere; }
.post-actions { display: flex; justify-content: flex-end; gap: 10rpx; }
.metric-button { display: flex; min-width: 112rpx; align-items: center; justify-content: center; gap: 12rpx; padding: 0 18rpx; }
.metric-button--active { color: var(--color-action); font-weight: 700; }
.metric-button--disabled { opacity: 0.46; }
.comment-icon { box-sizing: border-box; width: 30rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 9rpx; }
.heart-icon { position: relative; box-sizing: border-box; width: 28rpx; height: 28rpx; transform: rotate(45deg) scale(0.72); border-right: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; }
.heart-icon::before,
.heart-icon::after { position: absolute; width: 22rpx; height: 22rpx; border: 4rpx solid currentColor; border-radius: 50%; content: ""; }
.heart-icon::before { left: -14rpx; bottom: -4rpx; border-right: 0; }
.heart-icon::after { top: -14rpx; right: -4rpx; border-bottom: 0; }
.heart-icon--active { background: var(--color-action); color: var(--color-action); }
