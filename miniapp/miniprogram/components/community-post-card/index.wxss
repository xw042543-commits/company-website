.post-card {
  position: relative;
  box-sizing: border-box;
  min-height: 220rpx;
  padding: 24rpx 0 26rpx;
  background: #fff;
  color: #24282B;
  --color-action: #087C49;
  --color-deep: #24282B;
  --color-muted: #707579;
}
.post-card::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #E6ECE8; content: ""; }
.post-head { position: relative; display: flex; min-width: 0; align-items: center; }
.avatar,
.avatar-fallback { position: relative; z-index: 1; box-sizing: border-box; width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border: 0; border-radius: 50%;  }
.avatar-fallback { display: flex; align-items: center; justify-content: center; background: #E6F2EC; color: var(--color-action); font-size: 30rpx; font-weight: 800; }
.author-copy { min-width: 0; flex: 1; margin-left: 18rpx; }
.author-name { color: var(--color-deep); font-size: 27rpx; font-weight: 700; overflow-wrap: anywhere; word-break: break-all; }
.post-time { margin-top: 4rpx; color: #707579; font-size: 20rpx; letter-spacing: .5rpx; }
.text-action,
.metric-button { min-height: 44px; margin: 0; background: transparent; color: var(--color-muted); font-size: 23rpx; line-height: 44px; }
.text-action { min-width: 44px; padding: 0 8rpx; color: #65736B; }
.text-action:active,
.metric-button:active { opacity: .58; }
.post-content { padding-top: 8rpx; }
.report-dots { display: flex; align-items: center; justify-content: center; gap: 6rpx; height: 44px; }
.report-dot { width: 4rpx; height: 4rpx; border-radius: 50%; background: currentColor; }
.post-category { flex: 1; color: #087C49; font-size: 22rpx; line-height: 1.5; }
.post-title { margin-top: 14rpx; color: var(--color-deep); font-size: 33rpx; font-weight: 760; line-height: 1.45; letter-spacing: -.5rpx; overflow-wrap: anywhere; word-break: break-all; }
.post-body { padding: 11rpx 0 4rpx; color: #50575B; font-size: 28rpx; line-height: 1.72; overflow-wrap: anywhere; word-break: break-all; }
.post-actions { display: flex; align-items: center; justify-content: flex-end; gap: 18rpx; margin-top: 14rpx; }
.metric-button { display: flex; min-width: 44px; align-items: center; justify-content: flex-start; gap: 10rpx; padding: 0 12rpx 0 0; }
.metric-button--active { color: var(--color-action); font-weight: 700; }
.metric-button--disabled { opacity: .46; }
.comment-icon { position: relative; box-sizing: border-box; width: 29rpx; height: 23rpx; border: 3rpx solid currentColor; border-radius: 8rpx; }
.comment-icon::after { position: absolute; left: 4rpx; bottom: -7rpx; width: 7rpx; height: 7rpx; border-left: 3rpx solid currentColor; transform: skew(-24deg); content: ""; }
.heart-icon { display: block; width: 32rpx; height: 32rpx; }
