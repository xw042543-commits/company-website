.university-card { overflow:hidden; border:1rpx solid #e1e9e4; border-radius:24rpx; background:#fff; }
.campus { position:relative; height:352rpx; overflow:hidden; }
.campus-image { width:100%; height:100%; }
.campus-caption { position:absolute; right:0; bottom:0; left:0; padding:70rpx 28rpx 24rpx; }
.campus--photo .campus-caption { background:linear-gradient(transparent,rgba(8,29,23,.85)); color:#fff; }
.university-name { font-size:34rpx; line-height:1.4; font-weight:700; letter-spacing:.5rpx; }
.university-location { margin-top:8rpx; font-size:23rpx; line-height:1.5; opacity:.85; }
.campus--identity { height:300rpx; background:#edf4f0; color:#173f33; }
.identity-mark { position:absolute; top:26rpx; left:28rpx; width:108rpx; height:108rpx; padding:10rpx; box-sizing:border-box; background:#fff; border-radius:16rpx; }
.university-logo { width:100%; height:100%; }
.university-monogram { color:#16804f; font-size:48rpx; font-weight:700; line-height:88rpx; text-align:center; }
.favorite-button { position:absolute; top:20rpx; right:20rpx; display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; margin:0; padding:0; border-radius:50%; background:rgba(255,255,255,.96); color:#285342; font-size:42rpx; line-height:1; }
.favorite-button::after { border:0; }
.favorite-button--active { color:#07834b; }
.university-footer { padding:22rpx 28rpx 24rpx; }
.university-name-en { color:#495e56; font-size:25rpx; line-height:1.5; }
.course-link { display:flex; align-items:center; justify-content:space-between; margin-top:14rpx; color:#087c49; font-size:23rpx; }
.course-arrow { font-size:32rpx; line-height:1; }
