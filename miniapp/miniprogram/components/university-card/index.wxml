<view class="university-card" bindtap="select">
  <view class="campus {{university.coverImageUrl && !coverFailed ? 'campus--photo' : 'campus--identity'}}">
    <image wx:if="{{university.coverImageUrl && !coverFailed}}" class="campus-image" src="{{university.coverImageUrl}}" mode="aspectFill" lazy-load binderror="coverError" />
    <view wx:else class="identity-mark">
      <image wx:if="{{university.imageUrl && !imageFailed}}" class="university-logo" src="{{university.imageUrl}}" mode="aspectFit" lazy-load binderror="imageError" />
      <view wx:else class="university-monogram">U</view>
    </view>
    <view class="campus-caption">
      <view class="university-name">{{university.nameZh}}</view>
      <view class="university-location">{{university.location || '地点资料待补充'}}</view>
    </view>
    <button class="favorite-button {{favorite ? 'favorite-button--active' : ''}}" catchtap="toggleFavorite" aria-label="{{favorite ? '取消收藏' : '收藏院校'}}">{{favorite ? '♥' : '♡'}}</button>
  </view>
  <view class="university-footer">
    <view class="university-name-en">{{university.nameEn}}</view>
    <view class="course-link"><text>{{university.programmeCount}} 个匹配专业</text><text class="course-arrow">↗</text></view>
  </view>
</view>
