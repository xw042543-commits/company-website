:host { display:block; }
.university-result-card { position:relative; overflow:hidden; border-radius:20rpx; background:var(--color-navy,#173d5b); }
.university-selection { position:relative; display:flex; box-sizing:border-box; width:100%; min-height:420rpx; margin:0; padding:176rpx 28rpx 28rpx; flex-direction:column; justify-content:flex-end; border-radius:20rpx; background:var(--color-navy,#173d5b); color:var(--color-paper,#fdfcf8); text-align:left; line-height:1.5; }
.university-selection::after,.favorite-button::after { border:0; }
.campus-image,.campus-fallback,.photo-shade { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; }
.campus-fallback { box-sizing:border-box; display:flex; padding:36rpx 148rpx 0 28rpx; flex-direction:column; background:var(--color-navy,#173d5b); }
.fallback-brand { color:var(--color-mint,#dff4ea); font-size:32rpx; font-weight:700; }
.fallback-copy { margin-top:4rpx; color:var(--color-paper,#fdfcf8); font-size:22rpx; }
.photo-shade { background:linear-gradient(180deg,rgba(23,61,91,0) 0,rgba(23,61,91,0) 38%,rgba(23,61,91,.52) 62%,rgba(23,61,91,.78) 100%); }
.university-identity { position:relative; width:100%; min-width:0; text-shadow:0 2rpx 8rpx rgba(23,61,91,.8); }
.university-name { font-size:36rpx; font-weight:700; line-height:1.3; overflow-wrap:break-word; word-break:break-word; }
.university-name-en { margin-top:8rpx; font-size:25rpx; line-height:1.45; overflow-wrap:break-word; word-break:break-word; }
.university-location { margin-top:14rpx; color:var(--color-paper,#fdfcf8); font-size:23rpx; line-height:1.5; overflow-wrap:break-word; }
.favorite-button { position:absolute; top:18rpx; right:18rpx; display:flex; width:44px; height:44px; min-height:44px; margin:0; padding:0; align-items:center; justify-content:center; border-radius:44rpx; background:var(--color-paper,#fdfcf8); color:var(--color-action,#286858); font-size:44rpx; line-height:1; }
.favorite-button--active { background:var(--color-action,#286858); color:var(--color-mint,#dff4ea); }
.favorite-button--pressed { opacity:.82; }
.university-selection--pressed { opacity:.92; }
.university-selection--light { padding-top:204rpx; background:var(--color-paper,#fdfcf8); color:var(--color-navy,#173d5b); border:1rpx solid var(--color-line,#c8d9d2); }
.university-logo { position:absolute; top:24rpx; left:28rpx; width:calc(100% - 160rpx); height:150rpx; }
.university-selection--light .university-identity { text-shadow:none; }
.university-selection--light .university-location,.university-selection--light .university-name-en { color:var(--color-muted,#536a63); }
.university-selection--light .campus-fallback { background:var(--color-wash,#eef5f1); }
.university-selection--light .fallback-brand { color:var(--color-action,#286858); }
.university-selection--light .fallback-copy { color:var(--color-muted,#536a63); }
