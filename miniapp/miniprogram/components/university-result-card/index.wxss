:host { display:block; }
.university-result-card { position:relative; overflow:hidden; border-radius:20rpx; background:#243731; }
.university-selection { position:relative; display:flex; box-sizing:border-box; width:100%; min-height:420rpx; margin:0; padding:176rpx 28rpx 28rpx; flex-direction:column; justify-content:flex-end; border-radius:20rpx; background:#243731; color:#fdfdfb; text-align:left; line-height:1.5; }
.university-selection::after,.favorite-button::after { border:0; }
.campus-image,.campus-fallback,.photo-shade { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; }
.campus-fallback { box-sizing:border-box; display:flex; padding:36rpx 148rpx 0 28rpx; flex-direction:column; background:#34443d; }
.fallback-brand { color:#f5d66f; font-size:32rpx; font-weight:700; }
.fallback-copy { margin-top:4rpx; color:#fdfdfb; font-size:22rpx; }
.photo-shade { background:linear-gradient(180deg,rgba(14,22,19,0) 0,rgba(14,22,19,.06) 100rpx,rgba(14,22,19,.86) 176rpx,#0e1613 100%); }
.university-identity { position:relative; width:100%; min-width:0; }
.university-name { font-size:36rpx; font-weight:700; line-height:1.3; overflow-wrap:break-word; word-break:break-word; }
.university-name-en { margin-top:8rpx; font-size:25rpx; line-height:1.45; overflow-wrap:break-word; word-break:break-word; }
.university-location { margin-top:14rpx; color:#f0f2ee; font-size:23rpx; line-height:1.5; overflow-wrap:break-word; }
.favorite-button { position:absolute; top:18rpx; right:18rpx; display:flex; width:104rpx; height:104rpx; min-height:104rpx; margin:0; padding:0; align-items:center; justify-content:center; border-radius:52rpx; background:#18251f; color:#fdfdfb; font-size:48rpx; line-height:1; }
.favorite-button--active { color:#f5d66f; }
.favorite-button--pressed { opacity:.82; }
.university-selection--pressed { opacity:.92; }
