.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;margin:24rpx 0}.gallery--single{display:block;max-width:600rpx}.tile{height:190rpx;overflow:hidden;border-radius:12rpx;background:#edf2ef}.photo{display:block;width:100%;height:100%}.retry,.loading{display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:0;border:0;border-radius:0;background:transparent;color:#53685c;font-size:24rpx;line-height:1.5;text-align:center}.retry::after{border:0}
