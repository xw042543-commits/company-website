<view class="about-page">
  <view class="brand-card">
    <image class="brand-logo" src="/assets/brand/udajo-logo-transparent.png" mode="aspectFit" aria-label="洋豆角 UDAJO" />
    <view class="brand-title">让留学选择更清晰</view>
    <view class="brand-copy">洋豆角为学生提供院校与专业查询、留学规划、申请进度管理和真实经验交流服务。</view>
  </view>
  <view class="about-card">
    <view class="section-title">我们提供</view>
    <view class="service-row"><text class="service-dot">1</text><view><view>院校与专业查询</view><text>按国家、学历和专业方向筛选资料</text></view></view>
    <view class="service-row"><text class="service-dot">2</text><view><view>申请进度管理</view><text>集中查看材料、费用和录取阶段</text></view></view>
    <view class="service-row"><text class="service-dot">3</text><view><view>U圈交流</view><text>分享真实的留学问题和经验</text></view></view>
  </view>
  <view class="about-card contact-card">
    <view><view class="section-title">联系我们</view><view class="contact-email">{{email}}</view></view>
    <button bindtap="copyEmail">复制邮箱</button>
  </view>
  <view class="version-copy">UDAJO 小程序 · 版本 {{version}}</view>
</view>
