.about-page{box-sizing:border-box;min-height:100vh;padding:28rpx;background:var(--color-wash)}.brand-card,.about-card{border-radius:26rpx;background:#fff;box-shadow:var(--shadow-card)}.brand-card{padding:42rpx 32rpx;text-align:center}.brand-logo{width:260rpx;height:104rpx}.brand-title{margin-top:22rpx;color:var(--color-action);font-size:36rpx;font-weight:800}.brand-copy{margin-top:18rpx;color:var(--color-muted);font-size:25rpx;line-height:1.75}.about-card{margin-top:24rpx;padding:30rpx}.section-title{color:var(--color-ink);font-size:30rpx;font-weight:800}.service-row{display:flex;align-items:flex-start;margin-top:26rpx}.service-dot{display:flex;width:46rpx;height:46rpx;flex:0 0 auto;align-items:center;justify-content:center;margin-right:18rpx;border-radius:50%;background:var(--color-mint);color:var(--color-action);font-weight:800}.service-row view view{color:var(--color-ink);font-weight:700}.service-row view text{display:block;margin-top:6rpx;color:var(--color-muted);font-size:23rpx}.contact-card{display:flex;align-items:center;justify-content:space-between}.contact-email{margin-top:10rpx;color:var(--color-muted);font-size:23rpx}.contact-card button{margin:0;padding:12rpx 22rpx;border-radius:999rpx;background:var(--color-action);color:#fff;font-size:23rpx}.contact-card button::after{border:0}.version-copy{padding:34rpx 0;color:var(--color-muted);font-size:21rpx;text-align:center}
