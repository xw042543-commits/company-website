.home-page { min-height: 100vh; background: #f8fcfa; color: #17251f; }
.home-hero { position: relative; box-sizing: content-box; height: 600rpx; overflow: hidden; border-radius: 0 0 24rpx 24rpx; background: #edf6f0; }
.brand-row { position: relative; z-index: 3; display: flex; width: 240rpx; height: 44px; align-items: center; gap: 14rpx; padding-left: 32rpx; pointer-events: none; }
.brand-logo { display: block; width: 88rpx; height: 88rpx; background: transparent; }
.hero-swiper { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.hero-slide { position: relative; height: 100%; background: #e9f5ee; }
.hero-image { position: absolute; width: 100%; height: 100%; }
.hero-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(90deg, rgba(242,249,245,.8), rgba(242,249,245,.5) 40%, transparent 68%), linear-gradient(0deg, rgba(230,246,237,.9), transparent 32%); pointer-events: none; }
.hero-shade--campus { background: linear-gradient(90deg, rgba(241,249,244,.98), rgba(241,249,244,.84) 45%, rgba(241,249,244,.05)); }
.hero-copy { position: absolute; z-index: 2; left: 32rpx; right: 26rpx; bottom: 48rpx; }
.hero-pill { display: inline-block; padding: 5rpx 14rpx; border-radius: 5rpx; background: #00864b; color: #fff; font-size: 21rpx; font-weight: 600; }
.hero-title { max-width: 485rpx; margin-top: 16rpx; color: #10231b; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.hero-title-line, .hero-description-line { display: block; }
.hero-description { max-width: 390rpx; margin-top: 12rpx; color: #344a40; font-size: 23rpx; line-height: 1.65; }
.hero-arrow { width: 42rpx; height: 42rpx; margin-top: 20rpx; }
.hero-dots { position: absolute; z-index: 3; display: flex; align-items: center; justify-content: center; gap: 8rpx; right: 0; bottom: 20rpx; left: 0; pointer-events: none; }
.hero-dot { width: 8rpx; height: 8rpx; border-radius: 8rpx; background: #b7c8bf; }
.hero-dot--active { width: 28rpx; background: #00854c; }
.home-content { padding: 30rpx 28rpx 24rpx; }
.search-entry { display: flex; box-sizing: border-box; height: 72rpx; padding: 0 20rpx; align-items: center; border: 1rpx solid #e1eae5; border-radius: 12rpx; background: #fff; }
.search-icon { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.search-copy { margin-left: 16rpx; font-size: 23rpx; color: #68776f; }
.feature-grid { display: flex; justify-content: space-between; margin-top: 26rpx; }
.feature-item { flex: 1; min-width: 0; padding: 0 2rpx; text-align: center; }
.feature-icon { display: flex; width: 88rpx; height: 88rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 50%; background: #e9f7ef; }
.feature-icon--orange { background: #fff3e8; }
.feature-symbol { width: 44rpx; height: 44rpx; }
.feature-label { margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 0 14rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.section-more { display: flex; align-items: center; gap: 8rpx; min-height: 64rpx; font-size: 22rpx; color: #007646; }
.university-scroll { width: calc(100% + 28rpx); white-space: nowrap; }
.university-row { display: inline-flex; align-items: stretch; gap: 14rpx; padding: 0 28rpx 6rpx 0; }
.campus-card { width: 226rpx; overflow: hidden; flex-shrink: 0; border: 1rpx solid #e4ece7; border-radius: 14rpx; background: #fff; white-space: normal; }
.campus-photo-wrap { position: relative; height: 142rpx; background: #e8f3ed; }
.campus-photo, .campus-photo-fallback { width: 100%; height: 100%; }
.campus-photo-fallback { display: flex; align-items: center; justify-content: center; }
.campus-fallback-icon { width: 56rpx; height: 56rpx; opacity: .55; }
.favorite-button { position: absolute; top: 5rpx; right: 5rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.93); }
.favorite-button::after { border: 0; }
.favorite-icon { width: 30rpx; height: 30rpx; }
.campus-details { padding: 12rpx 14rpx 16rpx; }
.campus-logo-wrap { display: flex; height: 65rpx; align-items: center; margin-bottom: 10rpx; }
.campus-logo { width: 85rpx; height: 62rpx; }
.campus-logo-placeholder { width: 40rpx; height: 40rpx; }
.campus-name { min-height: 34rpx; font-size: 24rpx; line-height: 1.4; font-weight: 600; }
.campus-name-en { height: 52rpx; margin-top: 5rpx; overflow: hidden; color: #68776f; font-size: 19rpx; line-height: 1.4; }
.campus-location { display: flex; align-items: center; margin-top: 8rpx; gap: 5rpx; color: #68776f; font-size: 18rpx; }
.location-icon { width: 19rpx; height: 19rpx; flex-shrink: 0; }
.location-copy { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
