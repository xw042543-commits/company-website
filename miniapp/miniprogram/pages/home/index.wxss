.home-page { min-height:100vh; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); background:#f7fbf9; }
.home-top { padding:26rpx 24rpx 0; background:linear-gradient(145deg,#e8fff5 0%,#f4fbff 55%,#fff9ef 100%); }
.brand-row { display:flex; align-items:center; gap:14rpx; padding:6rpx 8rpx 22rpx; }
.brand-mark { display:flex; gap:6rpx; }
.brand-mark view { width:16rpx; height:16rpx; border-radius:50%; background:#079b55; }
.brand-name { color:#153f36; font-size:27rpx; font-weight:800; line-height:1; }
.brand-latin { margin-top:4rpx; color:#526d65; font-size:18rpx; font-weight:700; letter-spacing:2rpx; }
.hero-swiper,.hero-static { height:420rpx; overflow:hidden; border-radius:30rpx; box-shadow:0 22rpx 60rpx rgba(20,74,58,.16); }
.hero-slide,.hero-static { position:relative; height:100%; background:linear-gradient(135deg,#0e8051,#174b73); }
.hero-image,.hero-fallback,.hero-shade { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; }
.hero-fallback { background:radial-gradient(circle at 78% 28%,rgba(151,235,194,.65),transparent 24%),linear-gradient(135deg,#0f8754,#176b71 60%,#214f7a); }
.hero-orbit { position:absolute; right:-36rpx; top:46rpx; width:280rpx; height:280rpx; border:2rpx solid rgba(255,255,255,.35); border-radius:50%; box-shadow:0 0 0 46rpx rgba(255,255,255,.06); }
.hero-shade { background:linear-gradient(90deg,rgba(8,48,37,.88) 0%,rgba(8,48,37,.50) 56%,rgba(8,48,37,.06)); }
.hero-copy { position:absolute; z-index:2; left:34rpx; right:34rpx; bottom:48rpx; color:#fff; }
.hero-pill { display:inline-flex; padding:8rpx 16rpx; border-radius:8rpx; background:#08a95e; font-size:20rpx; font-weight:700; }
.hero-title { max-width:520rpx; margin-top:18rpx; font-size:43rpx; font-weight:850; line-height:1.16; }
.hero-subtitle { max-width:520rpx; margin-top:8rpx; font-size:22rpx; line-height:1.35; opacity:.9; }
.hero-meta { margin-top:14rpx; font-size:21rpx; opacity:.85; }
.hero-link { margin-top:18rpx; font-size:24rpx; font-weight:750; }
.home-content { padding:26rpx 24rpx; }
.search-entry { display:flex; min-height:92rpx; align-items:center; padding:0 24rpx; border:1rpx solid #d7e7e0; border-radius:22rpx; background:#fff; box-shadow:0 10rpx 30rpx rgba(25,82,65,.07); }
.search-symbol { position:relative; box-sizing:border-box; width:28rpx; height:28rpx; border:4rpx solid #0b9b5b; border-radius:50%; }
.search-symbol::after { position:absolute; right:-11rpx; bottom:-7rpx; width:13rpx; height:4rpx; border-radius:2rpx; background:#0b9b5b; content:""; transform:rotate(45deg); }
.search-copy { flex:1; margin-left:18rpx; color:#60756e; font-size:26rpx; }
.search-arrow { color:#0b8c54; font-size:28rpx; }
.feature-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10rpx; margin-top:28rpx; }
.feature-item { min-width:0; padding:10rpx 2rpx; text-align:center; }
.feature-icon { display:flex; width:74rpx; height:74rpx; margin:0 auto; align-items:center; justify-content:center; border-radius:24rpx; color:#08774c; font-size:23rpx; font-weight:800; box-shadow:inset 0 0 0 1rpx rgba(20,80,65,.07); }
.feature-icon--mint { background:#dff7ec; }.feature-icon--blue { background:#e2f0ff;color:#27649a; }.feature-icon--violet { background:#eee8ff;color:#6752a5; }.feature-icon--orange { background:#fff0dc;color:#b86223; }
.feature-label { margin-top:12rpx; color:#173f36; font-size:23rpx; font-weight:750; }
.feature-caption { display:none; }
.section-heading { display:flex; margin:46rpx 2rpx 20rpx; align-items:flex-end; justify-content:space-between; }
.section-kicker { color:#0b9b5b; font-size:20rpx; font-weight:700; letter-spacing:2rpx; }
.section-title { margin-top:6rpx; color:#153f36; font-size:36rpx; font-weight:850; }
.section-hint { min-height:56rpx; color:#08774c; font-size:23rpx; font-weight:700; line-height:56rpx; }
.home-university-list { display:flex; flex-direction:column; gap:18rpx; }
