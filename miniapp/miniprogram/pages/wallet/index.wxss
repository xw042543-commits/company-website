.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f5faf7}.wallet{display:grid;grid-template-columns:1fr 1fr;padding:34rpx;border-radius:24rpx;background:linear-gradient(135deg,#087d50,#05a45f);color:#fff}.wallet>view+view{padding-left:30rpx;border-left:1rpx solid rgba(255,255,255,.3)}.wallet text{font-size:22rpx;opacity:.85}.wallet view view{margin-top:10rpx;font-size:40rpx;font-weight:800}.tabs{display:flex;margin-top:24rpx;background:#fff;border-radius:20rpx 20rpx 0 0}.tab{flex:1;padding:24rpx 4rpx;text-align:center;color:#60736c}.on{border-bottom:5rpx solid #07965a;color:#07965a;font-weight:800}.empty{padding:120rpx 0;background:#fff;text-align:center;color:#7a8c86}.tip{margin-top:20rpx;color:#7a8c86;font-size:22rpx;text-align:center}
