<view class="page"><view class="wallet"><view><text>账户余额</text><view>RM {{balance}}</view></view><view><text>可用积分</text><view>{{points}}</view></view></view><view class="tabs"><view wx:for="{{tabs}}" wx:key="key" class="tab {{tab===item.key?'on':''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view></view><view wx:for="{{visible}}" wx:key="id" class="record"><view><view>{{item.description}}</view><text>{{item.occurredAt}}</text></view><view class="amount">{{item.direction==='CREDIT'?'+':'-'}}{{item.amount}}</view></view><view wx:if="{{visible.length===0}}" class="empty">暂无记录</view><view class="tip">余额和积分变动将自动记录在此处</view></view>
