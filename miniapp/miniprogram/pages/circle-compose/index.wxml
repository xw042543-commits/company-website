<!-- Operate: one continuous writing surface, photographs beneath the story, compact metadata rows.
     Inherits U圈 green/neutral palette; visible input boundaries and a persistent publish action. -->
<view class="page-shell compose-page">
  <view class="compose-heading"><view class="compose-title">分享你的留学日常</view><button class="discard-draft" disabled="{{submitting}}" bindtap="discardDraft">清空草稿</button></view>
  <view class="compose-copy">一个问题、一段经验，或几张校园照片。</view>
  <view class="editor-card">
    <label class="field-label" for="post-title">标题 <text class="required-copy">必填</text></label>
    <input id="post-title" class="title-input" value="{{title}}" maxlength="60" disabled="{{submitting}}" placeholder="给这次分享起个标题" placeholder-class="editor-placeholder" bindinput="updateTitle" />
    <view class="title-counter counter {{titleCount > 60 ? 'counter--danger' : ''}}">{{titleCount}} / 60</view>
    <view class="writing-divider"></view>
    <label class="field-label body-label" for="post-body">正文 <text class="required-copy">必填</text></label>
    <textarea id="post-body" class="body-input" value="{{body}}" maxlength="2000" disabled="{{submitting}}" auto-height placeholder="分享校园生活，或说说你遇到的问题…" placeholder-class="editor-placeholder" bindinput="updateBody" />
    <view class="body-counter counter {{count > 2000 ? 'counter--danger' : ''}}">{{count}} / 2000</view>
    <view class="photos-heading"><text>配上照片</text><text class="photo-count">{{images.length}} / 9 · 可选</text></view>
    <view class="image-grid">
      <view wx:for="{{images}}" wx:key="key" class="image-item">
        <image class="draft-image" src="{{item.path}}" mode="aspectFill" data-key="{{item.key}}" bindtap="previewImage" />
        <button class="remove-image" aria-label="移除第{{index + 1}}张图片" disabled="{{submitting}}" data-key="{{item.key}}" catchtap="removeImage"><view class="close-mark"></view></button>
        <button wx:if="{{item.status === 'failed'}}" class="image-state image-state--failed" data-key="{{item.key}}" bindtap="retryImage">上传失败 · 重试</button>
        <view wx:elif="{{item.status !== 'ready'}}" class="image-state">{{item.status === 'queued' ? '等待上传' : '上传中…'}}</view>
      </view>
      <button wx:if="{{images.length < 9}}" class="add-image" disabled="{{submitting || choosingImages}}" bindtap="addImages"><view class="add-mark"></view><text>{{choosingImages ? '正在处理…' : '添加图片'}}</text></button>
    </view>
    <view class="image-hint">支持 JPEG / PNG，最多9张。带图帖子会自动发布；启用图片安全检查时，通过检查后自动公开。</view>
  </view>
  <view class="post-settings">
    <picker mode="selector" range="{{categoryLabels}}" value="{{categoryIndex}}" disabled="{{submitting}}" bindchange="changeCategory"><view class="setting-row"><text class="setting-label">发布到</text><text class="setting-value">{{categoryLabels[categoryIndex]}}</text><view class="setting-chevron"></view></view></picker>
    <button class="setting-row school-select" disabled="{{submitting}}" bindtap="openSchools"><text class="setting-label">关联院校</text><text class="setting-value {{universityName ? '' : 'setting-value--muted'}}">{{universityName || '选择院校 · 可选'}}</text><view class="setting-chevron"></view></button>
    <button wx:if="{{universityId}}" class="clear-school" disabled="{{submitting}}" bindtap="clearSchool">取消院校归属</button>
    <view class="school-note">院校标签仅代表讨论归属，不证明学生身份。</view>
  </view>
  <view wx:if="{{notice}}" class="notice" role="alert">{{notice}}</view>
  <view class="review-note">请勿发布联系方式、隐私资料或未经核实的信息。需要人工确认的内容会进入审核队列，结果可在消息中查看。</view>
  <view class="publish-dock"><text class="draft-hint">{{imagesBusy ? '请等待图片上传完成' : '符合社区规则的内容会自动发布'}}</text><button class="publish-button" disabled="{{submitting || choosingImages || imagesBusy}}" bindtap="submit">{{submitting ? '正在提交…' : '发布到U圈'}}</button></view>
</view>
<view wx:if="{{schoolOpen}}" class="school-overlay">
  <view class="school-dialog" role="dialog" aria-label="选择院校">
    <view class="field-label">选择真实院校</view>
    <view class="school-search"><input value="{{schoolQuery}}" maxlength="100" placeholder="搜索院校名称" bindinput="updateSchoolQuery" bindconfirm="searchSchools" /><button bindtap="searchSchools" disabled="{{schoolState === 'loading'}}">搜索</button></view>
    <scroll-view scroll-y class="school-results">
      <view wx:if="{{schoolState === 'loading'}}" class="school-message">正在加载院校…</view>
      <view wx:elif="{{schoolState === 'failed'}}" class="school-message">院校加载失败，请重试。<button bindtap="retrySchools">重试</button></view>
      <view wx:elif="{{schoolState === 'empty'}}" class="school-message">没有找到相关院校，请更换关键词。</view>
      <button wx:for="{{schools}}" wx:key="id" class="school-option" data-id="{{item.id}}" bindtap="selectSchool">{{item.name}}</button>
    </scroll-view>
    <view wx:if="{{schoolTotalPages > 0}}" class="school-pagination"><button disabled="{{schoolPage <= 1 || schoolState === 'loading'}}" bindtap="previousSchools">上一页</button><text>{{schoolPage}} / {{schoolTotalPages}} 页</text><button disabled="{{schoolPage >= schoolTotalPages || schoolState === 'loading'}}" bindtap="nextSchools">下一页</button></view>
    <button class="school-cancel" bindtap="cancelSchools">取消选择</button>
  </view>
</view>
