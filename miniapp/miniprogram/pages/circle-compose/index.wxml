<view class="page-shell compose-page">
  <view class="compose-title">分享真实留学经验</view>
  <view class="compose-copy">U圈目前仅支持纯文字内容。请勿发布联系方式、隐私资料或未经核实的信息。</view>
  <view class="editor-card surface-card">
    <label class="field-label" for="post-title">帖子标题（必填）</label>
    <input id="post-title" value="{{title}}" maxlength="60" placeholder="用一句话说明你想分享什么" bindinput="updateTitle" />
    <view class="title-counter counter {{titleCount > 60 ? 'counter--danger' : ''}}">{{titleCount}} / 60</view>
    <view class="field-label">生活分类</view>
    <picker mode="selector" range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="changeCategory"><view class="selection-field">{{categoryLabels[categoryIndex]}} · 更改分类</view></picker>
    <view class="field-label">院校（可选）</view>
    <button class="selection-field" bindtap="openSchools">{{universityName || '选择院校'}}</button>
    <button wx:if="{{universityId}}" class="clear-school" bindtap="clearSchool">取消院校归属</button>
    <view class="school-note">院校标签仅代表讨论归属，不证明学生身份。</view>
    <label class="field-label" for="post-body">帖子正文（必填）</label>
    <textarea id="post-body" value="{{body}}" maxlength="2000" placeholder="写下你的问题、经验或建议" bindinput="updateBody" />
    <view class="editor-meta"><text class="counter {{count > 2000 ? 'counter--danger' : ''}}">{{count}} / 2000</text><text>公开发布</text></view>
  </view>
  <view wx:if="{{notice}}" class="notice" role="alert">{{notice}}</view>
  <button class="publish-button" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在提交…' : '确认发布'}}</button>
  <view class="review-note">安全检查认为内容需要人工确认时，将显示“审核中”，不会假装已经公开。</view>
</view>
<view wx:if="{{schoolOpen}}" class="school-overlay">
  <view class="school-dialog" role="dialog" aria-label="选择院校">
    <view class="field-label">选择真实院校</view>
    <view class="school-search"><input value="{{schoolQuery}}" maxlength="100" placeholder="搜索院校名称" bindinput="updateSchoolQuery" bindconfirm="searchSchools" /><button bindtap="searchSchools" disabled="{{schoolState === 'loading'}}">搜索</button></view>
    <scroll-view scroll-y class="school-results">
      <view wx:if="{{schoolState === 'loading'}}" class="school-message">正在加载院校…</view>
      <view wx:elif="{{schoolState === 'failed'}}" class="school-message">院校加载失败，请重试。<button bindtap="retrySchools">重试</button></view>
      <view wx:elif="{{schoolState === 'empty'}}" class="school-message">没有找到相关院校，请更换关键词。</view>
      <button wx:for="{{schools}}" wx:key="id" class="school-option" data-id="{{item.id}}" bindtap="selectSchool">{{item.name}}</button>
    </scroll-view>
    <view wx:if="{{schoolTotalPages > 0}}" class="school-pagination"><button disabled="{{schoolPage <= 1 || schoolState === 'loading'}}" bindtap="previousSchools">上一页</button><text>{{schoolPage}} / {{schoolTotalPages}} 页</text><button disabled="{{schoolPage >= schoolTotalPages || schoolState === 'loading'}}" bindtap="nextSchools">下一页</button></view>
    <button class="school-cancel" bindtap="cancelSchools">取消选择</button>
  </view>
</view>
