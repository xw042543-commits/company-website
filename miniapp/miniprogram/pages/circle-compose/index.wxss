.compose-page { --color-paper: #F5F7F6; --color-ink: #183C30; --color-deep: #183C30; --color-muted: #53675B; --color-action: #087C49; --color-line: #D5E0D9; background: #F5F7F6; padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
.compose-title { color: var(--color-deep); font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.compose-copy, .review-note { margin-top: 16rpx; color: var(--color-muted); font-size: 25rpx; line-height: 1.7; }
.editor-card { margin-top: 28rpx; padding: 28rpx; border: 1rpx solid var(--color-line); border-radius: 24rpx; background: #fff; }
.field-label { display: block; color: var(--color-deep); font-size: 27rpx; font-weight: 750; }
.editor-card input { min-height: 80rpx; font-size: 28rpx; color: var(--color-ink); }
.title-counter { margin-bottom: 24rpx; text-align: right; font-size: 22rpx; color: var(--color-muted); }
.selection-field { box-sizing: border-box; min-height: 44px; margin: 16rpx 0 24rpx; padding: 20rpx; border-radius: 12rpx; background: var(--color-paper); color: var(--color-ink); font-size: 28rpx; text-align: left; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }
.clear-school { margin: -12rpx 0 16rpx; font-size: 24rpx; color: var(--color-action); background: transparent; }
.school-note { margin-bottom: 28rpx; font-size: 22rpx; color: var(--color-muted); line-height: 1.6; }
.school-overlay { position: fixed; z-index: 20; inset: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, .35); }
.school-dialog { box-sizing: border-box; width: 100%; max-width: 620px; padding: 28rpx; border-radius: 20rpx; background: #fff; }
.school-search { display: flex; gap: 16rpx; margin: 20rpx 0; align-items: center; }
.school-search input { flex: 1; min-width: 0; font-size: 26rpx; }
.school-search button, .school-pagination button { min-height: 44px; margin: 0; font-size: 24rpx; }
.school-results { height: 40vh; }
.school-option { min-height: 44px; margin: 0; padding: 20rpx 12rpx; border-bottom: 1rpx solid var(--color-line); background: #fff; text-align: left; font-size: 26rpx; line-height: 1.6; overflow-wrap: anywhere; word-break: break-all; }
.school-message { padding: 30rpx 0; color: var(--color-muted); font-size: 26rpx; }
.school-pagination { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-top: 20rpx; font-size: 22rpx; }
.school-cancel { margin-top: 20rpx; font-size: 26rpx; color: var(--color-deep); }
.editor-card textarea { box-sizing: border-box; width: 100%; min-height: 260rpx; margin-top: 16rpx; color: var(--color-ink); font-size: 29rpx; line-height: 1.75; overflow-wrap: anywhere; }
.editor-meta { display: flex; min-height: 72rpx; align-items: center; justify-content: space-between; border-top: 1rpx solid var(--color-line); color: var(--color-muted); font-size: 22rpx; }
.counter--danger { color: var(--color-danger); font-weight: 700; }
.notice { margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #fceeee; color: var(--color-danger); font-size: 25rpx; line-height: 1.6; }
.publish-button { width: 100%; min-height: 92rpx; margin-top: 12rpx; border-radius: 46rpx; background: var(--color-action); color: #fff; font-size: 29rpx; font-weight: 600; line-height: 92rpx; }
.publish-button:active { background: var(--color-deep); }.publish-button[disabled] { opacity: .46; }
@media (min-width: 600px) { .compose-page { max-width: 720px; margin: 0 auto; padding-right: 32px; padding-left: 32px; } }
.compose-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.discard-draft { flex-shrink: 0; margin: 0; min-height: 44px; padding: 0 8rpx; font-size: 24rpx; line-height: 44px; background: transparent; color: var(--color-muted); }
.required-copy { margin-left: 10rpx; font-size: 22rpx; font-weight: 400; color: var(--color-muted); }
.title-input { font-size: 34rpx !important; font-weight: 600; }
.editor-placeholder { color: #69776F; font-weight: 400; }
.writing-divider { height: 1rpx; background: var(--color-line); margin-bottom: 24rpx; }
.body-counter { text-align: right; font-size: 22rpx; color: var(--color-muted); }
.photos-heading { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 0 18rpx; color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.photo-count { font-size: 22rpx; color: var(--color-muted); font-weight: 400; }
.image-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.image-item, .add-image { position: relative; height: 176rpx; min-height: 88px; border-radius: 16rpx; overflow: hidden; }
.draft-image { width: 100%; height: 100%; }
.add-image { width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; margin: 0; padding: 8rpx; border: 1rpx dashed #A2B8AA; background: #F0F6F2; color: var(--color-action); font-size: 24rpx; line-height: 1.5; }
.add-mark { position: relative; width: 32rpx; height: 32rpx; }
.add-mark::before, .add-mark::after { content: ''; position: absolute; background: currentColor; border-radius: 2rpx; }
.add-mark::before { width: 32rpx; height: 3rpx; top: 15rpx; left: 0; }.add-mark::after { width: 3rpx; height: 32rpx; top: 0; left: 15rpx; }
.remove-image { position: absolute; right: 0; top: 0; width: 44px; height: 44px; min-height: 44px; padding: 7px; margin: 0; background: transparent; display: flex; justify-content: flex-end; }
.close-mark { position: relative; width: 24px; height: 24px; border-radius: 50%; background: rgba(20,40,30,.85); }
.close-mark::before, .close-mark::after { content: ''; position: absolute; width: 12px; height: 2px; left: 6px; top: 11px; background: #fff; transform: rotate(45deg); }.close-mark::after { transform: rotate(-45deg); }
.image-state { position: absolute; bottom: 0; left: 0; right: 0; margin: 0; padding: 10rpx 4rpx; background: rgba(20,40,30,.85); color: #fff; font-size: 22rpx; line-height: 1.5; text-align: center; border-radius: 0; }
.image-state--failed { min-height: 44px; background: #8A3832; }
.image-hint { margin-top: 18rpx; font-size: 22rpx; line-height: 1.6; color: var(--color-muted); }
.post-settings { margin-top: 26rpx; }
.setting-row { display: flex; align-items: center; min-height: 100rpx; padding: 16rpx 4rpx; gap: 24rpx; border-bottom: 1rpx solid var(--color-line); box-sizing: border-box; font-size: 27rpx; line-height: 1.5; }
.school-select { width: 100%; margin: 0; background: transparent; border-radius: 0; text-align: left; }
.setting-label { flex-shrink: 0; color: var(--color-muted); }.setting-value { flex: 1; color: var(--color-ink); text-align: right; overflow-wrap: anywhere; }.setting-value--muted { color: var(--color-muted); }
.setting-chevron { width: 12rpx; height: 12rpx; border-top: 2rpx solid #728779; border-right: 2rpx solid #728779; transform: rotate(45deg); flex-shrink: 0; margin-right: 8rpx; }
.school-note { margin-top: 14rpx; margin-bottom: 0; }.clear-school { margin: 8rpx 0; min-height: 44px; text-align: right; }
.publish-dock { position: fixed; bottom: 0; left: 0; right: 0; z-index: 5; padding: 18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid var(--color-line); }
.draft-hint { display: block; text-align: center; color: var(--color-muted); font-size: 22rpx; }
