<view class="detail-page">
  <block wx:if="{{state === 'ready' && detail}}">
    <view class="summary-card">
      <view class="school-mark">申</view>
      <view class="summary-copy"><view class="university">{{detail.order.universityName || '院校待确认'}}</view><view class="programme">{{detail.order.programmeName || '专业待确认'}}</view><view class="qualification">{{detail.order.qualification || '申请层次待确认'}}</view></view>
      <view class="status">{{detail.order.statusLabel}}</view>
      <view class="reference"><text>申请编号</text><text>{{detail.order.referenceCode}}</text></view>
    </view>

    <view class="tabs">
      <button wx:for="{{tabs}}" wx:key="key" class="tab {{activeTab === item.key ? 'tab--active' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</button>
    </view>

    <view wx:if="{{activeTab === 'progress'}}" class="panel timeline">
      <view wx:for="{{detail.stages}}" wx:key="number" class="stage stage--{{item.state}}">
        <view class="stage-rail"><view class="stage-number">{{item.state === 'COMPLETED' ? '✓' : item.number}}</view><view wx:if="{{index < detail.stages.length - 1}}" class="stage-line"></view></view>
        <view class="stage-copy"><view class="stage-title">{{item.title}}</view><view class="stage-description">{{item.description}}</view>
          <view wx:if="{{item.state === 'ACTIVE'}}" class="active-box"><view>{{detail.currentMessage}}</view><view class="actions"><button bindtap="supplement">补充材料</button><button class="secondary" bindtap="showReview">查看进度说明</button></view></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'materials'}}" class="panel">
      <view wx:for="{{detail.materials}}" wx:key="name" class="material-row"><view class="material-icon">{{item.state === 'RECORDED' ? '✓' : '!'}}</view><view><view class="material-name">{{item.name}}</view><view class="material-description">{{item.description}}</view></view><view class="material-state">{{item.state === 'RECORDED' ? '已记录' : '待确认'}}</view></view>
      <button class="wide-action" bindtap="supplement">了解如何补充材料</button>
    </view>

    <view wx:elif="{{activeTab === 'fees'}}" class="panel payment-panel"><view class="payment-title">费用状态</view><view class="payment-message">{{detail.payment.message}}</view><view class="payment-note">如后续产生院校申请费或服务费用，将由顾问确认后在此展示。</view></view>

    <view wx:else class="panel history-panel"><view wx:for="{{detail.history}}" wx:key="occurredAt" class="history-row"><view class="history-dot"></view><view><view class="history-title">{{item.title}}</view><view class="history-date">{{item.occurredDate}}</view></view></view></view>
    <view class="notice">ⓘ 申请进度由顾问后台同步更新，如需补充材料我们会及时通知你。</view>
  </block>
  <view wx:else class="state-wrap"><app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取申请详情" description="请稍候。"/><app-state wx:else kind="failed" title="无法读取申请详情" description="请确认已登录或稍后重试。" retryable="{{true}}" bind:retry="retry"/></view>
</view>
