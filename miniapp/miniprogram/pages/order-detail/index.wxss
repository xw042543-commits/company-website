.detail-page{box-sizing:border-box;min-height:100vh;padding:22rpx 22rpx 70rpx;background:#f5faf7}.summary-card{position:relative;display:flex;flex-wrap:wrap;align-items:flex-start;padding:24rpx;border:1rpx solid #deebe5;border-radius:24rpx;background:#fff}.school-mark{display:flex;width:92rpx;height:92rpx;align-items:center;justify-content:center;border-radius:17rpx;background:#e5f5ee;color:#078e54;font-size:36rpx;font-weight:850}.summary-copy{min-width:0;margin-left:20rpx}.university{font-size:30rpx;font-weight:850}.programme{margin-top:7rpx;color:#244d42;font-size:24rpx}.qualification{margin-top:7rpx;color:#70827c;font-size:21rpx}.status{margin-left:auto;padding:9rpx 18rpx;border-radius:999rpx;background:#e1f8ec;color:#078e54;font-size:21rpx;font-weight:750}.reference{display:flex;width:100%;justify-content:space-between;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #e7efeb;color:#61766f;font-size:21rpx}.tabs{display:flex;margin-top:18rpx;border-bottom:1rpx solid #dce9e3;background:#fff;border-radius:20rpx 20rpx 0 0}.tab{flex:1;margin:0;padding:24rpx 2rpx 18rpx;border-radius:0;background:transparent;color:#536b63;font-size:22rpx;line-height:1}.tab--active{border-bottom:5rpx solid #08a05d;color:#078e54;font-weight:800}.panel{padding:26rpx;border-radius:0 0 22rpx 22rpx;background:#fff}.stage{display:flex;min-height:104rpx}.stage-rail{display:flex;width:58rpx;flex:0 0 auto;align-items:center;flex-direction:column}.stage-number{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;border-radius:50%;background:#e8eeeb;color:#60736c;font-size:22rpx;font-weight:800}.stage-line{width:3rpx;flex:1;background:#dbe7e1}.stage--COMPLETED .stage-number,.stage--ACTIVE .stage-number{background:#0aa05e;color:#fff}.stage--COMPLETED .stage-line{background:#72d2a5}.stage-copy{min-width:0;flex:1;padding:2rpx 0 24rpx 18rpx}.stage-title{color:#223a33;font-size:27rpx;font-weight:800}.stage-description{margin-top:5rpx;color:#73857f;font-size:21rpx}.stage--PENDING .stage-title{color:#64766f}.active-box{margin-top:18rpx;padding:20rpx;border-radius:18rpx;background:linear-gradient(135deg,#e8fbf3,#f5fffa);color:#2c5b4c;font-size:22rpx;line-height:1.65}.actions{display:flex;gap:14rpx;margin-top:18rpx}.actions button,.wide-action{flex:1;margin:0;border-radius:14rpx;background:#08a05d;color:#fff;font-size:22rpx;font-weight:750;line-height:68rpx}.actions .secondary{border:1rpx solid #08a05d;background:#fff;color:#078e54}.material-row{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #e6efeb}.material-icon{display:flex;width:42rpx;height:42rpx;align-items:center;justify-content:center;margin-right:16rpx;border-radius:50%;background:#e4f7ed;color:#079058;font-weight:850}.material-name{font-size:25rpx;font-weight:750}.material-description{margin-top:5rpx;color:#75867f;font-size:20rpx}.material-state{margin-left:auto;color:#0a955a;font-size:21rpx}.wide-action{width:100%;margin-top:24rpx}.payment-title{font-size:28rpx;font-weight:800}.payment-message{margin-top:22rpx;padding:30rpx;border-radius:18rpx;background:#eaf8f1;color:#087c50;font-size:26rpx;text-align:center}.payment-note{margin-top:22rpx;color:#71847d;font-size:21rpx;line-height:1.6}.history-row{display:flex;gap:18rpx;padding:12rpx 0 28rpx}.history-dot{width:22rpx;height:22rpx;margin-top:6rpx;border:6rpx solid #c9efdc;border-radius:50%;background:#08a05d}.history-title{font-size:25rpx;font-weight:750}.history-date{margin-top:6rpx;color:#75877f;font-size:20rpx}.notice{margin-top:18rpx;padding:18rpx 22rpx;border-radius:16rpx;background:#e7f8f0;color:#128054;font-size:21rpx;line-height:1.5}.state-wrap{padding-top:180rpx}
