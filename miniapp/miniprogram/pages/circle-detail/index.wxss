.detail-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); background: var(--color-paper); }
.post-detail, .comment-block, .comment-composer { padding: 28rpx; }
.author-row, .comment-head, .post-toolbar, .comment-actions, .composer-foot, .report-actions, .replying { display: flex; align-items: center; }
.avatar, .avatar-fallback { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 50%; }
.avatar-fallback, .mini-avatar { display: flex; align-items: center; justify-content: center; background: #e5f2ed; color: var(--color-action); font-weight: 800; }
.author-copy { min-width: 0; flex: 1; margin-left: 18rpx; }.author-name, .comment-author { color: var(--color-deep); font-weight: 750; }.post-time, .comment-time { margin-top: 4rpx; color: var(--color-muted); font-size: 22rpx; }.minor-action, .danger-button { min-height: 88rpx; margin: 0; background: transparent; color: var(--color-muted); font-size: 24rpx; line-height: 88rpx; }
.post-body, .comment-body, .reply-body { color: var(--color-ink); line-height: 1.72; overflow-wrap: anywhere; }.post-body { padding: 24rpx 0; font-size: 30rpx; }.post-toolbar { min-height: 88rpx; gap: 16rpx; border-top: 1rpx solid var(--color-line); }.toolbar-button { min-height: 88rpx; margin: 0; background: transparent; color: var(--color-muted); font-size: 24rpx; }.toolbar-button.active { color: var(--color-action); font-weight: 700; }.count-copy { flex: 1; color: var(--color-muted); font-size: 24rpx; }.danger-button, .danger { color: var(--color-danger) !important; }
.section-title { margin: 40rpx 0 18rpx; color: var(--color-deep); font-size: 34rpx; font-weight: 800; }.comment-list { display: flex; flex-direction: column; gap: 18rpx; }.mini-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; font-size: 22rpx; }.comment-author { flex: 1; margin-left: 14rpx; font-size: 25rpx; }.comment-time { margin: 0; }.comment-body { padding: 18rpx 0 4rpx; font-size: 27rpx; }.comment-actions { flex-wrap: wrap; justify-content: flex-end; gap: 4rpx; }.comment-actions button { min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; background: transparent; color: var(--color-muted); font-size: 22rpx; line-height: 88rpx; }.reply-list { padding: 4rpx 20rpx; border-radius: 16rpx; background: #f1f6f3; }.reply-row + .reply-row { border-top: 1rpx solid var(--color-line); }.reply-meta { padding-top: 20rpx; color: var(--color-action); font-size: 23rpx; font-weight: 700; }.reply-body { padding-top: 8rpx; font-size: 25rpx; }.reply-more { width: 100%; min-height: 88rpx; margin: 8rpx 0 0; background: transparent; color: var(--color-action); font-size: 24rpx; }.list-foot { padding: 24rpx; color: var(--color-muted); font-size: 23rpx; text-align: center; }
.comment-composer { margin-top: 28rpx; }.comment-composer textarea, .report-sheet textarea { box-sizing: border-box; width: 100%; min-height: 180rpx; padding: 20rpx; border: 1rpx solid var(--color-line); border-radius: 16rpx; background: #fff; font-size: 27rpx; line-height: 1.6; }.replying { min-height: 72rpx; justify-content: space-between; color: var(--color-action); font-size: 24rpx; }.replying button { min-height: 72rpx; margin: 0; background: transparent; color: var(--color-muted); font-size: 23rpx; }.composer-foot { min-height: 104rpx; justify-content: space-between; gap: 20rpx; }.counter, .report-count { color: var(--color-muted); font-size: 22rpx; }.counter--danger { color: var(--color-danger); font-weight: 700; }.submit-button { min-width: 220rpx; min-height: 88rpx; margin: 0; border-radius: 18rpx; background: var(--color-action); color: #fff; font-size: 26rpx; line-height: 88rpx; }.submit-button[disabled] { opacity: .46; }
.report-mask { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(12, 32, 27, .52); }.report-sheet { box-sizing: border-box; width: 100%; max-height: 88vh; padding: 34rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 28rpx 28rpx 0 0; background: var(--color-paper); }.report-title { color: var(--color-deep); font-size: 34rpx; font-weight: 800; }.report-copy { margin-top: 10rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }.reason-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin: 24rpx 0; }.reason-button { min-height: 88rpx; margin: 0; border: 1rpx solid var(--color-line); border-radius: 16rpx; background: #fff; color: var(--color-ink); font-size: 24rpx; }.reason-button.selected { border-color: var(--color-action); background: #e8f5ef; color: var(--color-action); font-weight: 700; }.report-count { padding: 12rpx 0; text-align: right; }.report-actions { gap: 16rpx; }.report-actions button { min-height: 88rpx; flex: 1; margin: 0; border-radius: 16rpx; font-size: 25rpx; }
.detail-skeleton { padding: 32rpx; border-radius: var(--radius-card); background: #fff; }.skeleton-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #e5eee9; }.skeleton-line { height: 24rpx; margin-top: 24rpx; border-radius: 12rpx; background: #e5eee9; }.skeleton-line.short { width: 66%; }
@media (min-width: 600px) { .detail-page { max-width: 720px; margin: 0 auto; padding-right: 32px; padding-left: 32px; }.report-sheet { max-width: 720px; margin: 0 auto; } }
