<view class="page-shell universities-page">
  <view class="search-box surface-card">
    <view class="search-symbol" aria-hidden="true"></view>
    <input
      class="search-input"
      value="{{query}}"
      placeholder="搜索院校或专业"
      confirm-type="search"
      bindinput="updateQuery"
      bindconfirm="submitSearch"
    />
    <button class="search-button" bindtap="submitSearch">搜索</button>
  </view>

  <view class="filter-row">
    <view class="filter-group">
      <view
        class="filter-chip {{category === 'ALL' ? 'filter-chip--active' : ''}}"
        data-value="ALL"
        bindtap="selectCategory"
      >全部领域</view>
      <view
        class="filter-chip {{category === 'BUSINESS' ? 'filter-chip--active' : ''}}"
        data-value="BUSINESS"
        bindtap="selectCategory"
      >商科</view>
    </view>
    <view class="filter-group">
      <view
        class="filter-chip {{level === 'ALL' ? 'filter-chip--active' : ''}}"
        data-value="ALL"
        bindtap="selectLevel"
      >全部学历</view>
      <view
        class="filter-chip {{level === 'BACHELOR' ? 'filter-chip--active' : ''}}"
        data-value="BACHELOR"
        bindtap="selectLevel"
      >本科</view>
    </view>
  </view>

  <view wx:if="{{state === 'ready'}}" class="result-heading">共 {{totalItems}} 所院校</view>
  <view wx:if="{{state === 'ready'}}" class="university-list">
    <university-card
      wx:for="{{universities}}"
      wx:key="slug"
      university="{{item}}"
      bind:select="openUniversity"
    />
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多院校…</view>
    <view wx:elif="{{page >= totalPages}}" class="load-more">已显示全部院校</view>
  </view>

  <app-state
    wx:if="{{state === 'loading'}}"
    kind="loading"
    title="正在读取院校资料"
    description="请稍候，正在连接洋豆角院校数据库。"
  />
  <app-state
    wx:elif="{{state === 'empty'}}"
    kind="empty"
    title="没有找到匹配院校"
    description="请尝试清空关键词或调整筛选条件。"
  />
  <app-state
    wx:elif="{{state === 'offline'}}"
    kind="offline"
    title="网络暂时不可用"
    description="请检查网络连接后重新加载。"
    retryable="{{true}}"
    bind:retry="retry"
  />
  <app-state
    wx:elif="{{state === 'failed'}}"
    kind="failed"
    title="院校资料加载失败"
    description="服务暂时无法返回有效数据，请稍后重试。"
    retryable="{{true}}"
    bind:retry="retry"
  />
</view>
