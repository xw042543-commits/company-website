<view class="page-shell universities-page">
  <view class="directory-head">
    <view class="eyebrow">院校资料库</view>
    <view class="page-title">找到适合你的院校</view>
    <view class="page-copy">组合地区、学历和专业条件，查看真实院校与课程资料。</view>
  </view>

  <view class="search-box">
    <view class="search-symbol" aria-hidden="true"></view>
    <input class="search-input" value="{{query}}" placeholder="搜索院校或专业" confirm-type="search" bindinput="updateQuery" bindconfirm="submitSearch" />
    <button class="search-button" bindtap="submitSearch">搜索</button>
  </view>

  <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <picker range="{{countryOptions}}" range-key="nameZh" value="{{countryIndex}}" data-key="country" bindchange="chooseFilter">
        <view class="filter-chip {{country !== 'ALL' ? 'filter-chip--active' : ''}}">{{countryOptions[countryIndex].nameZh}}⌄</view>
      </picker>
      <picker range="{{levelOptions}}" range-key="nameZh" value="{{levelIndex}}" data-key="level" bindchange="chooseFilter">
        <view class="filter-chip {{level !== 'ALL' ? 'filter-chip--active' : ''}}">{{levelOptions[levelIndex].nameZh}}⌄</view>
      </picker>
      <picker range="{{categoryOptions}}" range-key="nameZh" value="{{categoryIndex}}" data-key="category" bindchange="chooseFilter">
        <view class="filter-chip {{category !== 'ALL' ? 'filter-chip--active' : ''}}">{{categoryOptions[categoryIndex].nameZh}}⌄</view>
      </picker>
      <view class="filter-clear" bindtap="clearFilters">重置</view>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'ready'}}" class="result-heading">
    <view><text class="result-number">{{totalItems}}</text> 所院校</view>
    <view class="result-note">可组合筛选</view>
  </view>
  <view wx:if="{{state === 'ready'}}" class="university-list">
    <university-card wx:for="{{universities}}" wx:key="slug" university="{{item}}" favorite="{{item.favorite}}" bind:select="openUniversity" bind:favorite="toggleFavorite" />
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多院校…</view>
    <view wx:elif="{{page >= totalPages}}" class="load-more">已显示全部院校</view>
  </view>

  <app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取院校资料" description="请稍候，正在连接洋豆角院校数据库。" />
  <app-state wx:elif="{{state === 'empty'}}" kind="empty" title="没有找到匹配院校" description="请尝试清空关键词或调整筛选条件。" retryable="{{true}}" bind:retry="clearFilters" />
  <app-state wx:elif="{{state === 'offline'}}" kind="offline" title="网络暂时不可用" description="请检查网络连接后重新加载。" retryable="{{true}}" bind:retry="retry" />
  <app-state wx:elif="{{state === 'failed'}}" kind="failed" title="院校资料加载失败" description="服务暂时无法返回有效数据，请稍后重试。" retryable="{{true}}" bind:retry="retry" />
</view>
