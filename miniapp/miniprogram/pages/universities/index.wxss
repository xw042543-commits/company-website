.universities-page { min-height:100vh; box-sizing:border-box; padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:var(--color-wash); color:var(--color-navy); }
.search-box { display:flex; min-height:104rpx; align-items:center; padding:0 8rpx 0 24rpx; border:1rpx solid var(--color-line); border-radius:16rpx; background:var(--color-paper); }
.search-symbol { box-sizing:border-box; width:26rpx; height:26rpx; flex-shrink:0; border:3rpx solid var(--color-muted); border-radius:50%; }
.search-input { min-width:0; flex:1; margin-left:18rpx; color:var(--color-ink); font-size:27rpx; }
.search-placeholder { color:var(--color-muted); }
.search-button { min-width:112rpx; min-height:104rpx; margin:0; padding:0 18rpx; border-radius:12rpx; background:var(--color-action); color:var(--color-paper); font-size:26rpx; font-weight:700; line-height:104rpx; }
.search-button[disabled] { background:var(--color-line); color:var(--color-muted); }
.filter-row { display:flex; padding-top:16rpx; border-bottom:1rpx solid var(--color-line); }
.filter-trigger { display:flex; box-sizing:border-box; flex:1; min-width:0; min-height:104rpx; margin:0; padding:18rpx 10rpx; align-items:center; justify-content:center; border-radius:0; background:transparent; color:var(--color-navy); font-size:25rpx; line-height:1.4; }
.filter-label { min-width:0; overflow-wrap:break-word; word-break:break-word; }
.filter-arrow { margin-left:8rpx; flex-shrink:0; font-size:28rpx; }
.filter-trigger--active { background:var(--color-mint); color:var(--color-action); font-weight:700; }
.results-region { position:relative; min-height:75vh; }
.result-content { position:relative; }
.filter-panel { position:absolute; top:0; left:0; z-index:2; box-sizing:border-box; width:100%; max-height:560rpx; background:var(--color-paper); border-radius:0 0 16rpx 16rpx; box-shadow:0 12rpx 24rpx rgba(23,61,91,.1); }
.filter-option { display:flex; box-sizing:border-box; width:100%; min-height:104rpx; margin:0; padding:22rpx 28rpx; align-items:center; justify-content:space-between; border-radius:0; border-bottom:1rpx solid var(--color-line); background:var(--color-paper); color:var(--color-ink); text-align:left; font-size:27rpx; line-height:1.5; }
.option-label { min-width:0; overflow-wrap:break-word; word-break:break-word; }
.filter-option--selected { background:var(--color-mint); color:var(--color-action); font-weight:700; }
.option-check { margin-left:24rpx; flex-shrink:0; font-size:32rpx; }
.filter-status { padding:20rpx 28rpx; color:var(--color-muted); font-size:23rpx; }
.result-dim { position:absolute; top:0; right:0; bottom:0; left:0; z-index:1; background:rgba(23,61,91,.3); }
.result-heading { display:flex; min-height:112rpx; align-items:center; justify-content:space-between; color:var(--color-navy); font-size:26rpx; }
.result-number { margin-right:6rpx; font-size:34rpx; font-weight:700; }
.result-note { color:var(--color-muted); font-size:25rpx; }
.filter-clear { min-width:104rpx; min-height:104rpx; margin:0 -10rpx 0 12rpx; padding:0 14rpx; background:transparent; color:var(--color-action); font-size:25rpx; line-height:104rpx; }
.university-list { display:flex; flex-direction:column; gap:20rpx; }
.load-more { padding:28rpx; color:var(--color-muted); font-size:23rpx; text-align:center; }
.photo-skeleton { position:relative; box-sizing:border-box; min-height:420rpx; padding:176rpx 28rpx 28rpx; border-radius:20rpx; background:var(--color-mint); }
.skeleton-favorite { position:absolute; top:18rpx; right:18rpx; width:104rpx; height:104rpx; border-radius:52rpx; background:var(--color-line); }
.skeleton-identity { padding-top:34rpx; }
.skeleton-line { width:80%; height:28rpx; margin-top:14rpx; border-radius:4rpx; background:var(--color-line); }
.skeleton-line--title { width:60%; height:44rpx; }
.skeleton-line--location { width:45%; }
.control--pressed { opacity:.75; }
