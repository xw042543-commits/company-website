.universities-page { min-height:100vh; box-sizing:border-box; padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:#f6f7f5; color:#202923; }
.search-box { display:flex; min-height:104rpx; align-items:center; padding:0 8rpx 0 24rpx; border:1rpx solid #d5dbd7; border-radius:16rpx; background:#fdfdfb; }
.search-symbol { box-sizing:border-box; width:26rpx; height:26rpx; flex-shrink:0; border:3rpx solid #526057; border-radius:50%; }
.search-input { min-width:0; flex:1; margin-left:18rpx; color:#202923; font-size:27rpx; }
.search-placeholder { color:#626c65; }
.search-button { min-width:112rpx; min-height:104rpx; margin:0; padding:0 18rpx; border-radius:12rpx; background:#f5d66f; color:#202923; font-size:26rpx; font-weight:700; line-height:104rpx; }
.search-button[disabled] { background:#e8e8e2; color:#626c65; }
.filter-row { display:flex; padding-top:16rpx; border-bottom:1rpx solid #dce1dc; }
.filter-trigger { display:flex; box-sizing:border-box; flex:1; min-width:0; min-height:104rpx; margin:0; padding:18rpx 10rpx; align-items:center; justify-content:center; border-radius:0; background:transparent; color:#404a43; font-size:25rpx; line-height:1.4; }
.filter-label { min-width:0; overflow-wrap:break-word; word-break:break-word; }
.filter-arrow { margin-left:8rpx; flex-shrink:0; font-size:28rpx; }
.filter-trigger--active { background:#f5d66f; color:#202923; font-weight:700; }
.results-region { position:relative; min-height:75vh; }
.result-content { position:relative; }
.filter-panel { position:absolute; top:0; left:0; z-index:2; box-sizing:border-box; width:100%; max-height:560rpx; background:#fdfdfb; border-radius:0 0 16rpx 16rpx; box-shadow:0 12rpx 24rpx rgba(32,41,35,.1); }
.filter-option { display:flex; box-sizing:border-box; width:100%; min-height:104rpx; margin:0; padding:22rpx 28rpx; align-items:center; justify-content:space-between; border-radius:0; border-bottom:1rpx solid #edf0ec; background:#fdfdfb; color:#202923; text-align:left; font-size:27rpx; line-height:1.5; }
.option-label { min-width:0; overflow-wrap:break-word; word-break:break-word; }
.filter-option--selected { background:#f9e8a6; font-weight:700; }
.option-check { margin-left:24rpx; flex-shrink:0; font-size:32rpx; }
.filter-status { padding:20rpx 28rpx; color:#626c65; font-size:23rpx; }
.result-dim { position:absolute; top:0; right:0; bottom:0; left:0; z-index:1; background:rgba(32,41,35,.3); }
.result-heading { display:flex; min-height:112rpx; align-items:center; justify-content:space-between; color:#202923; font-size:26rpx; }
.result-number { margin-right:6rpx; font-size:34rpx; font-weight:700; }
.result-note { color:#626c65; font-size:25rpx; }
.filter-clear { min-width:104rpx; min-height:104rpx; margin:0 -10rpx 0 12rpx; padding:0 14rpx; background:transparent; color:#49544d; font-size:25rpx; line-height:104rpx; }
.university-list { display:flex; flex-direction:column; gap:20rpx; }
.load-more { padding:28rpx; color:#626c65; font-size:23rpx; text-align:center; }
.photo-skeleton { position:relative; box-sizing:border-box; min-height:420rpx; padding:176rpx 28rpx 28rpx; border-radius:20rpx; background:#e0e5df; }
.skeleton-favorite { position:absolute; top:18rpx; right:18rpx; width:104rpx; height:104rpx; border-radius:52rpx; background:#ccd4cc; }
.skeleton-identity { padding-top:34rpx; }
.skeleton-line { width:80%; height:28rpx; margin-top:14rpx; border-radius:4rpx; background:#c5cec5; }
.skeleton-line--title { width:60%; height:44rpx; }
.skeleton-line--location { width:45%; }
.control--pressed { opacity:.75; }
