.messages-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: var(--color-paper); }
.messages-heading { color: var(--color-deep); font-size: 40rpx; font-weight: 750; line-height: 1.4; }
.message-filters { display: flex; gap: 8rpx; margin: 24rpx 0; padding: 6rpx; border-radius: 16rpx; background: #e9f1ed; }
.message-filter { flex: 1; min-height: 88rpx; margin: 0; padding: 0 8rpx; border-radius: 12rpx; background: transparent; color: var(--color-muted); font-size: 26rpx; line-height: 88rpx; }
.message-filter--active { background: #fff; color: var(--color-action); font-weight: 700; }
.message-list { overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 16rpx; background: #fff; }
.message-row { width: 100%; min-height: 176rpx; margin: 0; padding: 26rpx 24rpx; border-bottom: 1rpx solid #e3ebe7; border-radius: 0; background: #fff; color: var(--color-ink); line-height: 1.5; text-align: left; }
.message-row:active { background: #f2f7f4; }
.message-row--busy { background: #fff; color: var(--color-ink); }
.message-row::after, .message-filter::after, .detail-close::after, .messages-more::after, .messages-retry::after, .login-button::after { border: 0; }
.message-title-line { display: flex; align-items: center; gap: 16rpx; }
.message-title { flex: 1; font-size: 28rpx; font-weight: 400; overflow-wrap: break-word; }
.message-row--unread .message-title { font-weight: 700; }
.message-unread-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-action); }
.message-body { display: -webkit-box; overflow: hidden; margin-top: 10rpx; color: var(--color-muted); font-size: 25rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; white-space: pre-wrap; overflow-wrap: break-word; }
.message-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 16rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.5; }
.messages-foot { padding: 18rpx 20rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.7; text-align: center; }
.messages-more, .messages-retry { min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 0; background: #fff; color: var(--color-action); font-size: 25rpx; line-height: 88rpx; }
.message-detail { margin-bottom: 24rpx; padding: 12rpx 24rpx 28rpx; border: 1rpx solid var(--color-line); border-radius: 16rpx; background: #fff; }
.detail-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.detail-category { color: var(--color-action); font-size: 24rpx; }
.detail-close { min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; background: transparent; color: var(--color-muted); font-size: 25rpx; line-height: 88rpx; }
.detail-title { margin-top: 8rpx; color: var(--color-ink); font-size: 32rpx; font-weight: 700; line-height: 1.6; overflow-wrap: break-word; }
.detail-time { margin-top: 8rpx; color: var(--color-muted); font-size: 23rpx; }
.detail-body { display: block; margin-top: 24rpx; color: var(--color-ink); font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; overflow-wrap: break-word; }
.message-login { padding: 60rpx 24rpx; text-align: center; }
.login-title { color: var(--color-deep); font-size: 32rpx; font-weight: 700; }
.login-copy { margin-top: 16rpx; color: var(--color-muted); font-size: 25rpx; line-height: 1.7; }
.login-button { min-height: 88rpx; margin-top: 32rpx; background: var(--color-action); color: #fff; font-size: 28rpx; line-height: 88rpx; }
.count-warning { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12rpx; margin-top: 20rpx; color: var(--color-muted); font-size: 23rpx; }
.count-retry { display: inline-block; min-height: 88rpx; padding: 0 12rpx; color: var(--color-action); line-height: 88rpx; }
@media (min-width: 600px) { .messages-page { max-width: 720px; margin: 0 auto; padding-right: 32px; padding-left: 32px; } }
