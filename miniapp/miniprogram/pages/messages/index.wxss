.messages-page {
  --message-paper: #f7faf7;
  --message-ink: #24282b;
  --message-muted: #707579;
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 0;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #fff;
}

.messages-unread { padding: 12rpx 0; color: #087c49; font-size: 22rpx; }
.message-filters { display: flex; justify-content: space-between; gap: 16rpx; margin: 0 0 12rpx; padding: 30rpx 0 32rpx; border-bottom: 1rpx solid #edf0ee; }
.message-filter { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 14rpx; min-height: 44px; margin: 0; padding: 0; background: transparent; color: #62696e; font-size: 24rpx; line-height: 1.5; }
.message-filter--active { color: #087c49; font-weight: 700; }
.filter-icon { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; border-radius: 50%; color: #238457; background: #eef8f0; }
.filter-icon--COMMUNITY { color: #4f73b8; background: #eef3fc; }
.filter-icon--SYSTEM { color: #7962b3; background: #f3effb; }
.filter-icon--APPLICATION { color: #c86438; background: #fff2e9; }
.filter-symbol { position: relative; box-sizing: border-box; width: 36rpx; height: 30rpx; border: 3rpx solid currentColor; border-radius: 12rpx; }
.filter-symbol::after { position: absolute; left: 4rpx; bottom: -8rpx; width: 9rpx; height: 9rpx; border-left: 3rpx solid currentColor; transform: skew(-22deg); content: ""; }
.filter-icon--COMMUNITY .filter-symbol { width: 20rpx; height: 20rpx; margin-top: -22rpx; border-radius: 50%; }
.filter-icon--COMMUNITY .filter-symbol::after { left: -10rpx; bottom: -24rpx; width: 34rpx; height: 17rpx; border: 3rpx solid currentColor; border-radius: 18rpx 18rpx 4rpx 4rpx; transform: none; }
.filter-icon--SYSTEM .filter-symbol { width: 30rpx; height: 32rpx; border-radius: 18rpx 18rpx 5rpx 5rpx; }
.filter-icon--SYSTEM .filter-symbol::after { left: 9rpx; bottom: -10rpx; width: 7rpx; height: 4rpx; border: 0; border-bottom: 3rpx solid currentColor; border-radius: 0 0 5rpx 5rpx; transform: none; }
.filter-icon--APPLICATION .filter-symbol { width: 29rpx; height: 38rpx; border-radius: 4rpx; }
.filter-icon--APPLICATION .filter-symbol::after { left: 5rpx; top: 10rpx; width: 13rpx; height: 7rpx; border: 0; border-top: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: none; }

.message-list { background: transparent; }
.system-summary { display: flex; align-items: center; gap: 20rpx; width: 100%; margin: 12rpx 0; padding: 24rpx 16rpx; box-sizing: border-box; border-radius: 18rpx; background: #f7f8fa; text-align: left; line-height: 1.5; }
.system-summary-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6rpx 16rpx; }
.system-summary-title { flex: 1; color: var(--message-ink); font-size: 29rpx; font-weight: 650; }
.system-summary-time { color: var(--message-muted); font-size: 20rpx; }
.system-summary-preview { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--message-muted); font-size: 24rpx; }
.system-summary-caption { margin-top: 8rpx; color: #7962b3; font-size: 21rpx; }
.message-thread { position: relative; }
.message-row { position: relative; display: flex; width: 100%; min-height: 148rpx; align-items: flex-start; gap: 22rpx; margin: 0; padding: 30rpx 0; border-bottom: 1rpx solid #e8eeeb; border-radius: 0; background: transparent; color: var(--color-ink); line-height: 1.5; text-align: left; }
.message-row:active { background: #f6faf7; }
.message-row--unread { background: transparent; }
.message-row--busy { opacity: .62; }
.message-category-mark { position: relative; z-index: 1; display: flex; width: 82rpx; height: 82rpx; flex: 0 0 82rpx; align-items: center; justify-content: center; border: 0; border-radius: 50%; background: #e5f2eb; box-sizing: border-box; }
.message-category-mark--SYSTEM { background: #f0edfa; color: #7962b3; }
.message-category-mark--APPLICATION { background: #fff2e9; color: #b65b32; }
.message-category-mark--COMMUNITY { background: #dff2e8; color: #087c49; }
.mark-core { position: relative; width: 28rpx; height: 28rpx; border: 3rpx solid currentColor; border-radius: 8rpx 8rpx 10rpx 4rpx; box-sizing: border-box; }
.mark-core::after { position: absolute; left: 3rpx; bottom: -7rpx; width: 8rpx; height: 8rpx; border-left: 3rpx solid currentColor; transform: skew(-24deg); content: ""; }
.mark-line { position: absolute; left: 6rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; }
.mark-line--top { top: 6rpx; width: 13rpx; }
.mark-line--bottom { top: 13rpx; width: 9rpx; opacity: .65; }
.message-category-mark--SYSTEM .mark-core { border-radius: 50%; }
.message-category-mark--SYSTEM .mark-core::after { display: none; }
.message-category-mark--SYSTEM .mark-line--top { width: 3rpx; height: 3rpx; left: 10rpx; top: 4rpx; }
.message-category-mark--SYSTEM .mark-line--bottom { width: 3rpx; height: 10rpx; left: 10rpx; top: 10rpx; opacity: 1; }
.message-category-mark--APPLICATION .mark-core { border-radius: 3rpx; height: 32rpx; }
.message-category-mark--APPLICATION .mark-core::after { display: none; }
.message-copy { min-width: 0; flex: 1; padding-top: 1rpx; }
.message-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; color: #707579; font-size: 20rpx; line-height: 1.5; letter-spacing: 0; }
.message-title-line { display: flex; align-items: center; gap: 14rpx; margin-top: 8rpx; }
.message-title { flex: 1; color: var(--message-ink); font-size: 29rpx; font-weight: 560; overflow-wrap: break-word; }
.message-row--unread .message-title { font-weight: 760; }
.message-unread-dot { flex: none; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--color-action); }
.message-body { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: var(--message-muted); font-size: 24rpx; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 2; white-space: pre-wrap; overflow-wrap: break-word; }
.message-chevron { align-self: center; flex: 0 0 auto; color: #a6b2ac; font-size: 40rpx; font-weight: 300; }

.messages-foot { padding: 30rpx 20rpx; color: #819087; font-size: 22rpx; line-height: 1.7; letter-spacing: 1rpx; text-align: center; }
.messages-more,
.messages-retry { min-height: 44px; margin: 12rpx auto 0; padding: 0 18rpx; background: transparent; color: var(--color-action); font-size: 24rpx; font-weight: 700; line-height: 44px; }

.message-detail { position: relative; margin: 26rpx 0 34rpx; padding: 26rpx 28rpx 34rpx; overflow: hidden; border-top: 1rpx solid #edf0ee; border-bottom: 1rpx solid #edf0ee; background: transparent; }
.detail-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.detail-category { color: var(--color-action); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.detail-close { min-width: 44px; min-height: 44px; margin: -10rpx -12rpx 0 0; padding: 0 12rpx; background: transparent; color: var(--message-muted); font-size: 23rpx; line-height: 44px; }
.detail-title { margin-top: 10rpx; color: var(--message-ink); font-size: 34rpx; font-weight: 760; line-height: 1.5; overflow-wrap: break-word; }
.detail-time { margin-top: 8rpx; color: #7a8a82; font-size: 21rpx; }
.detail-body { display: block; margin-top: 26rpx; color: var(--color-ink); font-size: 27rpx; line-height: 1.85; white-space: pre-wrap; overflow-wrap: break-word; }

.message-login { position: relative; min-height: 500rpx; padding: 80rpx 20rpx 40rpx; overflow: hidden; text-align: left; }
.login-title,
.login-copy,
.login-button { position: relative; z-index: 1; }
.login-title { color: var(--message-ink); font-size: 38rpx; font-weight: 760; }
.login-copy { max-width: 420rpx; margin-top: 16rpx; color: var(--message-muted); font-size: 25rpx; line-height: 1.75; }
.login-button { min-width: 200rpx; min-height: 48px; margin: 30rpx 0 0; padding: 0 30rpx; border-radius: 999rpx; background: var(--color-action); color: #fff; font-size: 26rpx; font-weight: 700; line-height: 48px; }
.count-warning { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12rpx; margin-top: 20rpx; color: var(--message-muted); font-size: 23rpx; }
.count-retry { display: inline-block; min-height: 44px; padding: 0 12rpx; color: var(--color-action); font-weight: 700; line-height: 44px; }

.message-row::after,
.message-filter::after,
.detail-close::after,
.messages-more::after,
.messages-retry::after,
.login-button::after { border: 0; }

@media (min-width: 600px) {
  .messages-page { max-width: 720px; margin: 0 auto; padding-right: 32px; padding-left: 32px; }
}
