.favorites-page{box-sizing:border-box;min-height:100vh;padding:30rpx;background:var(--color-wash)}.page-head{padding:12rpx 4rpx 28rpx}.eyebrow{color:var(--color-action);font-size:22rpx;font-weight:700;letter-spacing:3rpx}.heading{margin-top:8rpx;color:var(--color-ink);font-size:42rpx;font-weight:800}.copy{margin-top:10rpx;color:var(--color-muted);font-size:24rpx}.cards{display:grid;gap:24rpx}.notice{padding:20rpx 24rpx;border-radius:18rpx;background:var(--color-mint);color:var(--color-action);font-size:23rpx;line-height:1.5}.school-card{overflow:hidden;border-radius:26rpx;background:#fff;box-shadow:var(--shadow-card)}.cover{position:relative;height:280rpx}.cover-image,.cover-fallback{width:100%;height:100%}.cover-fallback{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--color-mint),#fff)}.cover-logo{width:180rpx;height:120rpx}.cover-fallback text{color:var(--color-action);font-size:64rpx;font-weight:800}.cover-shade{position:absolute;inset:55% 0 0;background:linear-gradient(transparent,rgba(4,39,28,.72))}.school-place{position:absolute;right:22rpx;bottom:18rpx;color:#fff;font-size:22rpx;font-weight:700}.card-body{padding:24rpx 26rpx 14rpx}.school-name{color:var(--color-ink);font-size:31rpx;font-weight:800}.school-english{margin-top:6rpx;color:var(--color-muted);font-size:23rpx}.school-location{margin-top:14rpx;color:var(--color-action);font-size:22rpx}.remove-button{margin:0 26rpx 24rpx;border-radius:999rpx;background:var(--color-mint);color:var(--color-action);font-size:23rpx;font-weight:700}.remove-button::after,.browse-button::after{border:0}.state-wrap{padding-top:40rpx}.browse-button{margin-top:22rpx;border-radius:18rpx;background:var(--color-action);color:#fff;font-size:27rpx;font-weight:700}