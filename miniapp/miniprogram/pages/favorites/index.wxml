<view class="favorite-page"><view class="head"><view class="eyebrow">已保存专业</view><view class="heading">专业收藏</view><view class="copy">集中查看你正在考虑的课程。</view></view><view wx:if="{{state === 'ready'}}" class="cards"><view wx:for="{{items}}" wx:key="id" class="card"><view class="card-main" data-id="{{item.id}}" data-slug="{{item.universitySlug}}" bindtap="open"><view class="level">{{item.level || '课程'}}</view><view class="name">{{item.name}}</view><view class="university">{{item.universityName}}</view></view><button class="remove" data-id="{{item.id}}" bindtap="remove">取消收藏</button></view></view><view wx:else class="state"><app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取收藏" description="正在同步已保存的专业。"/><app-state wx:elif="{{state === 'empty'}}" kind="empty" title="还没有收藏专业" description="浏览院校专业并点击收藏后，会显示在这里。"/><app-state wx:else kind="failed" title="收藏加载失败" description="请登录或稍后再试。" retryable="{{true}}" bind:retry="retry"/></view></view>
