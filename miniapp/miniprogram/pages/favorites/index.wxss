.favorite-page{min-height:100vh;padding:38rpx 26rpx 70rpx;box-sizing:border-box;background:#f7faf8}.eyebrow{color:#16845a;font-size:22rpx;font-weight:750}.heading{margin-top:6rpx;color:#153f36;font-size:44rpx;font-weight:850}.copy{margin-top:10rpx;color:#60776f;font-size:24rpx}.cards{display:flex;flex-direction:column;gap:16rpx;margin-top:30rpx}.card{display:flex;align-items:center;padding:26rpx;border:1rpx solid #d9e7e1;border-radius:22rpx;background:#fff}.card-main{min-width:0;flex:1}.level{color:#078552;font-size:20rpx;font-weight:750}.name{margin-top:10rpx;font-size:29rpx;font-weight:800}.university{margin-top:7rpx;color:#5c746d;font-size:22rpx}.remove{margin:0 0 0 18rpx;padding:0;background:transparent;color:#8d4747;font-size:21rpx}.state{padding-top:100rpx}
