<view class="page-shell planning-page">
  <view class="step-track">
    <view class="step step--active"><text>1</text><view>基本信息</view></view>
    <view class="step-line"></view>
    <view class="step"><text>2</text><view>学术背景</view></view>
    <view class="step-line"></view>
    <view class="step"><text>3</text><view>偏好与预算</view></view>
  </view>

  <view class="intro">
    <view class="page-title">告诉我们的情况</view>
    <view class="page-copy">填写真实意向，后续将用于匹配适合的院校和专业。</view>
  </view>

  <view class="form-section">
    <view class="field-title">你的留学目标</view>
    <view class="choice-grid">
      <view
        wx:for="{{studyGoals}}"
        wx:key="*this"
        class="choice {{selectedGoal === item ? 'choice--selected' : ''}}"
        data-value="{{item}}"
        bindtap="selectGoal"
      >{{item}}</view>
    </view>
  </view>

  <view class="form-section">
    <view class="field-title">你感兴趣的专业方向（可多选）</view>
    <view class="tag-grid">
      <view
        wx:for="{{subjectOptions}}"
        wx:key="*this"
        class="tag-choice {{selectedSubjects.includes(item) ? 'tag-choice--selected' : ''}}"
        data-value="{{item}}"
        bindtap="toggleSubject"
      >{{item}}</view>
    </view>
  </view>

  <view class="form-section">
    <view class="field-title">计划留学的国家或地区</view>
    <input class="text-field" value="{{country}}" placeholder="请输入国家或地区" bindinput="updateCountry" />
  </view>

  <view class="form-section">
    <view class="field-title">计划入学时间</view>
    <input class="text-field" value="{{intake}}" placeholder="例如：2027 年 9 月" bindinput="updateIntake" />
  </view>

  <button class="primary-action continue-button" bindtap="continuePlanning">下一步 →</button>
  <view class="privacy-note">此页面目前仅保留在本机，不会提交未完成的规划资料。</view>
</view>
