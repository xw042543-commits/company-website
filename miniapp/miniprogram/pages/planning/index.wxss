.planning-page {
  background: var(--color-paper);
}

.step-track {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.step {
  width: 150rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: center;
}

.step text {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  margin: 0 auto 10rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e6eeeb;
}

.step--active {
  color: var(--color-action);
  font-weight: 700;
}

.step--active text {
  background: var(--color-action);
  color: #fff;
}

.step-line {
  width: 76rpx;
  height: 2rpx;
  margin-top: 24rpx;
  background: var(--color-line);
}

.intro {
  margin-top: 50rpx;
}

.form-section {
  margin-top: 38rpx;
}

.field-title {
  margin-bottom: 18rpx;
  color: var(--color-deep);
  font-size: 28rpx;
  font-weight: 750;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.choice,
.tag-choice {
  box-sizing: border-box;
  min-height: 88rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  background: #fff;
  color: var(--color-muted);
  text-align: center;
}

.choice {
  padding: 26rpx 16rpx;
  font-size: 27rpx;
}

.choice--selected,
.tag-choice--selected {
  border-color: var(--color-action);
  background: #eaf6f1;
  color: var(--color-action);
  font-weight: 700;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-choice {
  min-width: 142rpx;
  min-height: 72rpx;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.text-field {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  background: #fff;
  color: var(--color-ink);
  font-size: 27rpx;
}

.continue-button {
  width: 100%;
  margin-top: 44rpx;
}

.privacy-note {
  margin: 22rpx 20rpx 0;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
