.consultation-page{box-sizing:border-box;min-height:100vh;padding:30rpx;background:var(--color-wash)}.page-intro{padding:20rpx 8rpx 28rpx}.page-title{color:var(--color-ink);font-size:38rpx;font-weight:800}.page-copy{margin-top:12rpx;color:var(--color-muted);font-size:24rpx;line-height:1.6}.context-card,.form-card,.success-card{border-radius:26rpx;background:#fff;box-shadow:var(--shadow-card)}.context-card{margin-bottom:22rpx;padding:24rpx 28rpx}.context-row{display:flex;align-items:flex-start;padding:10rpx 0}.context-label{width:90rpx;color:var(--color-muted);font-size:23rpx}.context-value{flex:1;color:var(--color-ink);font-size:26rpx;font-weight:700}.form-card{padding:8rpx 28rpx}.field{padding:24rpx 0;border-bottom:1rpx solid var(--color-line)}.field-label{margin-bottom:14rpx;color:var(--color-ink);font-size:25rpx;font-weight:700}.required-star{color:#b04435}.text-input,.notes-input,.picker-value{box-sizing:border-box;width:100%;color:var(--color-ink);font-size:27rpx}.notes-input{height:160rpx;line-height:1.6}.picker-value{display:flex;justify-content:space-between}.consent-row{padding:26rpx 8rpx}.consent-label{display:flex;align-items:flex-start}.consent-checkbox{margin-top:2rpx;transform:scale(.82)}.consent-copy{flex:1;color:var(--color-muted);font-size:22rpx;line-height:1.6}.primary-button,.secondary-button{border-radius:18rpx;font-size:28rpx;font-weight:700}.primary-button{background:var(--color-action);color:#fff}.primary-button::after,.secondary-button::after{border:0}.secondary-button{margin-top:18rpx;background:var(--color-mint);color:var(--color-action)}.success-card{padding:54rpx 34rpx;text-align:center}.success-mark{display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;margin:0 auto;border-radius:50%;background:var(--color-action);color:#fff;font-size:48rpx}.success-title{margin-top:28rpx;color:var(--color-ink);font-size:38rpx;font-weight:800}.success-copy{margin-top:14rpx;color:var(--color-muted);font-size:24rpx}.reference-label{margin-top:38rpx;color:var(--color-muted);font-size:21rpx}.reference-code{margin:10rpx 0 36rpx;word-break:break-all;color:var(--color-ink);font-size:25rpx;font-weight:700}
