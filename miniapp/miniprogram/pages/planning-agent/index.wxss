page{height:100%;background:#fff;color:#252724}
.agent-page{height:100%;position:relative;display:flex;flex-direction:column;box-sizing:border-box;background:#fff;color:#252724}
button{font-weight:400}button::after{border:0}.thread-tools{display:flex;align-items:center;justify-content:space-between;padding:0 38rpx;flex-shrink:0;min-height:66rpx}.thread-label{font-size:23rpx;color:#777b76}.quiet-button{min-height:88rpx;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;margin:0;padding:18rpx 0;background:transparent;color:#4b514c;font-size:25rpx;line-height:1.6;white-space:normal}.menu-trigger{font-size:23rpx;min-height:88rpx}.thread-menu{position:absolute;z-index:5;right:30rpx;top:70rpx;width:270rpx;padding:12rpx 22rpx;background:#fff;border-radius:18rpx;box-shadow:0 12rpx 45rpx #00000012}.thread-menu button{display:block;width:100%;min-height:88rpx;text-align:left;padding:18rpx 8rpx;margin:0;background:transparent;font-size:26rpx;line-height:1.6;color:#252724}
.agent-scroll{flex:1;min-height:0;height:0}.thread-content{padding:0 40rpx;max-width:1120rpx;margin:0 auto}.scroll-end{height:48rpx}.welcome{padding:170rpx 0 80rpx}.welcome-title{font-size:47rpx;font-weight:550;line-height:1.45;letter-spacing:-1rpx;margin-bottom:24rpx}.supporting{display:block;color:#70746e;font-size:26rpx;line-height:1.75;overflow-wrap:anywhere}.welcome .supporting{max-width:580rpx;font-size:28rpx}.welcome-actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:38rpx}.suggestion,.choice{display:inline-flex;align-items:center;justify-content:center;min-height:88rpx;margin:0;padding:18rpx 25rpx;border:1rpx solid #e1e4de;border-radius:48rpx;background:#fff;color:#40453f;font-size:26rpx;line-height:1.6}.suggestion{font-size:25rpx}.background-line{display:flex;align-items:center;gap:18rpx;padding:6rpx 0 12rpx;font-size:23rpx;color:#747a73;line-height:1.6}.background-line text{flex:1;min-width:0;overflow-wrap:anywhere}.background-line .quiet-button{font-size:23rpx;min-height:88rpx;color:#52695e}.snapshot-note{padding:0 0 24rpx;font-size:23rpx;color:#70746e;line-height:1.7}.snapshot-note text{display:block;margin-bottom:8rpx}
.user-row{display:flex;justify-content:flex-end;margin:26rpx 0 42rpx}.user-message{max-width:88%;padding:20rpx 26rpx;background:#f1f2f0;border-radius:28rpx;font-size:28rpx;line-height:1.65;overflow-wrap:anywhere}.assistant-paragraph{margin:28rpx 0;font-size:29rpx;line-height:1.85;overflow-wrap:anywhere}.assistant-question{margin:38rpx 0 18rpx;font-size:35rpx;font-weight:500;line-height:1.6;letter-spacing:-.4rpx}.profile-conversation{padding-bottom:16rpx}.question-field{margin-top:38rpx}.field-label{display:block;margin:30rpx 0 14rpx;font-size:25rpx;color:#555d54;line-height:1.6}.choice-row{display:flex;flex-wrap:wrap;gap:14rpx}.choice{min-height:88rpx;padding:14rpx 24rpx;font-size:26rpx}.choice.selected{background:#f0f4f0;border-color:#708578;color:#294938}.answer-input{display:block;box-sizing:border-box;width:100%;min-height:94rpx;height:94rpx;padding:18rpx 0;border:0;border-bottom:1rpx solid #dfe3dc;background:transparent;color:#252724;font-size:29rpx;line-height:1.7;border-radius:0}.answer-input::placeholder{color:#848a82}.step-actions{display:flex;align-items:center;gap:28rpx;flex-wrap:wrap;margin-top:44rpx}.compact-primary{min-height:88rpx;display:inline-flex;align-items:center;justify-content:center;margin:0;padding:20rpx 32rpx;background:#252724;color:#fff;border-radius:48rpx;font-size:27rpx;line-height:1.6}.compact-primary[disabled]{background:#e8ebe5;color:#798074}.quiet-button[disabled],.choice[disabled]{color:#a0a59d}.back-to-chat{margin-top:18rpx;font-size:23rpx;color:#7c8179}.summary-list{margin:28rpx 0}.summary-row{display:flex;align-items:flex-start;gap:28rpx;padding:13rpx 0;font-size:28rpx;line-height:1.7}.summary-label{width:192rpx;flex-shrink:0;color:#7a8076;font-size:25rpx}.summary-row>text:last-child{flex:1;min-width:0;overflow-wrap:anywhere}.more-background{color:#52695e}.consent{display:flex;align-items:flex-start;gap:12rpx;margin:28rpx 0;color:#697063;font-size:24rpx;line-height:1.75}.consent checkbox{flex-shrink:0;margin-top:4rpx;transform:scale(.86);transform-origin:left top}.consent text{flex:1;min-width:0}
.programme-result{padding:16rpx 0 26rpx;margin:0 0 24rpx;border:0;border-bottom:1rpx solid #eff0ed}.programme-image{display:block;width:100%;height:244rpx;margin-bottom:28rpx;border-radius:18rpx;background:#f5f6f3}.university-name{display:block;color:#798073;font-size:24rpx;line-height:1.6}.programme-title{margin:10rpx 0;font-size:33rpx;font-weight:600;line-height:1.55;overflow-wrap:anywhere;letter-spacing:-.5rpx}.programme-location{display:block;font-size:23rpx;color:#7a8076;line-height:1.6}.classification{margin:23rpx 0 12rpx;color:#8b631f;font-size:25rpx;line-height:1.7}.classification.ELIGIBLE{color:#3d7054}.classification.NOT_MET{color:#974b3d}.fact-row{color:#666e60;font-size:25rpx;line-height:1.85}.fee-row{margin-top:16rpx;color:#3d4338;font-size:27rpx;line-height:1.7}.fine-print{font-size:23rpx;line-height:1.7;margin-top:8rpx}.evidence-toggle{display:flex;align-items:center;min-height:88rpx;padding:14rpx 0;margin:8rpx 0 0;background:transparent;color:#506958;font-size:25rpx;line-height:1.6;text-align:left}.source{padding:20rpx 0;font-size:23rpx;line-height:1.8;color:#737b6c}.source text{display:block;overflow-wrap:anywhere}.source-url{color:#52695e;word-break:break-all}.next-step{margin:12rpx 0 8rpx}.result-actions{display:flex;gap:28rpx;flex-wrap:wrap;margin-top:16rpx}.inline-notice{margin:24rpx 0;color:#67705f;font-size:25rpx;line-height:1.8}.inline-notice.error{color:#8a5c27}.inline-notice .quiet-button{display:block;color:inherit}.working,.loading-copy{margin:40rpx 0;color:#6f7667;font-size:27rpx;line-height:1.7}
.composer-area{padding:14rpx 30rpx calc(14rpx + env(safe-area-inset-bottom));flex-shrink:0;background:#fff}.composer-area.keyboard-open{padding-bottom:12rpx}.composer{display:flex;align-items:center;gap:12rpx;min-height:112rpx;padding:10rpx 12rpx 10rpx 28rpx;border:1rpx solid #e4e7e0;border-radius:46rpx;background:#f8f9f6}.composer-input{flex:1;min-width:0;height:86rpx;font-size:28rpx;color:#252724}.send-button{display:flex;align-items:center;justify-content:center;min-height:88rpx;min-width:88rpx;width:88rpx;height:88rpx;margin:0;padding:0;border-radius:50%;background:#252724}.send-button[disabled]{background:#e1e4dc}.send-arrow{width:20rpx;height:27rpx;position:relative;border-left:3rpx solid #fff;transform:translateX(9rpx)}.send-arrow::before{content:"";position:absolute;width:15rpx;height:15rpx;border-top:3rpx solid #fff;border-left:3rpx solid #fff;top:0;left:-10rpx;transform:rotate(45deg)}.composer-caption{display:block;text-align:center;margin-top:13rpx;color:#969b90;font-size:20rpx;line-height:1.5}
.sheet-backdrop{position:absolute;z-index:9;top:0;right:0;bottom:0;left:0;background:#20251d33}.sheet{position:absolute;z-index:10;bottom:0;left:0;right:0;max-height:88%;height:88%;display:flex;flex-direction:column;border-radius:32rpx 32rpx 0 0;background:#fff;overflow:hidden;padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box}.small-sheet{height:auto;max-height:75%}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:32rpx 40rpx 14rpx;flex-shrink:0}.sheet-title{font-size:35rpx;font-weight:550;line-height:1.7}.sheet-subtitle{display:block;font-size:25rpx;color:#82897a;margin-top:4rpx;line-height:1.7}.sheet-head .quiet-button{min-height:88rpx;font-size:24rpx}.sheet-scroll{flex:1;min-height:0;height:0}.sheet-content{padding:0 40rpx 40rpx}.sheet-content>.supporting{margin-top:16rpx}.sheet-content .field-label:first-child{margin-top:8rpx}.notes-input{min-height:130rpx;height:auto;padding-top:10rpx}.sheet-content .compact-primary{margin-top:6rpx}.sheet-content .fine-print{margin-top:24rpx}
.welcome-title text{display:block}
.composer-input{border:0;background:transparent}
