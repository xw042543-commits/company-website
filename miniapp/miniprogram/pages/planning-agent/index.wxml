<view class="agent-page" style="padding-bottom: {{keyboardHeight}}px;">
  <view class="thread-tools"><text class="thread-label">{{isSnapshot ? '已保存的方案' : '马来西亚留学'}}</text><button class="quiet-button menu-trigger" bindtap="toggleMenu">更多</button></view>
  <view wx:if="{{menuOpen}}" class="thread-menu"><button bindtap="myPlans">历史方案</button><button bindtap="newSession" disabled="{{busy || state === 'polling' || state === 'sending'}}">新对话</button><button wx:if="{{sessionId &amp;&amp; !isSnapshot}}" bindtap="deleteSession" disabled="{{busy}}">删除这次对话</button></view>
  <scroll-view class="agent-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="thread-content">
      <view wx:if="{{loading}}" class="loading-copy">正在同步你的规划…</view>
      <block wx:else>
        <view wx:if="{{!available &amp;&amp; !isSnapshot}}" class="welcome"><view class="welcome-title">先看看你的留学方向。</view><text class="supporting">AI 规划暂未开放。你仍可以查询专业与院校，或直接和顾问聊聊。</text><view class="welcome-actions"><button class="suggestion" bindtap="catalogue">查询专业</button><button class="suggestion" bindtap="adviser">咨询顾问</button></view><button class="quiet-button" bindtap="myPlans">查看已保存的方案</button></view>
        <block wx:else>
          <view wx:if="{{profileVersion &amp;&amp; !formOpen}}" class="background-line"><text>{{backgroundSummary}}</text><button wx:if="{{!isSnapshot}}" class="quiet-button" bindtap="editProfile" disabled="{{busy || state === 'polling' || state === 'sending'}}">编辑</button></view>
          <view wx:if="{{isSnapshot}}" class="snapshot-note"><text>保存时的背景与结果，条件和费用可能已变化。</text><text wx:for="{{warnings}}" wx:key="*this">{{item}}</text></view>
          <view wx:if="{{!formOpen &amp;&amp; !profileVersion &amp;&amp; !messages.length &amp;&amp; !plan}}" class="welcome">
            <view class="welcome-title"><text>你想去马来西亚</text><text>读什么？</text></view><text class="supporting">从你的背景开始，一起核对专业条件与费用。</text>
            <view class="welcome-actions"><button class="suggestion" bindtap="beginPlanning">从我的背景开始</button><button class="suggestion" bindtap="catalogue">先看看专业</button></view>
          </view>
          <block wx:else>
            <view wx:for="{{messages}}" wx:key="id" class="user-row"><text class="user-message">{{item.text}}</text></view>
            <view wx:if="{{formOpen}}" class="profile-conversation">
              <block wx:if="{{!profileReview}}">
                <view class="assistant-question">{{stepTitle}}</view><text class="supporting">{{stepHint}}</text>
                <view wx:for="{{stepFields}}" wx:for-item="field" wx:key="key" class="question-field"><text class="field-label">{{field.label}}</text>
                  <view wx:if="{{field.options.length}}" class="choice-row"><block wx:for="{{field.choices}}" wx:for-item="choice" wx:key="value"><button wx:if="{{choice.value || field.key !== 'targetLevel'}}" class="choice {{field.value === choice.value ? 'selected' : ''}}" data-key="{{field.key}}" data-value="{{choice.value}}" bindtap="chooseField" disabled="{{busy}}">{{choice.label}}</button></block></view>
                  <input wx:else class="answer-input" value="{{field.value}}" type="{{field.numeric ? 'digit' : 'text'}}" maxlength="100" placeholder="{{field.key === 'intake' ? '例如 2027 或 2027-09' : '填写数值或简短信息，可留空'}}" data-key="{{field.key}}" bindinput="fieldChanged" disabled="{{busy}}"/>
                </view>
                <view class="step-actions"><button wx:if="{{profileStep > 0}}" class="quiet-button" bindtap="previousProfileStep">上一步</button><button class="compact-primary" bindtap="nextProfileStep" disabled="{{busy}}">{{profileStep >= 6 ? '核对背景' : '下一步'}}</button><button wx:if="{{profileStep > 0 &amp;&amp; profileStep &lt; 6}}" class="quiet-button" bindtap="reviewProfile">先用这些信息</button></view>
              </block>
              <block wx:else><view class="assistant-question">这些信息对吗？</view><text class="supporting">没有填写的项目会保留为待补充，不会替你猜测。</text>
                <view class="summary-list"><view wx:for="{{summaryRows}}" wx:key="label" class="summary-row"><text class="summary-label">{{item.label}}</text><text>{{item.value}}</text></view><text wx:if="{{!summaryRows.length}}" class="supporting">还没有填写背景，先补充目标学历和入学时间吧。</text></view>
                <button class="quiet-button more-background" bindtap="toggleMoreBackground">{{moreOpen ? '收起可补充项目' : '修改或补充更多信息'}}</button>
                <view wx:if="{{moreOpen}}" class="choice-row"><button wx:for="{{moreGroups}}" wx:key="step" class="choice" data-step="{{item.step}}" bindtap="openProfileGroup">{{item.label}}</button></view>
                <checkbox-group data-field="profileConsent" bindchange="consentChanged"><label class="consent"><checkbox value="yes" checked="{{profileConsent}}" color="#242624"/><text>我确认以上背景，可作为本次规划依据。</text></label></checkbox-group>
                <button class="compact-primary" bindtap="confirmProfile" loading="{{busy}}" disabled="{{busy || !profileConsent}}">确认背景</button>
              </block><button class="quiet-button back-to-chat" bindtap="closeProfile" disabled="{{busy}}">暂时返回对话</button>
            </view>
            <block wx:else>
              <view wx:if="{{plan}}" class="assistant-paragraph">按你确认的背景，先看这份专业清单。条件和费用会逐项核对。</view>
              <view wx:for="{{questions}}" wx:key="*this" class="assistant-paragraph">{{item}}</view>
              <view wx:if="{{state === 'sending' || state === 'polling'}}" class="working" role="status">{{state === 'sending' ? '正在提交…' : '正在核对条件与费用…'}}</view>
              <view wx:for="{{cards}}" wx:key="id" class="programme-result">
                <image wx:if="{{item.imageUrl &amp;&amp; !item.imageFailed}}" class="programme-image" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError" aria-label="{{item.university}}院校或专业图片"/>
                <text class="university-name">{{item.university}}</text><view class="programme-title">{{item.title}}</view><text class="programme-location">马来西亚 · 规划背景：{{backgroundSummary}}</text>
                <view class="classification {{item.classification}}">{{item.statusText}}</view><view wx:if="{{item.profileMissing}}" class="fact-row">背景待补充：{{item.profileMissing}}</view><view wx:if="{{item.evidenceMissing}}" class="fact-row">依据待核实：{{item.evidenceMissing}}</view><view wx:if="{{item.notMet}}" class="fact-row">不符合项：{{item.notMet}}</view>
                <view class="fee-row">{{item.fees}}</view><text class="supporting fine-print">{{item.feeNote}}</text><text wx:if="{{item.missingFees}}" class="supporting fine-print">费用缺项：{{item.missingFees}}</text>
                <button class="evidence-toggle" data-id="{{item.id}}" bindtap="expandEvidence">{{item.expanded ? '收起条件与依据' : '查看条件与依据'}}</button>
                <view wx:if="{{item.expanded}}" class="evidence-details"><text class="supporting">每条路径内需同时满足，多条路径为可选条件组合。</text><view wx:for="{{item.alternatives}}" wx:for-item="branch" wx:key="label" class="source"><text>{{branch.label}}</text><text wx:for="{{branch.conditions}}" wx:for-item="condition" wx:key="*this">{{condition}}</text></view>
                  <view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="id" class="source"><text>依据类别：{{source.factType}}</text><text>适用范围：{{source.studentScope}} · {{source.intake || '入学批次未注明'}}</text><text>核验 {{source.checkedDate}} · 有效至 {{source.expiresDate}}</text><text wx:if="{{source.safeUrl}}" class="source-url" selectable="{{true}}">{{source.safeUrl}}</text><button wx:if="{{source.safeUrl}}" class="quiet-button" data-url="{{source.safeUrl}}" bindtap="copySource">复制来源链接</button><text wx:else>暂无可安全打开的来源链接，请向院校核实。</text></view><text wx:if="{{!item.evidence.length}}" class="supporting">暂无可展示的核验来源。</text>
                </view>
              </view>
              <view wx:if="{{plan &amp;&amp; !cards.length}}" class="assistant-paragraph">本次没有可展示的专业。可以补充背景或调整方向，再试一次。</view>
              <view wx:for="{{steps}}" wx:key="*this" class="assistant-paragraph next-step">{{item}}</view>
              <view wx:if="{{!isSnapshot}}" class="result-actions"><button wx:if="{{profileVersion &amp;&amp; !plan}}" class="compact-primary" bindtap="generate" disabled="{{!available || busy || state === 'polling' || state === 'sending'}}">生成方案</button><button wx:if="{{profileVersion}}" class="quiet-button" bindtap="editProfile" disabled="{{busy || state === 'polling' || state === 'sending'}}">{{plan ? '调整背景' : '补充背景'}}</button><button wx:if="{{plan &amp;&amp; !savedPlanId}}" class="quiet-button" bindtap="openSave">保存方案</button><button wx:if="{{plan &amp;&amp; savedPlanId}}" class="quiet-button" bindtap="openShare">和顾问聊聊</button></view>
              <button wx:if="{{isSnapshot}}" class="quiet-button" bindtap="openShare">和顾问聊聊</button>
            </block>
          </block>
        </block>
        <view wx:if="{{error}}" class="inline-notice error" role="alert"><text>{{error.text}}</text><button class="quiet-button" bindtap="recover" disabled="{{busy}}">{{error.label}}</button></view><view wx:if="{{notice}}" class="inline-notice" role="status">{{notice}}</view>
      </block>
    </view><view class="scroll-end"></view>
  </scroll-view>
  <view wx:if="{{!isSnapshot &amp;&amp; !formOpen}}" class="composer-area {{keyboardHeight ? 'keyboard-open' : ''}}"><view class="composer"><input class="composer-input" value="{{input}}" maxlength="120" placeholder="聊聊你的留学打算…" confirm-type="send" adjust-position="{{false}}" bindinput="inputChanged" bindconfirm="send" bindkeyboardheightchange="keyboardChanged" bindblur="keyboardBlur" disabled="{{!available || state === 'sending' || state === 'polling'}}"/><button class="send-button" bindtap="send" disabled="{{!available || !input || busy || state === 'sending' || state === 'polling'}}" aria-label="发送"><view class="send-arrow"></view></button></view><text class="composer-caption">AI 辅助 · 以院校核实信息为准</text></view>
  <view wx:if="{{consentOpen || shareOpen || saveOpen}}" class="sheet-backdrop"></view>
  <view wx:if="{{consentOpen}}" class="sheet"><view class="sheet-head"><view class="sheet-title">开始之前</view><button class="quiet-button" bindtap="closeConsent" disabled="{{busy}}">关闭</button></view><scroll-view class="sheet-scroll" scroll-y="{{true}}"><view class="sheet-content"><text class="supporting">我们会保存对话和你确认的背景，并将必要的结构化教育信息提供给经审核的 AI 服务。请勿在对话中填写姓名、电话、证件号或个人经历。</text><text class="supporting">保存方案和向顾问分享都会另行征求确认。你可以删除对话和方案；已确认的咨询有独立处理周期。AI 辅助不代表录取承诺。</text><text class="supporting">此功能仅供年满 14 周岁的用户使用。说明版本：{{privacyVersion}}</text><text class="field-label">你的年龄段</text><picker range="{{ageLabels}}" value="{{ageIndex}}" bindchange="ageChanged"><view class="answer-input">{{ageLabels[ageIndex]}}</view></picker><checkbox-group data-field="privacyConsent" bindchange="consentChanged"><label class="consent"><checkbox value="yes" checked="{{privacyConsent}}" color="#242624"/><text>我已年满 14 周岁，阅读并同意以上使用说明。</text></label></checkbox-group><view wx:if="{{error}}" class="inline-notice error" role="alert"><text>{{error.text}}</text><button class="quiet-button" bindtap="recover" disabled="{{busy}}">{{error.label}}</button></view><view wx:if="{{notice}}" class="inline-notice" role="status">{{notice}}</view><button class="compact-primary" bindtap="start" loading="{{busy}}" disabled="{{busy || !ageBand || !privacyConsent}}">同意并开始</button></view></scroll-view></view>
  <view wx:if="{{saveOpen}}" class="sheet small-sheet"><view class="sheet-head"><view class="sheet-title">留住这次规划</view><button class="quiet-button" bindtap="closeSave" disabled="{{busy}}">关闭</button></view><view class="sheet-content"><text class="supporting">保存当前背景和方案快照，以后可以在历史方案中查看。</text><checkbox-group data-field="saveConsent" bindchange="consentChanged"><label class="consent"><checkbox value="yes" checked="{{saveConsent}}" color="#242624"/><text>我同意保存本次背景与方案。</text></label></checkbox-group><view wx:if="{{error}}" class="inline-notice error" role="alert"><text>{{error.text}}</text><button class="quiet-button" bindtap="recover" disabled="{{busy}}">{{error.label}}</button></view><view wx:if="{{notice}}" class="inline-notice" role="status">{{notice}}</view><button wx:if="{{!savedPlanId}}" class="compact-primary" bindtap="save" loading="{{busy}}" disabled="{{busy || state !== 'ready' || !saveConsent}}">确认保存</button><block wx:else><text class="supporting">方案已保存。</text><button class="quiet-button" bindtap="closeSave">返回对话</button></block></view></view>
  <view wx:if="{{shareOpen}}" class="sheet"><view class="sheet-head"><view><view class="sheet-title">和顾问聊聊</view><text class="sheet-subtitle">把你想问的，一起交给顾问。</text></view><button class="quiet-button" bindtap="closeShare" disabled="{{busy}}">关闭</button></view><scroll-view class="sheet-scroll" scroll-y="{{true}}"><view class="sheet-content"><block wx:if="{{receipt}}"><view class="assistant-question">咨询已提交</view><text class="supporting" selectable="{{true}}">回执：{{receipt}}</text></block><block wx:else>
    <text class="field-label">怎么称呼你</text><input class="answer-input" maxlength="100" value="{{consultation.name}}" data-key="name" bindinput="consultationChanged" disabled="{{busy}}" placeholder="你的称呼"/><text class="field-label">联系方式</text><input class="answer-input" maxlength="100" value="{{consultation.contact}}" data-key="contact" bindinput="consultationChanged" disabled="{{busy}}" placeholder="手机号、微信或邮箱"/>
    <text class="field-label">想重点聊什么</text><textarea class="answer-input notes-input" maxlength="1948" value="{{consultation.notes}}" data-key="notes" bindinput="consultationChanged" disabled="{{busy}}" placeholder="可选，由你决定分享哪些信息" auto-height="{{true}}"/>
    <button class="quiet-button" bindtap="toggleConsultationDetails">{{consultationDetails ? '收起意向信息' : '补充院校、专业或学历（可选）'}}</button><view wx:if="{{consultationDetails}}"><text class="field-label">意向院校</text><input class="answer-input" maxlength="200" value="{{consultation.intendedSchool}}" data-key="intendedSchool" bindinput="consultationChanged" disabled="{{busy}}"/><text class="field-label">意向专业</text><input class="answer-input" maxlength="200" value="{{consultation.intendedCourse}}" data-key="intendedCourse" bindinput="consultationChanged" disabled="{{busy}}"/><text class="field-label">申请学历</text><picker range="{{qualificationLabels}}" value="{{qualificationIndex}}" bindchange="qualificationChanged" disabled="{{busy}}"><view class="answer-input">{{qualificationLabels[qualificationIndex]}}</view></picker></view>
    <text class="supporting fine-print">仅发送这份方案的引用和你填写的资料，不发送聊天记录。</text><checkbox-group data-field="shareConsent" bindchange="consentChanged"><label class="consent"><checkbox value="yes" checked="{{shareConsent}}" color="#242624"/><text>我同意提交以上资料并由顾问联系。咨询有独立处理周期，删除对话、方案或账号不会自动删除已提交咨询。</text></label></checkbox-group><button class="compact-primary" bindtap="handoff" loading="{{busy}}" disabled="{{busy || !shareConsent}}">确认提交咨询</button>
  </block><view wx:if="{{error}}" class="inline-notice error" role="alert"><text>{{error.text}}</text><button class="quiet-button" bindtap="recover" disabled="{{busy}}">{{error.label}}</button></view><view wx:if="{{notice}}" class="inline-notice" role="status">{{notice}}</view></view></scroll-view></view>
</view>
