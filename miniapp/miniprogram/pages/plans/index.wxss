.list-page{min-height:100vh;padding:36rpx 26rpx 70rpx;box-sizing:border-box;background:#f6faf7}.page-head{display:flex;align-items:flex-end;justify-content:space-between}.eyebrow{color:#16845a;font-size:22rpx;font-weight:750}.heading{margin-top:6rpx;color:#153f36;font-size:44rpx;font-weight:850}.add{min-height:70rpx;margin:0;padding:0 24rpx;border-radius:16rpx;background:#087c50;color:#fff;font-size:24rpx;font-weight:750;line-height:70rpx}.cards{display:flex;flex-direction:column;gap:18rpx;margin-top:30rpx}.card{padding:28rpx;border:1rpx solid #d9e7e1;border-radius:24rpx;background:#fff;box-shadow:0 10rpx 26rpx rgba(20,63,54,.06)}.card-top{display:flex;align-items:center;justify-content:space-between}.goal{font-size:31rpx;font-weight:820}.status{padding:7rpx 14rpx;border-radius:999rpx;background:#e4f7ed;color:#087c50;font-size:20rpx;font-weight:700}.destination{margin-top:12rpx;color:#547068;font-size:24rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.tags text{padding:7rpx 12rpx;border-radius:8rpx;background:#eef5f1;color:#42655b;font-size:20rpx}.background{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #e1ebe7;color:#5f7770;font-size:23rpx}.delete{margin:20rpx 0 0 auto;padding:0;background:transparent;color:#8d4747;font-size:22rpx;line-height:48rpx}.state{padding-top:100rpx}
