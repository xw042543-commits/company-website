<view class="list-page"><view class="page-head"><view><view class="eyebrow">留学规划</view><view class="heading">我的规划</view></view><button class="add" bindtap="create">新建规划</button></view>
<view wx:if="{{state === 'ready'}}" class="cards"><view wx:for="{{plans}}" wx:key="id" class="card"><view class="card-top"><view class="goal">{{item.form.goal}}</view><view class="status">{{item.status === 'COMPLETED' ? '已完成' : '规划中'}}</view></view><view class="destination">{{item.form.country}} · {{item.form.intake || '入学时间待定'}}</view><view class="tags"><text wx:for="{{item.form.subjects}}" wx:key="*this">{{item}}</text></view><view class="background">{{item.form.education}}{{item.form.grade ? ' · ' + item.form.grade : ''}}</view><button class="delete" data-id="{{item.id}}" bindtap="remove">删除规划</button></view></view>
<view wx:else class="state"><app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取规划" description="正在同步你保存的留学目标。"/><app-state wx:elif="{{state === 'empty'}}" kind="empty" title="还没有留学规划" description="创建第一份规划，集中保存目标、背景与预算。"/><app-state wx:else kind="failed" title="规划加载失败" description="请登录或稍后再试。" retryable="{{true}}" bind:retry="retry"/></view></view>
