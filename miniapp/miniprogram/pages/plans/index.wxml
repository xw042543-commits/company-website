<view class="list-page"><view class="page-head"><view><view class="eyebrow">留学规划</view><view class="heading">我的方案</view></view><button class="add" bindtap="create">新建手动规划</button></view>
<view class="plan-kind-heading">AI 规划 · 已保存快照</view>
<view wx:if="{{agentState === 'ready'}}" class="cards"><view wx:for="{{agentPlans}}" wx:key="planId" class="card"><view class="goal">AI 留学方案 {{index + 1}}</view><view class="background">版本 {{item.version}} · 保存时的背景与结果，查看时核验来源状态</view><view class="card-actions"><button class="edit" data-id="{{item.planId}}" bindtap="openAgent">查看方案</button><button class="delete" data-id="{{item.planId}}" bindtap="removeAgent" disabled="{{removing}}">删除方案</button></view></view></view>
<view wx:elif="{{agentState === 'loading'}}" class="plan-kind-note">正在读取 AI 方案…</view><view wx:elif="{{agentState === 'empty'}}" class="plan-kind-note">还没有保存的 AI 方案。</view><view wx:else class="plan-kind-note">AI 方案暂时无法读取。<button class="edit" bindtap="retry">重新读取</button></view>
<view class="plan-kind-heading">手动规划</view>
<view wx:if="{{state === 'ready'}}" class="cards"><view wx:for="{{plans}}" wx:key="id" class="card"><view class="card-top"><view class="goal">{{item.form.goal}}</view><view class="status">{{item.status === 'COMPLETED' ? '已完成' : '规划中'}}</view></view><view class="destination">{{item.form.country}} · {{item.form.intake || '入学时间待定'}}</view><view class="tags"><text wx:for="{{item.form.subjects}}" wx:key="*this">{{item}}</text></view><view class="background">{{item.form.education}}{{item.form.grade ? ' · ' + item.form.grade : ''}}</view><view class="card-actions"><button class="edit" data-id="{{item.id}}" bindtap="edit">继续编辑</button><button class="delete" data-id="{{item.id}}" bindtap="remove">删除规划</button></view></view></view>
<view wx:else class="state"><app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取规划" description="正在同步你保存的留学目标。"/><app-state wx:elif="{{state === 'empty'}}" kind="empty" title="还没有留学规划" description="创建第一份规划，集中保存目标、背景与预算。"/><app-state wx:else kind="failed" title="规划加载失败" description="请登录或稍后再试。" retryable="{{true}}" bind:retry="retry"/></view></view>
