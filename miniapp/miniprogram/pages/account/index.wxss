.account-page {
  --account-paper: #f5f9f6;
  --account-ink: #143c30;
  --account-muted: #687971;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #ffffff;
}

.account-hero {
  position: relative;
  display: flex;
  min-height: 278rpx;
  align-items: center;
  padding: 52rpx 34rpx 64rpx;
  overflow: hidden;
  border-radius: 0 0 100rpx 28rpx;
  background: #0b8050;
  color: #ffffff;
}
.account-watermark {
  position: absolute;
  right: 34rpx;
  bottom: -100rpx;
  color: rgba(255, 255, 255, .09);
  font-size: 300rpx;
  font-weight: 900;
  line-height: 1;
  transform: rotate(9deg);
}
.account-orbit { position: absolute; border: 2rpx solid rgba(255, 255, 255, .15); border-radius: 50%; }
.account-orbit--one { top: -96rpx; right: -72rpx; width: 270rpx; height: 270rpx; }
.account-orbit--two { right: 120rpx; bottom: -156rpx; width: 330rpx; height: 330rpx; }

.avatar-placeholder,
.avatar-image {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, .78);
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, .18);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
}
.avatar-image { background: #ffffff; }
.avatar-button,
.avatar-shell {
  position: relative;
  z-index: 1;
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  overflow: visible;
}
.avatar-button::after { border: 0; }
.avatar-button-disabled { opacity: .72; }
.avatar-edit { position: absolute; right: -10rpx; bottom: -7rpx; padding: 6rpx 12rpx; border: 3rpx solid #0b8050; border-radius: 999rpx; background: #ffffff; color: #087749; font-size: 18rpx; font-weight: 750; }
.identity-copy { position: relative; z-index: 1; min-width: 0; margin-left: 26rpx; }
.identity-name { font-size: 36rpx; font-weight: 780; letter-spacing: -1rpx; }
.identity-hint { margin-top: 10rpx; color: rgba(255, 255, 255, .82); font-size: 23rpx; line-height: 1.55; }
.identity-arrow { position: relative; z-index: 1; margin-left: auto; color: rgba(255, 255, 255, .86); font-size: 52rpx; font-weight: 300; }

.overview-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: -28rpx 30rpx 0;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 0 28rpx 28rpx 28rpx;
  background: #f0f7f3;
}
.overview-item { position: relative; display: flex; min-height: 92rpx; align-items: center; justify-content: center; flex-direction: column; }
.overview-item + .overview-item::before { position: absolute; top: 13rpx; bottom: 13rpx; left: 0; width: 1rpx; background: #d4e4dc; content: ""; }
.overview-number { color: #087c49; font-size: 36rpx; font-weight: 800; line-height: 1.1; }
.overview-item text { margin-top: 8rpx; color: var(--account-muted); font-size: 20rpx; letter-spacing: 1rpx; }

.journey-heading { margin: 50rpx 30rpx 14rpx; }
.journey-title { color: var(--account-ink); font-size: 38rpx; font-weight: 780; letter-spacing: -1rpx; }
.journey-title::before { display: inline-block; width: 22rpx; height: 6rpx; margin-right: 12rpx; border-radius: 3rpx; background: var(--color-action); vertical-align: middle; content: ""; }
.journey-copy { margin-top: 10rpx; color: var(--account-muted); font-size: 22rpx; line-height: 1.6; letter-spacing: 1rpx; }

.menu-card { margin: 0 30rpx; background: transparent; overflow: visible; }
.menu-row {
  position: relative;
  display: flex;
  min-height: 118rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2ebe6;
}
.menu-row:active { background: #f7faf8; }
.menu-marker { display: flex; width: 68rpx; height: 68rpx; flex: 0 0 68rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e8f4ee; color: #087c49; font-size: 23rpx; font-weight: 800; }
.menu-marker--forest { background: #dcf0e5; color: #087749; }
.menu-marker--mint { background: #e7f5ee; color: #328165; }
.menu-marker--sage { background: #edf2e7; color: #687e48; }
.menu-marker--sky { background: #e8f1f4; color: #477486; }
.menu-marker--amber { background: #fbefd9; color: #a66a0e; }
.menu-marker--stone { background: #eef0ee; color: #65716b; }
.menu-copy { min-width: 0; flex: 1; margin-left: 22rpx; }
.menu-label { color: var(--account-ink); font-size: 28rpx; font-weight: 700; line-height: 1.35; }
.menu-caption { margin-top: 7rpx; color: var(--account-muted); font-size: 21rpx; line-height: 1.45; overflow-wrap: break-word; }
.menu-arrow { display: flex; width: 52rpx; height: 52rpx; flex: 0 0 52rpx; align-items: center; justify-content: center; margin-left: 12rpx; border-radius: 50%; background: var(--account-paper); color: #789087; font-size: 34rpx; font-weight: 300; }
.menu-count { min-width: 36rpx; margin-left: 14rpx; padding: 4rpx 9rpx; border-radius: 999rpx; background: #dff1e7; color: #087749; font-size: 20rpx; font-weight: 800; text-align: center; }
.menu-count + .menu-arrow { margin-left: 10rpx; }

@media (min-width: 600px) {
  .account-page { max-width: 720px; margin: 0 auto; }
}
.nickname-edit-mark { display:inline-block; margin-left:16rpx; padding:4rpx 12rpx; border:1rpx solid rgba(255,255,255,.35); border-radius:10rpx; font-size:22rpx; font-weight:400; vertical-align:middle; }
.nickname-backdrop { position:fixed; z-index:100; top:0; right:0; bottom:0; left:0; background:rgba(12,28,22,.34); }
.nickname-dialog { position:absolute; right:0; left:0; box-sizing:border-box; padding:28rpx 36rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#fff; color:#183c30; }
.nickname-dialog--typing { padding-bottom:24rpx; }
.nickname-header { display:flex; align-items:center; justify-content:space-between; }
.nickname-heading { font-size:34rpx; font-weight:600; line-height:1.4; }
.nickname-close { display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; min-height:80rpx; margin:-10rpx -16rpx -10rpx 0; padding:0; border:0; border-radius:50%; background:transparent; color:#88958f; font-size:44rpx; font-weight:400; line-height:1; }
.nickname-close::after { border:0; }
.nickname-description { margin:10rpx 0 28rpx; color:#7a8981; font-size:24rpx; line-height:1.5; }
.nickname-input-row { display:flex; align-items:center; gap:16rpx; padding:0 22rpx; border:1rpx solid #e8eeea; border-radius:14rpx; background:#f6f8f7; }
.nickname-input-row--error { border-color:#dfb6b1; }
.nickname-field { flex:1; min-width:0; height:88rpx; padding:0; color:#203d31; font-size:29rpx; }
.nickname-count { flex-shrink:0; color:#92a097; font-size:22rpx; font-variant-numeric:tabular-nums; }
.nickname-feedback { min-height:48rpx; padding-top:10rpx; box-sizing:border-box; line-height:1.5; }
.nickname-error { color:#b45349; font-size:23rpx; }
.nickname-actions { margin-top:6rpx; }
.nickname-save { display:flex; align-items:center; justify-content:center; width:100%; min-height:88rpx; margin:0; padding:20rpx 16rpx; border-radius:14rpx; background:#087a4e; color:#fff; font-size:28rpx; font-weight:600; line-height:1.5; }
.nickname-save::after { border:0; }
