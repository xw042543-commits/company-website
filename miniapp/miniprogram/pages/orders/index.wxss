.orders-page{min-height:100vh;background:#f6faf8;padding-bottom:calc(32rpx + env(safe-area-inset-bottom));}.filter-strip{position:sticky;top:0;z-index:2;background:#fff;border-bottom:1rpx solid #edf1ef;}.filters{display:flex;min-width:100%;padding:0 12rpx;box-sizing:border-box;}.filter{flex-shrink:0;position:relative;margin:0;padding:24rpx 18rpx;min-height:92rpx;background:transparent;border-radius:0;color:#63718a;font-size:27rpx;line-height:44rpx;font-weight:500;}.filter--active{color:#087b48;font-weight:700;}.filter--active::before{content:'';position:absolute;bottom:0;left:18rpx;right:18rpx;height:5rpx;background:#079a58;border-radius:5rpx;}.order-list{padding:24rpx;}.order-link{margin-bottom:22rpx;}.order-link--pressed{opacity:.8;}.load-more{font-size:26rpx;color:#087b48;background:transparent;min-height:88rpx;}.list-state{padding:36rpx 24rpx;}.browse{margin:28rpx auto;max-width:360rpx;min-height:88rpx;background:#07844e;color:#fff;border-radius:14rpx;font-size:28rpx;}
