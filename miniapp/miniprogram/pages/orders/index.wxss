.orders-page{box-sizing:border-box;min-height:100vh;padding-bottom:64rpx;background:#f5faf7}.filter-bar{position:sticky;top:0;z-index:4;box-sizing:border-box;width:100%;background:#fff;border-bottom:1rpx solid #e2ebe7;white-space:nowrap}.filter-row{display:inline-flex;min-width:100%;padding:0 22rpx}.filter{flex:0 0 auto;margin:0 14rpx;padding:28rpx 4rpx 22rpx;border-radius:0;background:transparent;color:#526761;font-size:25rpx;line-height:1}.filter--active{border-bottom:6rpx solid #0aa05e;color:#078e54;font-weight:800}.order-list{display:flex;flex-direction:column;gap:22rpx;padding:28rpx 24rpx}.order-card{overflow:hidden;border:1rpx solid #e0ebe6;border-radius:24rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(18,75,55,.06)}.order-main{display:flex;align-items:flex-start;padding:26rpx}.school-mark{display:flex;width:94rpx;height:94rpx;flex:0 0 auto;align-items:center;justify-content:center;border:1rpx solid #d6e5df;border-radius:18rpx;background:linear-gradient(145deg,#e7f6ef,#fff);color:#087b50;font-size:38rpx;font-weight:850}.order-copy{min-width:0;margin-left:22rpx}.university{color:#172e28;font-size:30rpx;font-weight:850}.programme{margin-top:8rpx;color:#254e42;font-size:25rpx;font-weight:650}.qualification{margin-top:8rpx;color:#6a7d77;font-size:22rpx}.status{flex:0 0 auto;margin-left:auto;padding:9rpx 18rpx;border-radius:999rpx;font-size:21rpx;font-weight:750}.status--active,.status--complete{background:#e2f8ed;color:#078e54}.status--warning{background:#fff1d9;color:#df7a00}.status--muted{background:#edf1ef;color:#64736e}.order-meta{position:relative;margin:0 26rpx;padding:20rpx 40rpx 22rpx 0;border-top:1rpx solid #e7efeb;color:#72847e;font-size:21rpx}.order-meta>view+view{margin-top:8rpx}.meta-value{margin-left:22rpx;color:#4d625c}.chevron{position:absolute;right:0;top:28rpx;color:#6d827b;font-size:46rpx}.state-wrap{padding-top:120rpx}.filtered-empty{padding:80rpx 0;color:#7a8c86;text-align:center;font-size:24rpx}
