<view class="orders-page">
  <scroll-view scroll-x class="filter-strip"><view class="filters"><button wx:for="{{filters}}" wx:key="value" class="filter {{filter === item.value ? 'filter--active' : ''}}" data-value="{{item.value}}" bindtap="choose" aria-label="{{item.label}}">{{item.label}}</button></view></scroll-view>
  <view wx:if="{{state === 'ready'}}" class="order-list"><view wx:for="{{items}}" wx:key="id" class="order-entry"><view class="order-link" hover-class="order-link--pressed" data-id="{{item.id}}" bindtap="open" role="button" aria-label="{{item.universityName + '，' + item.statusLabel}}"><application-card application="{{item}}" /></view><button wx:if="{{item.status === 'UNPAID'}}" class="continue-pay" data-id="{{item.id}}" loading="{{paying === item.id}}" disabled="{{!!paying}}" catchtap="pay">继续支付</button></view><button wx:if="{{hasMore}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="more">{{moreFailed ? '加载失败，点击重试' : '加载更多'}}</button></view>
  <view wx:else class="list-state"><app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取申请"/><app-state wx:elif="{{state === 'empty'}}" kind="empty" title="{{filter ? '暂无符合条件的申请' : '还没有申请记录'}}" description="{{filter ? '切换其他状态查看申请。' : '从收藏中选择专业并确认后，可在这里继续支付和查看进度。'}}"/><app-state wx:else kind="failed" title="{{state === 'login' ? '请先登录查看申请' : '申请加载失败'}}" description="请检查网络后重试。" retryable="{{true}}" bindretry="retry"/><button wx:if="{{state === 'empty' && !filter}}" class="browse" bindtap="browse">浏览院校</button></view>
</view>
