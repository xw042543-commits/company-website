.detail-page { min-height:100vh; background:#f8fbf9; color:#173f36; }
.detail-hero { position:relative; height:390rpx; overflow:hidden; background:#17664f; }
.detail-cover { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; }
.detail-cover--fallback { background:radial-gradient(circle at 70% 26%,#9de9c6 0,transparent 22%),linear-gradient(145deg,#0d8753,#1d6576 67%,#263e6e); }
.campus-lines { position:absolute; right:64rpx; bottom:45rpx; width:300rpx; height:190rpx; border:3rpx solid rgba(255,255,255,.34); border-radius:28rpx 28rpx 4rpx 4rpx; box-shadow:inset 0 -52rpx 0 rgba(255,255,255,.10),0 0 0 30rpx rgba(255,255,255,.04); }
.detail-shade { position:absolute; top:0; right:0; bottom:0; left:0; background:linear-gradient(180deg,rgba(5,32,25,.25),transparent 45%,rgba(5,32,25,.48)); }
.round-button { position:absolute; top:calc(22rpx + env(safe-area-inset-top)); display:flex; width:76rpx; height:76rpx; align-items:center; justify-content:center; padding:0; border-radius:50%; background:rgba(255,255,255,.94); color:#16483c; font-size:44rpx; line-height:76rpx; box-shadow:0 8rpx 24rpx rgba(10,42,34,.18); }
.round-button::after { border:0; }.back-button { left:24rpx; }.favorite-button { right:24rpx; }.favorite-button--active { color:#0a9b59; }
.school-summary { display:flex; margin:-42rpx 24rpx 0; position:relative; z-index:2; padding:24rpx; align-items:center; border-radius:28rpx; background:#fff; box-shadow:0 16rpx 48rpx rgba(17,65,52,.13); }
.school-logo { display:flex; width:112rpx; height:112rpx; flex:0 0 auto; align-items:center; justify-content:center; border:1rpx solid #d9e7e1; border-radius:24rpx; background:linear-gradient(145deg,#f0fff8,#eef4ff); color:#0a8653; font-size:46rpx; font-weight:850; }
.school-logo-image { width:84rpx; height:84rpx; }
.school-names { min-width:0; margin-left:22rpx; }.school-name { font-size:35rpx; font-weight:850; }.school-name-en { margin-top:5rpx; color:#55716a; font-size:21rpx; line-height:1.35; }.school-location { margin-top:12rpx; color:#648078; font-size:22rpx; }
.facts-grid { display:grid; grid-template-columns:repeat(3,1fr); margin:22rpx 24rpx 0; overflow:hidden; border:1rpx solid #dce9e4; border-radius:24rpx; background:#fff; }
.fact { padding:22rpx 8rpx; text-align:center; }.fact + .fact { border-left:1rpx solid #e1ebe7; }.fact-number { color:#08774c; font-size:27rpx; font-weight:800; }.fact-label { margin-top:6rpx; color:#70867f; font-size:19rpx; }
.detail-section { margin:42rpx 28rpx 0; }.section-index { color:#08a15c; font-size:21rpx; font-weight:800; letter-spacing:2rpx; }.section-title { margin-top:5rpx; color:#153f36; font-size:35rpx; font-weight:850; }.section-copy { margin-top:20rpx; color:#4b655e; font-size:27rpx; line-height:1.85; }
.programme-head { display:flex; margin:52rpx 28rpx 20rpx; align-items:flex-end; justify-content:space-between; }.programme-total { color:#6d827c; font-size:22rpx; }
.programme-list { display:flex; flex-direction:column; gap:16rpx; padding:0 24rpx; }.programme-card { padding:26rpx; border:1rpx solid #dce9e4; border-radius:24rpx; background:#fff; box-shadow:0 10rpx 28rpx rgba(18,65,52,.06); }.programme-topline { display:flex; align-items:center; justify-content:space-between; }.programme-level { padding:7rpx 13rpx; border-radius:8rpx; background:#e7f8f0; color:#08774c; font-size:19rpx; font-weight:700; }.programme-arrow { color:#0b8f57; font-size:27rpx; }.programme-name { margin-top:16rpx; font-size:29rpx; font-weight:800; }.programme-name-en { margin-top:6rpx; color:#647a74; font-size:21rpx; line-height:1.4; }.programme-meta { display:flex; gap:20rpx; margin-top:16rpx; color:#527067; font-size:21rpx; }
.programme-empty { margin:0 24rpx; padding:44rpx 24rpx; border-radius:22rpx; background:#eef6f2; color:#688078; text-align:center; }
.bottom-action-space { height:150rpx; }.bottom-action { position:fixed; z-index:5; right:0; bottom:0; left:0; display:flex; gap:14rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #dce9e4; background:rgba(255,255,255,.96); }
.consult-button,.save-button { min-height:82rpx; margin:0; border-radius:20rpx; font-size:26rpx; font-weight:750; line-height:82rpx; }.consult-button { flex:1.5; background:#078e54; color:#fff; }.save-button { flex:1; border:1rpx solid #9ec9b9; background:#fff; color:#167052; }.save-button--active { background:#e5f7ef; color:#078e54; }
.state-wrap { padding:calc(140rpx + env(safe-area-inset-top)) 28rpx 40rpx; }
