.detail-page { min-height:100vh; box-sizing:border-box; padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); background:var(--color-paper); color:var(--color-ink); }
.custom-header { position:absolute; z-index:4; top:0; right:0; left:0; box-sizing:border-box; background:linear-gradient(180deg,rgba(8,40,50,.5),transparent); padding-top:env(safe-area-inset-top); color:#fff; }
.navigation-row { display:flex; box-sizing:border-box; align-items:center; padding-left:12px; }
.back-button { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:76rpx; height:76rpx; min-height:76rpx; margin:0; padding:0; border-radius:50%; background:rgba(255,255,255,.9); color:var(--color-navy); font-size:58rpx; line-height:1; box-shadow:0 8rpx 24rpx rgba(0,0,0,.12); }
.navigation-title { min-width:0; margin-left:16rpx; color:#fff; font-size:29rpx; font-weight:700; line-height:1.4; text-shadow:0 2rpx 8rpx rgba(0,0,0,.4); }
.detail-hero { position:relative; height:430rpx; overflow:hidden; background:var(--color-wash); }
.detail-cover { width:100%; height:100%; }
.detail-cover--fallback { display:flex; box-sizing:border-box; flex-direction:column; align-items:center; justify-content:center; padding-bottom:32rpx; background:var(--color-wash); color:var(--color-muted); }
.campus-fallback-brand { font-size:44rpx; font-weight:700; letter-spacing:4rpx; }
.campus-fallback-copy { margin-top:16rpx; font-size:25rpx; }
.school-summary { position:relative; padding:0 28rpx 32rpx; background:var(--color-paper); }
.identity-row { display:flex; align-items:flex-end; }
.school-logo { display:flex; box-sizing:border-box; flex-shrink:0; width:128rpx; height:128rpx; margin-top:-48rpx; align-items:center; justify-content:center; border:1rpx solid var(--color-line); border-radius:18rpx; background:var(--color-paper); color:var(--color-action); font-size:44rpx; font-weight:700; box-shadow:0 12rpx 28rpx rgba(18,55,69,.12); }
.school-logo-image { width:108rpx; height:108rpx; }
.school-names { flex:1; min-width:0; margin-left:22rpx; }
.school-name { color:var(--color-navy); font-size:36rpx; font-weight:700; line-height:1.35; overflow-wrap:break-word; word-break:break-word; }
.school-name-en { margin-top:8rpx; color:var(--color-muted); font-size:24rpx; line-height:1.45; overflow-wrap:break-word; word-break:break-word; }
.school-meta { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:22rpx; }
.school-facts { flex:1; min-width:0; color:var(--color-muted); font-size:25rpx; line-height:1.6; overflow-wrap:break-word; word-break:break-word; }
.school-programme-count { color:var(--color-muted); font-size:23rpx; }
.identity-favorite { flex-shrink:0; min-height:104rpx; margin:0; padding:0 16rpx; border-radius:12rpx; background:transparent; color:var(--color-muted); font-size:25rpx; line-height:104rpx; }
.identity-favorite--active { background:var(--color-mint); color:var(--color-ink); }
.section-tabs { position:sticky; z-index:3; top:0; display:flex; overflow-x:auto; border-top:1rpx solid var(--color-line); border-bottom:1rpx solid var(--color-line); background:var(--color-paper); }
.section-tab { position:relative; flex:1; min-width:0; min-height:92rpx; margin:0; padding:0 8rpx; border-radius:0; background:transparent; color:var(--color-muted); font-size:25rpx; line-height:92rpx; white-space:nowrap; }
.section-tab--active { color:var(--color-ink); font-weight:700; }
.section-tab--active::before { position:absolute; right:28%; bottom:0; left:28%; height:6rpx; border-radius:6rpx 6rpx 0 0; background:var(--color-action); content:''; }
.introduction-panel,.facts-panel { padding:36rpx 28rpx; }
.section-title { display:inline-block; margin-bottom:24rpx; padding-bottom:10rpx; border-bottom:4rpx solid var(--color-brand); color:var(--color-navy); font-size:34rpx; font-weight:700; line-height:1.4; }
.description-paragraph { margin-bottom:24rpx; color:var(--color-muted); font-size:27rpx; line-height:1.75; overflow-wrap:break-word; word-break:break-word; }
.profile-facts-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:34rpx; padding:26rpx; border-radius:18rpx; background:linear-gradient(145deg,var(--color-mint),var(--color-wash)); }
.profile-fact { display:flex; min-width:0; flex-direction:column; }
.profile-fact-label { color:var(--color-muted); font-size:22rpx; line-height:1.4; }
.profile-fact-value { margin-top:8rpx; color:var(--color-navy); font-size:25rpx; font-weight:700; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.university-facts-table { overflow:hidden; border:1rpx solid var(--color-line); border-radius:18rpx; }
.university-fact-row { display:flex; min-height:92rpx; align-items:stretch; border-bottom:1rpx solid var(--color-line); }
.university-fact-row:last-child { border-bottom:0; }
.university-fact-label,.university-fact-value { display:flex; box-sizing:border-box; align-items:center; padding:20rpx; font-size:25rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.university-fact-label { flex-shrink:0; width:34%; background:var(--color-wash); color:var(--color-muted); }
.university-fact-value { flex:1; min-width:0; color:var(--color-navy); font-weight:600; }
.programmes-panel { padding:32rpx 28rpx; }
.category-options { display:flex; flex-wrap:wrap; gap:10rpx 14rpx; }
.category-chip { display:flex; box-sizing:border-box; max-width:100%; min-height:44px; margin:0; padding:14rpx 20rpx; align-items:center; justify-content:center; border:1rpx solid transparent; border-radius:8rpx; background:var(--color-wash); color:var(--color-muted); font-size:25rpx; line-height:1.4; white-space:normal; overflow-wrap:anywhere; }
.category-chip--active { border-color:var(--color-action); background:var(--color-action); color:var(--color-paper); font-weight:600; }
.programme-heading { display:flex; flex-wrap:wrap; gap:12rpx; align-items:baseline; justify-content:space-between; margin:32rpx 0 18rpx; color:var(--color-navy); font-size:30rpx; font-weight:700; }
.programme-total { color:var(--color-muted); font-size:24rpx; font-weight:400; }
.programme-list { overflow:hidden; border-radius:12rpx; background:var(--color-wash); }
.programme-row { display:flex; box-sizing:border-box; width:100%; min-height:120rpx; margin:0; padding:24rpx 20rpx; align-items:center; gap:18rpx; border-radius:0; border-bottom:1rpx solid var(--color-line); background:transparent; color:var(--color-ink); text-align:left; line-height:1.45; }
.programme-row:last-child { border-bottom:0; }
.programme-content { flex:1; min-width:0; }
.programme-name { font-size:29rpx; font-weight:500; overflow-wrap:anywhere; }
.programme-name-en { margin-top:8rpx; color:var(--color-muted); font-size:24rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.programme-detail-link { flex-shrink:0; padding:3rpx 14rpx; border:1rpx solid var(--color-action); border-radius:999rpx; color:var(--color-action); font-size:23rpx; line-height:1.4; }
.programme-empty { padding:44rpx 28rpx; color:var(--color-muted); text-align:center; font-size:27rpx; line-height:1.6; }
.bottom-action { position:fixed; z-index:5; right:0; bottom:0; left:0; display:flex; gap:16rpx; box-sizing:border-box; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--color-line); background:var(--color-paper); }
.consult-button,.save-button { display:flex; box-sizing:border-box; min-width:0; min-height:104rpx; margin:0; padding:18rpx 12rpx; align-items:center; justify-content:center; border-radius:12rpx; font-size:27rpx; font-weight:700; line-height:1.5; }
.consult-button { flex:1.4; background:var(--color-action); color:var(--color-paper); }
.save-button { flex:1; background:var(--color-wash); color:var(--color-muted); }
.save-button--active { background:var(--color-mint); color:var(--color-ink); }
.state-wrap { padding:80rpx 28rpx 40rpx; }
.control--pressed { opacity:.75; }
.detail-page { background:#fff; color:#20352f; }
.school-summary { padding-right:32rpx; padding-left:32rpx; }
.identity-row { display:block; }
.school-logo { width:112rpx; height:112rpx; border:4rpx solid #fff; border-radius:12rpx; background:#fff; box-shadow:0 4rpx 16rpx rgba(20,60,45,.08); }
.school-names { margin:20rpx 0 0; }
.school-name { color:#20352f; font-size:38rpx; }
.school-name-en { font-size:25rpx; line-height:1.6; }
.section-tabs { background:#fff; border-color:#edf1ee; }
.section-tab { min-height:88rpx; font-size:25rpx; }
.section-title { color:#20352f; border:0; padding-bottom:0; font-size:32rpx; }
.programmes-panel,.introduction-panel,.facts-panel { padding:32rpx; }
.category-options { display:block; width:100%; white-space:nowrap; padding-bottom:16rpx; }
.category-options__track { display:inline-flex; min-width:100%; align-items:center; padding:2rpx 0 6rpx; }
.category-chip { display:inline-flex; width:auto; min-height:76rpx; margin:0 12rpx 0 0; padding:12rpx 24rpx; border:1rpx solid #e8eeea; border-radius:38rpx; background:#f6f9f7; font-size:24rpx; vertical-align:middle; }
.category-chip--active { border-color:var(--color-action); background:var(--color-action); color:#fff; }
.category-count { margin-left:10rpx; opacity:.72; font-size:21rpx; }
.programme-heading { margin-top:26rpx; font-size:28rpx; color:#20352f; }
.programme-total { font-size:23rpx; color:#7b8782; }
.programme-list { background:#fff; border-radius:0; }
.programme-row { min-height:144rpx; padding:28rpx 0; border-bottom:1rpx solid #e9efeb; border-radius:0; background:#fff; }
.programme-name { color:#20352f; font-size:29rpx; line-height:1.6; font-weight:600; }
.programme-name-en { margin-top:10rpx; color:#7b8782; font-size:23rpx; line-height:1.6; }
.programme-detail-link { flex-shrink:0; margin-left:20rpx; padding:8rpx 14rpx; border:0; background:#f0f7f3; font-size:22rpx; }
.university-facts-table { border:0; border-radius:0; box-shadow:none; }
.university-fact-row { min-height:88rpx; border-color:#edf1ee; }
.university-fact-label { background:transparent; color:#7b8782; font-weight:400; }
.university-fact-value { font-weight:400; color:#20352f; }
.bottom-action { background:#fff; border-color:#edf1ee; }
.save-button,.consult-button { min-height:88rpx; font-size:26rpx; border-radius:12rpx; }
