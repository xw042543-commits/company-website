.detail-page { min-height:100vh; box-sizing:border-box; padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); background:var(--color-paper); color:var(--color-ink); }
.custom-header { box-sizing:border-box; background:var(--color-wash); padding-top:env(safe-area-inset-top); }
.navigation-row { display:flex; box-sizing:border-box; align-items:center; padding-left:12px; }
.back-button { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:44px; min-height:44px; margin:0; padding:0; background:transparent; color:var(--color-ink); font-size:64rpx; line-height:1; border-radius:0; }
.navigation-title { color:var(--color-navy); min-width:0; margin-left:8rpx; font-size:30rpx; font-weight:700; line-height:1.4; }
.detail-hero { position:relative; height:360rpx; overflow:hidden; background:var(--color-wash); }
.detail-cover { width:100%; height:100%; }
.detail-cover--fallback { display:flex; box-sizing:border-box; flex-direction:column; align-items:center; justify-content:center; padding-bottom:32rpx; background:var(--color-wash); color:var(--color-muted); }
.campus-fallback-brand { font-size:44rpx; font-weight:700; letter-spacing:4rpx; }
.campus-fallback-copy { margin-top:16rpx; font-size:25rpx; }
.school-summary { position:relative; padding:28rpx; background:var(--color-paper); }
.identity-row { display:flex; align-items:center; }
.school-logo { display:flex; box-sizing:border-box; flex-shrink:0; width:104rpx; height:104rpx; align-items:center; justify-content:center; border:1rpx solid var(--color-line); border-radius:12rpx; background:var(--color-wash); color:var(--color-action); font-size:44rpx; font-weight:700; }
.school-logo-image { width:88rpx; height:88rpx; }
.school-names { flex:1; min-width:0; margin-left:22rpx; }
.school-name { color:var(--color-navy); font-size:36rpx; font-weight:700; line-height:1.35; overflow-wrap:break-word; word-break:break-word; }
.school-name-en { margin-top:8rpx; color:var(--color-muted); font-size:24rpx; line-height:1.45; overflow-wrap:break-word; word-break:break-word; }
.school-meta { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:20rpx; }
.school-facts { flex:1; min-width:0; color:var(--color-muted); font-size:25rpx; line-height:1.6; overflow-wrap:break-word; word-break:break-word; }
.school-programme-count { color:var(--color-muted); font-size:23rpx; }
.identity-favorite { flex-shrink:0; min-height:104rpx; margin:0; padding:0 16rpx; border-radius:12rpx; background:transparent; color:var(--color-muted); font-size:25rpx; line-height:104rpx; }
.identity-favorite--active { background:var(--color-mint); color:var(--color-ink); }
.section-tabs { display:flex; border-top:1rpx solid var(--color-line); border-bottom:1rpx solid var(--color-line); }
.section-tab { position:relative; flex:1; min-height:104rpx; margin:0; padding:0 16rpx; border-radius:0; background:transparent; color:var(--color-muted); font-size:29rpx; line-height:104rpx; }
.section-tab--active { color:var(--color-ink); font-weight:700; }
.section-tab--active::before { position:absolute; right:28%; bottom:0; left:28%; height:6rpx; border-radius:6rpx 6rpx 0 0; background:var(--color-action); content:''; }
.introduction-panel { padding:32rpx 28rpx; }
.section-title { color:var(--color-navy); margin-bottom:20rpx; font-size:30rpx; font-weight:700; line-height:1.4; }
.description-paragraph { margin-bottom:24rpx; color:var(--color-muted); font-size:27rpx; line-height:1.75; overflow-wrap:break-word; word-break:break-word; }
.programmes-panel { padding:32rpx 28rpx; }
.category-options { display:flex; flex-wrap:wrap; gap:10rpx 14rpx; }
.category-chip { display:flex; box-sizing:border-box; max-width:100%; min-height:44px; margin:0; padding:14rpx 20rpx; align-items:center; justify-content:center; border:1rpx solid transparent; border-radius:8rpx; background:var(--color-wash); color:var(--color-muted); font-size:25rpx; line-height:1.4; white-space:normal; overflow-wrap:anywhere; }
.category-chip--active { border-color:var(--color-action); background:var(--color-action); color:var(--color-paper); font-weight:600; }
.programme-heading { display:flex; flex-wrap:wrap; gap:12rpx; align-items:baseline; justify-content:space-between; margin:32rpx 0 18rpx; color:var(--color-navy); font-size:30rpx; font-weight:700; }
.programme-total { color:var(--color-muted); font-size:24rpx; font-weight:400; }
.programme-list { overflow:hidden; border-radius:12rpx; background:var(--color-wash); }
.programme-row { display:flex; box-sizing:border-box; width:100%; min-height:120rpx; margin:0; padding:24rpx 20rpx; align-items:center; gap:18rpx; border-radius:0; border-bottom:1rpx solid var(--color-line); background:transparent; color:var(--color-ink); text-align:left; line-height:1.45; }
.programme-row:last-child { border-bottom:0; }
.programme-content { flex:1; min-width:0; }
.programme-name { font-size:29rpx; font-weight:500; overflow-wrap:anywhere; }
.programme-name-en { margin-top:8rpx; color:var(--color-muted); font-size:24rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.programme-detail-link { flex-shrink:0; padding:3rpx 14rpx; border:1rpx solid var(--color-action); border-radius:999rpx; color:var(--color-action); font-size:23rpx; line-height:1.4; }
.programme-empty { padding:44rpx 28rpx; color:var(--color-muted); text-align:center; font-size:27rpx; line-height:1.6; }
.bottom-action { position:fixed; z-index:5; right:0; bottom:0; left:0; display:flex; gap:16rpx; box-sizing:border-box; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--color-line); background:var(--color-paper); }
.consult-button,.save-button { display:flex; box-sizing:border-box; min-width:0; min-height:104rpx; margin:0; padding:18rpx 12rpx; align-items:center; justify-content:center; border-radius:12rpx; font-size:27rpx; font-weight:700; line-height:1.5; }
.consult-button { flex:1.4; background:var(--color-action); color:var(--color-paper); }
.save-button { flex:1; background:var(--color-wash); color:var(--color-muted); }
.save-button--active { background:var(--color-mint); color:var(--color-ink); }
.state-wrap { padding:80rpx 28rpx 40rpx; }
.control--pressed { opacity:.75; }
