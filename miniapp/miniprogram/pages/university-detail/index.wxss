.detail-page { min-height:100vh; box-sizing:border-box; padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); background:#fdfdfb; color:#202923; }
.custom-header { box-sizing:border-box; background:#f5d66f; padding-top:env(safe-area-inset-top); }
.navigation-row { display:flex; box-sizing:border-box; align-items:center; padding-left:12px; }
.back-button { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:44px; min-height:44px; margin:0; padding:0; background:transparent; color:#202923; font-size:64rpx; line-height:1; border-radius:0; }
.navigation-title { min-width:0; margin-left:8rpx; font-size:30rpx; font-weight:700; line-height:1.4; }
.detail-hero { position:relative; height:360rpx; overflow:hidden; background:#e9e7d9; }
.detail-cover { width:100%; height:100%; }
.detail-cover--fallback { display:flex; box-sizing:border-box; flex-direction:column; align-items:center; justify-content:center; padding-bottom:32rpx; background:#ede9d7; color:#4c554c; }
.campus-fallback-brand { font-size:44rpx; font-weight:700; letter-spacing:4rpx; }
.campus-fallback-copy { margin-top:16rpx; font-size:25rpx; }
.school-summary { position:relative; margin-top:-24rpx; padding:28rpx; border-radius:24rpx 24rpx 0 0; background:#fdfdfb; }
.identity-row { display:flex; align-items:center; }
.school-logo { display:flex; box-sizing:border-box; flex-shrink:0; width:104rpx; height:104rpx; align-items:center; justify-content:center; border:1rpx solid #dce1dc; border-radius:12rpx; background:#f6f7f5; color:#404a43; font-size:44rpx; font-weight:700; }
.school-logo-image { width:88rpx; height:88rpx; }
.school-names { flex:1; min-width:0; margin-left:22rpx; }
.school-name { font-size:36rpx; font-weight:700; line-height:1.35; overflow-wrap:break-word; word-break:break-word; }
.school-name-en { margin-top:8rpx; color:#626c65; font-size:24rpx; line-height:1.45; overflow-wrap:break-word; word-break:break-word; }
.school-meta { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:20rpx; }
.school-facts { flex:1; min-width:0; color:#49544d; font-size:25rpx; line-height:1.6; overflow-wrap:break-word; word-break:break-word; }
.school-programme-count { color:#626c65; font-size:23rpx; }
.identity-favorite { flex-shrink:0; min-height:104rpx; margin:0; padding:0 16rpx; border-radius:12rpx; background:transparent; color:#49544d; font-size:25rpx; line-height:104rpx; }
.identity-favorite--active { background:#f9e8a6; color:#202923; }
.section-tabs { display:flex; border-top:1rpx solid #edf0ec; border-bottom:1rpx solid #dce1dc; }
.section-tab { position:relative; flex:1; min-height:104rpx; margin:0; padding:0 16rpx; border-radius:0; background:transparent; color:#626c65; font-size:29rpx; line-height:104rpx; }
.section-tab--active { color:#202923; font-weight:700; }
.section-tab--active::before { position:absolute; right:28%; bottom:0; left:28%; height:6rpx; border-radius:6rpx 6rpx 0 0; background:#f5d66f; content:''; }
.introduction-panel { padding:32rpx 28rpx; }
.section-title { margin-bottom:24rpx; font-size:30rpx; font-weight:700; line-height:1.4; }
.description-paragraph { margin-bottom:24rpx; color:#49544d; font-size:27rpx; line-height:1.75; overflow-wrap:break-word; word-break:break-word; }
.category-scroll { width:100%; white-space:nowrap; }
.category-options { display:inline-flex; gap:14rpx; padding:24rpx 28rpx 16rpx; }
.category-chip { display:flex; box-sizing:border-box; min-width:120rpx; max-width:400rpx; min-height:104rpx; margin:0; padding:18rpx 24rpx; align-items:center; justify-content:center; border:1rpx solid #dce1dc; border-radius:12rpx; background:#f6f7f5; color:#49544d; font-size:25rpx; line-height:1.45; white-space:normal; overflow-wrap:break-word; word-break:break-word; }
.category-chip--active { border-color:#f5d66f; background:#f5d66f; color:#202923; font-weight:700; }
.programme-heading { display:flex; flex-wrap:wrap; gap:16rpx; align-items:baseline; justify-content:space-between; padding:16rpx 28rpx 22rpx; font-size:28rpx; font-weight:700; }
.programme-total { color:#626c65; font-size:24rpx; font-weight:400; }
.programme-list { padding:0 28rpx; }
.programme-row { display:flex; box-sizing:border-box; width:100%; min-height:144rpx; margin:0; padding:26rpx 0; align-items:center; gap:18rpx; border-radius:0; border-bottom:1rpx solid #e5e8e2; background:transparent; color:#202923; text-align:left; line-height:1.4; }
.programme-content { flex:1; min-width:0; }
.programme-name { font-size:29rpx; font-weight:700; overflow-wrap:break-word; word-break:break-word; }
.programme-name-en { margin-top:8rpx; color:#626c65; font-size:24rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.programme-meta { display:flex; flex-wrap:wrap; gap:12rpx 20rpx; align-items:center; margin-top:14rpx; color:#49544d; font-size:23rpx; overflow-wrap:break-word; word-break:break-word; }
.programme-level { padding:4rpx 10rpx; border-radius:6rpx; background:#f2f0e7; color:#49544d; }
.programme-intakes { margin-top:12rpx; color:#49544d; font-size:23rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.programme-arrow { flex-shrink:0; color:#49544d; font-size:44rpx; }
.programme-empty { padding:44rpx 28rpx; color:#626c65; text-align:center; font-size:27rpx; line-height:1.6; }
.bottom-action { position:fixed; z-index:5; right:0; bottom:0; left:0; display:flex; gap:16rpx; box-sizing:border-box; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #dce1dc; background:#fdfdfb; }
.consult-button,.save-button { display:flex; box-sizing:border-box; min-width:0; min-height:104rpx; margin:0; padding:18rpx 12rpx; align-items:center; justify-content:center; border-radius:12rpx; font-size:27rpx; font-weight:700; line-height:1.5; }
.consult-button { flex:1.4; background:#f5d66f; color:#202923; }
.save-button { flex:1; background:#f6f7f5; color:#49544d; }
.save-button--active { background:#f9e8a6; color:#202923; }
.state-wrap { padding:80rpx 28rpx 40rpx; }
.control--pressed { opacity:.75; }
