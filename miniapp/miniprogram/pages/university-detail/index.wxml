<view class="detail-page">
  <view class="custom-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="navigation-row" style="min-height:{{navigationHeight}}px; padding-right:{{navigationRight}}px;">
      <button class="back-button" bindtap="back" aria-label="返回" hover-class="control--pressed">‹</button>
      <text class="navigation-title">院校详情</text>
    </view>
  </view>

  <view wx:if="{{state === 'ready'}}">
    <view class="detail-hero">
      <image wx:if="{{university.imageUrl && !imageFailed}}" class="detail-cover" src="{{university.imageUrl}}" mode="aspectFill" fade-show binderror="imageError" aria-label="{{university.nameZh}}校园" />
      <view wx:else class="detail-cover detail-cover--fallback">
        <text class="campus-fallback-brand">洋豆角</text>
        <text class="campus-fallback-copy">校园图片暂未提供</text>
      </view>
    </view>

    <view class="school-summary">
      <view class="identity-row">
        <view class="school-logo">
          <image wx:if="{{university.logoUrl && !logoFailed}}" class="school-logo-image" src="{{university.logoUrl}}" mode="aspectFit" binderror="logoError" aria-label="{{university.nameZh}}校徽" />
          <text wx:else>{{logoLetter}}</text>
        </view>
        <view class="school-names">
          <view class="school-name">{{university.nameZh}}</view>
          <view class="school-name-en">{{university.nameEn}}</view>
        </view>
      </view>
      <view class="school-meta">
        <view class="school-facts">
          <view class="school-location">{{location || '地点资料待补充'}}</view>
          <view wx:if="{{programmeCount > 0}}" class="school-programme-count">已收录 {{programmeCount}} 个专业</view>
        </view>
        <button class="identity-favorite {{favorite ? 'identity-favorite--active' : ''}}" bindtap="toggleFavorite" aria-label="{{favorite ? '取消收藏' : '收藏院校'}}" hover-class="control--pressed">{{favorite ? '♥ 已收藏' : '♡ 收藏'}}</button>
      </view>
    </view>

    <view class="section-tabs" aria-role="tablist" aria-label="院校资料">
      <button class="section-tab {{activeSection === 'introduction' ? 'section-tab--active' : ''}}" data-section="introduction" bindtap="selectSection" aria-role="tab" aria-selected="{{activeSection === 'introduction'}}" hover-class="control--pressed">院校简介</button>
      <button class="section-tab {{activeSection === 'programmes' ? 'section-tab--active' : ''}}" data-section="programmes" bindtap="selectSection" aria-role="tab" aria-selected="{{activeSection === 'programmes'}}" hover-class="control--pressed">专业查询</button>
    </view>

    <view wx:if="{{activeSection === 'introduction'}}" class="introduction-panel" aria-role="tabpanel">
      <view class="section-title">院校简介</view>
      <view wx:if="{{descriptionParagraphs.length > 0}}" class="introduction-copy">
        <view wx:for="{{descriptionParagraphs}}" wx:key="index" class="description-paragraph">{{item}}</view>
      </view>
      <view wx:else class="description-paragraph">该院校的详细简介正在审核整理中，可在专业查询中查看已发布专业。</view>
    </view>

    <view wx:else class="programmes-panel" aria-role="tabpanel">
      <view wx:if="{{programmeCategories.length > 0}}" class="section-title">专业分类</view>
        <view class="category-options" aria-label="按专业分类筛选">
          <button wx:for="{{programmeCategories}}" wx:key="code" class="category-chip {{activeCategory === item.code ? 'category-chip--active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory" aria-pressed="{{activeCategory === item.code}}" hover-class="control--pressed">{{item.label || '未分类'}}</button>
        </view>
      <view class="programme-heading">专业列表<text class="programme-total">{{visibleProgrammes.length}} 个专业</text></view>
      <view wx:if="{{visibleProgrammes.length > 0}}" class="programme-list">
        <button wx:for="{{visibleProgrammes}}" wx:key="id" class="programme-row" bindtap="openProgramme" data-id="{{item.id}}" aria-label="查看{{item.nameZh}}专业详情" hover-class="control--pressed">
          <view class="programme-content">
            <view class="programme-name">{{item.nameZh}}</view>
            <view wx:if="{{item.nameEn}}" class="programme-name-en">{{item.nameEn}}</view>
          </view>
          <text class="programme-detail-link" aria-hidden="true">详情</text>
        </button>
      </view>
      <view wx:else class="programme-empty">暂无已发布专业资料</view>
    </view>

    <view class="bottom-action">
      <button class="save-button {{favorite ? 'save-button--active' : ''}}" bindtap="toggleFavorite" aria-label="{{favorite ? '取消收藏' : '收藏院校'}}" hover-class="control--pressed">{{favorite ? '♥ 已收藏' : '♡ 收藏院校'}}</button>
      <button class="consult-button" bindtap="consult" hover-class="control--pressed">咨询顾问</button>
    </view>
  </view>

  <view wx:else class="state-wrap">
    <app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取院校详情" description="正在加载院校简介与专业资料。" />
    <app-state wx:elif="{{state === 'offline'}}" kind="offline" title="网络暂时不可用" description="请检查网络连接后重新加载。" retryable="{{true}}" bind:retry="retry" />
    <app-state wx:else kind="failed" title="院校详情加载失败" description="服务暂时无法返回有效资料，请稍后重试。" retryable="{{true}}" bind:retry="retry" />
  </view>
</view>
