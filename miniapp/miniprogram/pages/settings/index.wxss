.settings-page{box-sizing:border-box;min-height:100vh;padding:28rpx;background:var(--color-wash)}
.settings-intro{padding:26rpx 10rpx}.settings-title{color:var(--color-ink);font-size:38rpx;font-weight:800}.settings-copy{margin-top:10rpx;color:var(--color-muted);font-size:24rpx}
.settings-card,.privacy-card{margin-top:20rpx;border-radius:24rpx;background:#fff;box-shadow:var(--shadow-card);overflow:hidden}.settings-row,.settings-action{box-sizing:border-box;display:flex;width:100%;min-height:116rpx;align-items:center;padding:24rpx 28rpx;border:0;background:#fff;text-align:left}.settings-row{border-bottom:1rpx solid var(--color-line)}.settings-action::after{border:0}.settings-action text{margin-left:auto;color:#b04435;font-size:25rpx;font-weight:700}.row-copy{min-width:0}.row-title{color:var(--color-ink);font-size:29rpx;font-weight:700}.row-caption{margin-top:8rpx;color:var(--color-muted);font-size:23rpx}.status-pill{margin-left:auto;padding:8rpx 16rpx;border-radius:999rpx;background:#edf1ef;color:var(--color-muted);font-size:21rpx}.status-pill-active{background:var(--color-mint);color:var(--color-action)}
.privacy-card{padding:28rpx}.privacy-title{color:var(--color-action);font-weight:800}.privacy-copy{margin-top:14rpx;color:var(--color-muted);font-size:24rpx;line-height:1.7}.logout-button{margin-top:30rpx;border:2rpx solid #d88a7f;border-radius:18rpx;background:#fff;color:#a83d31;font-size:28rpx;font-weight:700}.logout-button::after{border:0}
