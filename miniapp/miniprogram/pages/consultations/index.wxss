.records-page{min-height:100vh;padding:38rpx 26rpx 70rpx;box-sizing:border-box;background:#f7faf8}.heading{color:#153f36;font-size:44rpx;font-weight:850}.cards{display:flex;flex-direction:column;gap:16rpx;margin-top:30rpx}.card{padding:26rpx;border:1rpx solid #d9e7e1;border-radius:22rpx;background:#fff}.top{display:flex;align-items:center;justify-content:space-between}.school{font-size:29rpx;font-weight:800}.status{padding:7rpx 14rpx;border-radius:999rpx;background:#e4f7ed;color:#087c50;font-size:20rpx}.course{margin-top:10rpx;color:#536f67;font-size:24rpx}.reference{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e1ebe7;color:#778b85;font-size:20rpx}.state{padding-top:100rpx}
