.records-page { min-height: 100vh; padding: 38rpx 28rpx 70rpx; padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f7faf8; color: #153f36; }
.heading { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.records-explanation { margin-top: 18rpx; color: #536f67; font-size: 25rpx; line-height: 1.75; }
.cards { display: flex; flex-direction: column; gap: 24rpx; margin-top: 32rpx; }
.card { padding: 28rpx; border: 1rpx solid #d9e7e1; border-radius: 24rpx; background: #fff; }
.card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; }
.status { display: inline-flex; align-items: center; gap: 10rpx; padding: 8rpx 14rpx; border-radius: 8rpx; font-size: 23rpx; line-height: 1.5; color: #536f67; background: #f0f4f2; }
.status-dot { font-size: 14rpx; }
.status--waiting { color: #7a572c; background: #faf3e7; }
.status--active { color: #226958; background: #edf6f2; }
.qualification { color: #536f67; font-size: 23rpx; }
.school { margin-top: 24rpx; font-size: 31rpx; line-height: 1.5; font-weight: 650; word-break: break-all; }
.course { margin-top: 8rpx; color: #536f67; font-size: 26rpx; line-height: 1.6; word-break: break-all; }
.submission { margin-top: 24rpx; padding: 22rpx 24rpx; border-left: 4rpx solid #d9e7e1; border-radius: 0 12rpx 12rpx 0; background: #f7faf8; }
.section-label { margin-bottom: 10rpx; color: #536f67; font-size: 22rpx; }
.notes { display: block; white-space: pre-wrap; word-break: break-all; font-size: 26rpx; line-height: 1.75; }
.notes--collapsed { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.expand-button { display: block; width: 100%; min-height: 88rpx; margin: 8rpx 0 -12rpx; padding: 12rpx 0; border: 0; background: transparent; color: #226958; text-align: left; font-size: 24rpx; line-height: 64rpx; }
.missing-details { margin-top: 16rpx; color: #536f67; font-size: 25rpx; line-height: 1.7; }
.card-footer { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #e1ebe7; }
.submitted-time { color: #536f67; font-size: 23rpx; line-height: 1.7; }
.timezone { font-size: 20rpx; }
.reference { margin-top: 8rpx; color: #536f67; font-family: Menlo, Consolas, monospace; font-size: 20rpx; line-height: 1.6; word-break: break-all; }
.contact-panel { padding: 12rpx 4rpx 0; }
.contact-title { font-size: 27rpx; font-weight: 600; }
.contact-hint { margin-top: 8rpx; color: #536f67; font-size: 24rpx; line-height: 1.7; }
.contact-button { display: block; width: 100%; margin-top: 20rpx; min-height: 88rpx; padding: 0 28rpx; border: 1rpx solid #c6dcd4; border-radius: 16rpx; background: #edf6f2; color: #226958; font-size: 27rpx; font-weight: 600; line-height: 88rpx; }
.expand-button:active, .contact-button:active { opacity: .7; }
.state { padding-top: 70rpx; }
