<view class="records-page">
  <view class="heading">申请意向与咨询</view>
  <view class="records-explanation">提交意向不代表已向院校递交申请。已有申请的材料与办理进度，请到“我的申请”查看。</view>
  <view wx:if="{{state === 'ready'}}" class="cards">
    <view wx:for="{{items}}" wx:key="referenceCode" class="card">
      <view class="card-top">
        <view class="status status--{{item.statusTone}}"><text class="status-dot">●</text>{{item.statusLabel}}</view>
        <text wx:if="{{item.qualificationLabel}}" class="qualification">{{item.qualificationLabel}}</text>
      </view>
      <view class="school">{{item.intendedSchool || (item.notes ? '已提交的意向与咨询' : '留学咨询')}}</view>
      <view wx:if="{{item.intendedCourse}}" class="course">{{item.intendedCourse}}</view>
      <view wx:if="{{item.notes}}" class="submission">
        <view class="section-label">提交内容</view>
        <text class="notes {{item.canExpand && !item.expanded ? 'notes--collapsed' : ''}}">{{item.notes}}</text>
        <button wx:if="{{item.canExpand}}" class="expand-button" data-reference="{{item.referenceCode}}" bindtap="toggleNotes" aria-label="{{item.expanded ? '收起提交内容' : '展开全部提交内容'}}">{{item.expanded ? '收起内容 −' : '展开全部 +'}}</button>
      </view>
      <view wx:elif="{{!item.intendedSchool && !item.intendedCourse}}" class="missing-details">这条记录暂无详细意向，可联系顾问确认。</view>
      <view class="card-footer">
        <view class="submitted-time">提交时间 · {{item.submittedLabel}}<text wx:if="{{item.submittedAt && item.submittedLabel !== '时间未记录'}}" class="timezone">（UTC+8）</text></view>
        <view class="reference">记录编号 {{item.referenceCode}}</view>
      </view>
    </view>
    <view class="contact-panel">
      <view class="contact-title">想补充或调整意向？</view>
      <view class="contact-hint">联系时可提供记录编号，方便顾问核对。</view>
      <button class="contact-button" bindtap="contactAdviser">联系顾问</button>
    </view>
  </view>
  <view wx:else class="state">
    <app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取记录" description="正在同步已提交的申请意向与咨询。"/>
    <app-state wx:elif="{{state === 'empty'}}" kind="empty" title="暂无申请意向或咨询记录" description="从收藏提交申请意向，或咨询顾问后，可在这里查看记录。"/>
    <app-state wx:else kind="failed" title="申请意向与咨询加载失败" description="请登录或稍后再试。" retryable="{{true}}" bind:retry="retry"/>
  </view>
</view>
