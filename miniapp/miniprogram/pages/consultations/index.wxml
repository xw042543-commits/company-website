<view class="records-page"><view class="heading">咨询记录</view><view wx:if="{{state === 'ready'}}" class="cards"><view wx:for="{{items}}" wx:key="referenceCode" class="card"><view class="top"><view class="school">{{item.intendedSchool || '院校待确认'}}</view><view class="status">{{item.status}}</view></view><view class="course">{{item.intendedCourse || '专业待确认'}}</view><view class="reference">编号 {{item.referenceCode}}</view></view></view><view wx:else class="state"><app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取咨询" description="正在同步已提交记录。"/><app-state wx:elif="{{state === 'empty'}}" kind="empty" title="暂无咨询记录" description="提交顾问咨询后，可在这里查看记录。"/><app-state wx:else kind="failed" title="咨询记录加载失败" description="请登录或稍后再试。" retryable="{{true}}" bind:retry="retry"/></view></view>
