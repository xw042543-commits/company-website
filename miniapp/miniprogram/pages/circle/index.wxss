.circle-page { --color-paper: #F5F7F6; --color-ink: #183C30; --color-deep: #183C30; --color-muted: #65736B; --color-action: #087C49; --color-line: #E1E7E3; min-height: 100vh; box-sizing: border-box; padding-top: 16rpx; padding-bottom: calc(184rpx + env(safe-area-inset-bottom)); background: #FFFFFF; }
.circle-header { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }.circle-title { color: var(--color-deep); font-size: 32rpx; font-weight: 700; }.header-action { min-height: 44px; margin: 0; padding: 0 16rpx; background: transparent; color: var(--color-action); font-size: 24rpx; line-height: 44px; }
.mode-tabs { display: flex; gap: 32rpx; border-bottom: 1rpx solid var(--color-line); }.mode-tab { min-height: 44px; margin: 0; padding: 0 12rpx; border-radius: 0; border-bottom: 4rpx solid transparent; background: transparent; color: var(--color-muted); font-size: 30rpx; line-height: 44px; }.mode-tab.active { border-bottom-color: var(--color-action); color: var(--color-action); font-weight: 700; }
.campus-selector { display: flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 20rpx; margin: 20rpx 0 0; padding: 22rpx; border-radius: 12rpx; background: var(--color-paper); text-align: left; line-height: 1.5; }.campus-copy { flex: 1; min-width: 0; }.campus-label { display: block; color: var(--color-muted); font-size: 22rpx; }.campus-name { display: block; margin-top: 4rpx; color: var(--color-ink); font-size: 28rpx; font-weight: 600; overflow-wrap: anywhere; word-break: break-all; }.campus-change { flex-shrink: 0; color: var(--color-action); font-size: 24rpx; }
.category-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }.category-tabs { display: inline-flex; gap: 8rpx; }.category-tab { flex-shrink: 0; min-height: 44px; margin: 0; padding: 0 22rpx; border-radius: 12rpx; background: transparent; color: var(--color-muted); font-size: 26rpx; line-height: 44px; white-space: nowrap; }.category-tab.active { background: #EFF6F2; color: var(--color-action); font-weight: 600; }
.feed-tabs { display: flex; gap: 12rpx; padding: 8rpx 0; border-bottom: 1rpx solid var(--color-line); }.feed-tab { min-width: 88rpx; min-height: 44px; margin: 0; padding: 0 16rpx; background: transparent; color: var(--color-muted); font-size: 24rpx; line-height: 44px; }.feed-tab--active { color: var(--color-ink); font-weight: 700; }
.feed-list { display: flex; flex-direction: column; }.feed-foot { padding: 28rpx 0; color: var(--color-muted); font-size: 22rpx; text-align: center; }
.post-skeleton { padding: 28rpx 0; border-bottom: 1rpx solid var(--color-line); }.skeleton-head { display: flex; align-items: center; gap: 16rpx; }.skeleton-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #E9EEEB; }.skeleton-line { height: 24rpx; margin-top: 20rpx; border-radius: 8rpx; background: #E9EEEB; }.skeleton-line--name { width: 220rpx; margin-top: 0; }.skeleton-line--short { width: 68%; }
.feed-state { padding: 72rpx 16rpx; text-align: center; }.state-title { color: var(--color-deep); font-size: 32rpx; font-weight: 600; line-height: 1.5; }.state-copy { margin-top: 16rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.7; }.state-action { min-height: 44px; margin: 28rpx auto 0; padding: 0 32rpx; border-radius: 12rpx; background: var(--color-action); color: #fff; font-size: 28rpx; line-height: 44px; }
.compose-button { position: fixed; right: 28rpx; bottom: calc(28rpx + env(safe-area-inset-bottom)); z-index: 3; display: flex; min-width: 176rpx; min-height: 44px; align-items: center; justify-content: center; gap: 12rpx; margin: 0; padding: 0 28rpx; border-radius: 48rpx; background: var(--color-action); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 44px; }.compose-symbol { position: relative; width: 28rpx; height: 28rpx; }.compose-symbol::before, .compose-symbol::after { position: absolute; left: 13rpx; top: 2rpx; width: 3rpx; height: 24rpx; border-radius: 2rpx; background: currentColor; content: ""; }.compose-symbol::after { transform: rotate(90deg); }
.school-overlay { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(12, 32, 27, .4); }.school-dialog { box-sizing: border-box; width: 100%; max-height: 85vh; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 20rpx 20rpx 0 0; background: #fff; }.school-search { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0; }.school-search input { flex: 1; min-width: 0; min-height: 44px; padding: 0 16rpx; border: 1rpx solid var(--color-line); border-radius: 8rpx; font-size: 28rpx; }.school-dialog button { min-height: 44px; margin: 0; padding: 12rpx 20rpx; color: var(--color-action); font-size: 26rpx; line-height: 1.5; }.school-results { height: 35vh; }.school-dialog .school-option { width: 100%; border-bottom: 1rpx solid var(--color-line); border-radius: 0; background: #fff; text-align: left; color: var(--color-ink); overflow-wrap: anywhere; word-break: break-all; }.school-message { padding: 30rpx 0; color: var(--color-muted); font-size: 26rpx; line-height: 1.6; }.school-pagination { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-top: 16rpx; font-size: 22rpx; color: var(--color-muted); }.school-dialog .school-cancel { margin-top: 20rpx; width: 100%; background: var(--color-paper); color: var(--color-ink); }
@media (min-width: 600px) { .circle-page { max-width: 720px; margin: 0 auto; padding-right: 32px; padding-left: 32px; }.school-dialog { max-width: 720px; margin: 0 auto; } }
