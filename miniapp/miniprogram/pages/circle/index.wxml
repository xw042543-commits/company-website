<view class="page-shell circle-page">
  <view class="circle-mark">U</view>
  <block wx:if="{{session.status === 'authenticated'}}">
    <view class="page-title centered">U圈正在建设</view>
    <view class="page-copy centered">社区内容上线前将完成内容审核、举报和隐私保护能力。</view>
    <view class="surface-card promise-card">
      <view class="promise-title">面向 2000+ 学生稳定使用</view>
      <view class="promise-copy">帖子、评论和互动不会使用演示数据冒充真实内容。</view>
    </view>
  </block>
  <block wx:else>
    <view class="page-title centered">登录后进入 U圈</view>
    <view class="page-copy centered">使用微信身份保护你的社区账号与互动记录。</view>
    <button class="primary-button login-button" bindtap="enterCircle">微信快捷登录</button>
  </block>
</view>
