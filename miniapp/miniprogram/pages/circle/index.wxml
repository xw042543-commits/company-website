<view class="page-shell circle-page">
  <view class="channel-switch" role="tablist" aria-label="社区范围">
    <button class="mode-tab {{mode === 'plaza' ? 'active' : ''}}" aria-selected="{{mode === 'plaza'}}" data-mode="plaza" bindtap="switchMode"><text>广场</text></button>
    <button class="mode-tab {{mode === 'campus' ? 'active' : ''}}" aria-selected="{{mode === 'campus'}}" data-mode="campus" bindtap="switchMode"><text>校园圈</text></button>
    <button class="header-action" bindtap="openMine">我的内容<text class="header-arrow" aria-hidden="true">›</text></button>
  </view>
  <button wx:if="{{mode === 'campus'}}" class="campus-selector" bindtap="openSchools" aria-label="选择校园"><view class="campus-pin" aria-hidden="true"><view class="campus-pin-dot"></view></view><view class="campus-copy"><text class="campus-label">正在浏览</text><text class="campus-name">{{universityName || '选择你的校园'}}</text></view><text class="campus-change">{{universityName ? '切换' : '选择'}} →</text></button>
  <scroll-view scroll-x="{{true}}" class="category-scroll" aria-label="生活分类"><view class="category-tabs"><button wx:for="{{boards}}" wx:key="code" class="category-tab {{category === item.code ? 'active' : ''}}" aria-pressed="{{category === item.code}}" data-category="{{item.code}}" bindtap="switchCategory">{{item.label}}</button></view></scroll-view>
  <view class="feed-heading">
    <view class="feed-tabs" role="tablist" aria-label="帖子排序"><button class="feed-tab {{sort === 'latest' ? 'feed-tab--active' : ''}}" data-sort="latest" bindtap="switchSort">最新</button><button class="feed-tab {{sort === 'hot' ? 'feed-tab--active' : ''}}" data-sort="hot" bindtap="switchSort">热门</button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="feed-list" aria-label="正在加载帖子">
    <view wx:for="{{skeletonRows}}" wx:key="*this" class="post-skeleton"><view class="skeleton-track"></view><view class="skeleton-head"><view class="skeleton-avatar"></view><view class="skeleton-line skeleton-line--name"></view></view><view class="skeleton-body"><view class="skeleton-line"></view><view class="skeleton-line skeleton-line--short"></view></view></view>
  </view>
  <view wx:elif="{{state === 'ready'}}" class="feed-list">
    <community-post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" images="{{postImages[item.id] || []}}" reacting="{{reactingId === item.id}}" bind:open="openPost" bind:react="toggleLike" bind:report="reportPost" />
    <view wx:if="{{loadingMore}}" class="feed-foot">正在加载更多内容…</view><view wx:elif="{{!nextCursor}}" class="feed-foot">已显示全部内容</view>
  </view>
  <view wx:elif="{{state === 'select-school'}}" class="editorial-state editorial-state--select"><view class="state-watermark" aria-hidden="true">校</view><view class="state-index">CAMPUS / 01</view><view class="state-title">选一所学校，进入校园现场</view><view class="state-copy">看看同校学生正在讨论什么，也可以分享你的校园日常。</view><button class="state-link" bindtap="openSchools">选择校园 <text aria-hidden="true">→</text></button></view>
  <view wx:elif="{{state === 'empty'}}" class="editorial-state editorial-state--empty"><view class="state-watermark" aria-hidden="true">U</view><view class="state-index">NEW PAGE / 00</view><view class="state-title">这一页，等你写下第一句</view><view class="state-copy">提问、找同学，或记录一段校园日常。</view><button class="state-link" bindtap="openCompose">发布第一篇 <text aria-hidden="true">→</text></button></view>
  <view wx:elif="{{state === 'offline'}}" class="editorial-state editorial-state--offline"><view class="state-watermark" aria-hidden="true">…</view><view class="state-index">SIGNAL / LOST</view><view class="state-title">校园信号走丢了</view><view class="state-copy">检查网络后再试，内容会在连接恢复后回来。</view><button class="state-retry" bindtap="retry">重新连接 <text aria-hidden="true">→</text></button></view>
  <view wx:elif="{{state === 'failed'}}" class="editorial-state editorial-state--failed"><view class="state-watermark" aria-hidden="true">U</view><view class="state-index">FEED / PAUSED</view><view class="state-title">这一期暂时无法打开</view><view class="state-copy">服务没有返回有效内容，请稍后重新加载。</view><button class="state-retry" bindtap="retry">重新加载 <text aria-hidden="true">→</text></button></view>
  <button wx:if="{{!schoolOpen}}" class="compose-button" bindtap="openCompose" aria-label="发布U圈帖子"><view class="compose-symbol" aria-hidden="true"><view class="compose-pencil"></view></view></button>
  <view wx:if="{{schoolOpen}}" class="school-overlay" bindtap="cancelSchools"><view class="school-dialog" role="dialog" aria-label="选择校园" catchtap="noop">
    <view class="state-title">选择校园</view>
    <view class="school-search"><input value="{{schoolQuery}}" placeholder="搜索院校名称" aria-label="搜索院校名称" bindinput="updateSchoolQuery" confirm-type="search" bindconfirm="searchSchools" /><button bindtap="searchSchools">搜索</button></view>
    <scroll-view scroll-y="{{true}}" class="school-results"><button wx:for="{{schools}}" wx:key="id" class="school-option" data-id="{{item.id}}" bindtap="selectSchool">{{item.name}}</button><view wx:if="{{schoolState === 'loading'}}" class="school-message">正在加载院校…</view><view wx:elif="{{schoolState === 'empty'}}" class="school-message">没有找到院校，请换个名称搜索。</view><view wx:elif="{{schoolState === 'failed'}}" class="school-message">院校加载失败，请重试。<button bindtap="retrySchools">重新加载</button></view></scroll-view>
    <view wx:if="{{schoolTotalPages > 0}}" class="school-pagination"><button disabled="{{schoolPage <= 1 || schoolState === 'loading'}}" bindtap="previousSchools">上一页</button><text>{{schoolPage}} / {{schoolTotalPages}}</text><button disabled="{{schoolPage >= schoolTotalPages || schoolState === 'loading'}}" bindtap="nextSchools">下一页</button></view><button class="school-cancel" bindtap="cancelSchools">取消</button>
  </view></view>
</view>
