.programme-page { min-height:100vh; box-sizing:border-box; padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); background:#fdfdfb; color:#202923; }
.custom-header { box-sizing:border-box; background:#f5d66f; padding-top:env(safe-area-inset-top); }
.navigation-row { display:flex; box-sizing:border-box; align-items:center; padding-left:12px; }
.back-button { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:44px; min-height:44px; margin:0; padding:0; border-radius:0; background:transparent; color:#202923; font-size:64rpx; line-height:1; }
.navigation-title { min-width:0; margin-left:8rpx; font-size:30rpx; font-weight:700; line-height:1.4; }
.programme-document { padding:0 28rpx 16rpx; }
.identity-row { display:flex; align-items:flex-start; padding:32rpx 0; border-bottom:1rpx solid #e5e8e2; }
.university-logo { display:flex; box-sizing:border-box; flex-shrink:0; align-items:center; justify-content:center; width:100rpx; height:100rpx; border:1rpx solid #dce1dc; border-radius:12rpx; background:#f6f7f5; color:#404a43; font-size:44rpx; font-weight:700; }
.university-logo-image { width:84rpx; height:84rpx; }
.identity-copy { flex:1; min-width:0; margin-left:22rpx; }
.programme-title { font-size:36rpx; font-weight:700; line-height:1.35; overflow-wrap:break-word; word-break:break-word; }
.programme-title-en { margin-top:8rpx; color:#626c65; font-size:24rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.university-name { margin-top:12rpx; color:#49544d; font-size:25rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.document-section { padding-top:32rpx; }
.section-title { margin-bottom:20rpx; padding-bottom:12rpx; border-bottom:4rpx solid #f5d66f; font-size:30rpx; font-weight:700; line-height:1.4; overflow-wrap:break-word; word-break:break-word; }
.section-body { max-width:70ch; color:#49544d; font-size:27rpx; line-height:1.75; white-space:pre-wrap; overflow-wrap:break-word; word-break:break-word; }
.facts-table { overflow:hidden; border:1rpx solid #dce1dc; border-radius:6rpx; }
.fact-row { display:flex; align-items:stretch; background:#fdfdfb; }
.fact-row:nth-child(even) { background:#f4f5f1; }
.fact-label,.fact-value { box-sizing:border-box; padding:18rpx 20rpx; font-size:26rpx; line-height:1.6; overflow-wrap:break-word; word-break:break-word; }
.fact-label { flex-shrink:0; width:30%; border-right:1rpx solid #dce1dc; color:#49544d; font-weight:600; }
.fact-value { flex:1; min-width:0; color:#202923; }
.locked-section { position:relative; display:flex; min-height:256rpx; align-items:center; justify-content:center; overflow:hidden; }
.locked-preview { position:absolute; inset:18rpx 0; padding:8rpx 16rpx; filter:blur(5rpx); opacity:.4; pointer-events:none; }
.preview-line { height:16rpx; margin:0 0 24rpx; border-radius:4rpx; background:#aab2a9; }
.preview-line--short { width:68%; }
.preview-line--medium { width:84%; }
.lock-panel { position:relative; display:flex; box-sizing:border-box; flex-direction:column; align-items:center; width:100%; max-width:560rpx; margin:20rpx; padding:24rpx 20rpx; border-radius:12rpx; background:#f9e8a6; color:#202923; text-align:center; }
.lock-mark { margin-bottom:8rpx; font-size:28rpx; line-height:1.4; }
.lock-copy { font-size:27rpx; font-weight:700; line-height:1.5; }
.lock-note { margin-top:8rpx; color:#4c4b39; font-size:23rpx; line-height:1.6; overflow-wrap:break-word; word-break:break-word; }
.actions { position:fixed; z-index:5; right:0; bottom:0; left:0; display:flex; box-sizing:border-box; gap:16rpx; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #dce1dc; background:#fdfdfb; }
.primary,.secondary { display:flex; box-sizing:border-box; min-width:0; min-height:104rpx; margin:0; padding:18rpx 12rpx; align-items:center; justify-content:center; border-radius:12rpx; font-size:27rpx; font-weight:700; line-height:1.5; }
.primary { flex:1.4; background:#f5d66f; color:#202923; }
.secondary { flex:1; background:#f6f7f5; color:#49544d; }
.secondary--active { background:#f9e8a6; color:#202923; }
.secondary[disabled] { background:#f6f7f5; color:#626c65; }
.state-wrap { padding:80rpx 28rpx 40rpx; }
.control--pressed { opacity:.75; }
