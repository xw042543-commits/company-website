.programme-page{min-height:100vh;background:#f8fbf9;color:#173f36}.hero{position:relative;min-height:480rpx;overflow:hidden;background:linear-gradient(145deg,#0e7f52,#123d68)}.hero-image{position:absolute;width:100%;height:100%;opacity:.48}.hero-wash{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,32,26,.12),rgba(8,36,31,.82))}.circle-button{position:absolute;z-index:2;top:calc(22rpx + env(safe-area-inset-top));width:76rpx;height:76rpx;padding:0;border-radius:50%;background:rgba(255,255,255,.94);color:#173f36;font-size:44rpx;line-height:76rpx}.back{left:24rpx}.hero-copy{position:absolute;right:34rpx;bottom:46rpx;left:34rpx;color:#fff}.eyebrow{font-size:23rpx;font-weight:700;opacity:.88}.title{margin-top:14rpx;font-size:44rpx;font-weight:850;line-height:1.25}.title-en{margin-top:8rpx;font-size:24rpx;line-height:1.45;opacity:.83}.location{margin-top:18rpx;font-size:22rpx;opacity:.86}.facts{display:grid;grid-template-columns:repeat(2,1fr);gap:1rpx;margin:24rpx;border:1rpx solid #dce9e4;border-radius:24rpx;background:#dce9e4;overflow:hidden}.fact{display:flex;min-height:112rpx;box-sizing:border-box;padding:20rpx 22rpx;flex-direction:column;background:#fff}.fact text{color:#6b817a;font-size:20rpx}.fact-value{margin-top:9rpx;color:#153f36;font-size:25rpx;font-weight:700}.fact--wide{grid-column:auto}.tabs{position:sticky;z-index:4;top:0;box-sizing:border-box;width:100%;padding:4rpx 24rpx;background:rgba(248,251,249,.96);box-shadow:0 8rpx 20rpx rgba(23,61,91,.05)}.tab-row{display:flex;gap:34rpx;width:max-content;border-bottom:1rpx solid #dce9e4}.tab{padding:24rpx 4rpx 20rpx;color:#6a8179;font-size:24rpx;font-weight:700;white-space:nowrap}.tab--active{border-bottom:5rpx solid #0a9a59;color:#08764b}.content{padding:26rpx 28rpx 16rpx}.content-section{padding:10rpx 0 34rpx}.content-kicker{color:#0a8d55;font-size:22rpx;font-weight:800}.content-body{margin-top:16rpx;color:#405d55;font-size:27rpx;line-height:1.9;white-space:pre-wrap}.action-space{height:140rpx}.actions{position:fixed;z-index:5;right:0;bottom:0;left:0;display:flex;gap:14rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dce9e4;background:rgba(255,255,255,.96)}.primary,.secondary{min-height:82rpx;margin:0;border-radius:20rpx;font-size:26rpx;font-weight:750;line-height:82rpx}.primary{flex:1.5;background:#078e54;color:#fff}.secondary{flex:1;border:1rpx solid #9ec9b9;background:#fff;color:#167052}.secondary--active{background:#e5f7ef;color:#078e54}.state-wrap{padding:calc(140rpx + env(safe-area-inset-top)) 28rpx 40rpx}
