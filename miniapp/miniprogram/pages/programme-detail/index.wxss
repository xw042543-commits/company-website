.programme-page { min-height:100vh; box-sizing:border-box; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); background:var(--color-paper); color:var(--color-navy); }
.custom-header { position:absolute; z-index:4; top:0; right:0; left:0; box-sizing:border-box; background:linear-gradient(180deg,rgba(8,40,50,.5),transparent); color:#fff; padding-top:env(safe-area-inset-top); }
.navigation-row { display:flex; box-sizing:border-box; align-items:center; padding-left:12px; }
.back-button { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:76rpx; height:76rpx; min-height:76rpx; margin:0; padding:0; border-radius:50%; background:rgba(255,255,255,.9); color:var(--color-navy); font-size:58rpx; line-height:1; box-shadow:0 8rpx 24rpx rgba(0,0,0,.12); }
.navigation-title { min-width:0; margin-left:16rpx; font-size:29rpx; font-weight:700; line-height:1.4; text-shadow:0 2rpx 8rpx rgba(0,0,0,.4); }
.programme-document { padding:0 28rpx 24rpx; }
.programme-cover { height:430rpx; margin:0 -28rpx; overflow:hidden; background:var(--color-wash); }
.programme-cover-image { width:100%; height:100%; }
.programme-cover-fallback { display:flex; width:100%; height:100%; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; color:var(--color-muted); font-size:24rpx; }
.programme-cover-brand { color:var(--color-navy); font-size:42rpx; font-weight:700; letter-spacing:4rpx; }
.identity-row { display:flex; align-items:flex-start; padding:0 0 30rpx; border-bottom:1rpx solid var(--color-line); }
.university-logo { display:flex; box-sizing:border-box; flex-shrink:0; align-items:center; justify-content:center; width:106rpx; height:106rpx; margin-top:-34rpx; border:1rpx solid var(--color-line); border-radius:16rpx; background:var(--color-paper); color:var(--color-navy); font-size:42rpx; font-weight:700; box-shadow:0 10rpx 24rpx rgba(18,55,69,.12); }
.university-logo-image { width:88rpx; height:88rpx; }
.identity-copy { flex:1; min-width:0; margin-left:22rpx; }
.programme-title { margin-top:24rpx; font-size:38rpx; font-weight:700; line-height:1.35; overflow-wrap:break-word; word-break:break-word; }
.programme-title-en { margin-top:8rpx; color:var(--color-muted); font-size:24rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.university-name { margin-top:12rpx; color:var(--color-action); font-size:25rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.headline-facts { display:flex; flex-wrap:wrap; gap:16rpx 24rpx; padding:24rpx 0; }
.headline-fact { display:flex; min-width:calc(50% - 12rpx); flex-direction:column; }
.headline-fact text { color:var(--color-muted); font-size:22rpx; line-height:1.4; }
.headline-fact-value { margin-top:5rpx; color:var(--color-navy); font-size:25rpx; font-weight:700; line-height:1.45; overflow-wrap:break-word; word-break:break-word; }
.section-directory { margin:28rpx 0 4rpx; padding:28rpx 28rpx 24rpx; border:1rpx solid var(--color-line); border-radius:18rpx; background:var(--color-paper); box-shadow:0 12rpx 32rpx rgba(18,55,69,.06); }
.directory-heading { margin-bottom:20rpx; color:var(--color-action); font-size:24rpx; font-weight:700; letter-spacing:2rpx; }
.directory-list { position:relative; }
.directory-list::before { position:absolute; top:24rpx; bottom:24rpx; left:9rpx; width:2rpx; background:var(--color-line); content:""; }
.directory-item { position:relative; display:flex; width:100%; min-height:72rpx; align-items:center; margin:0; padding:10rpx 0; border-radius:0; background:transparent; color:var(--color-navy); font-size:28rpx; font-weight:700; line-height:1.45; text-align:left; }
.directory-dot { position:relative; z-index:1; box-sizing:border-box; flex-shrink:0; width:20rpx; height:20rpx; margin-right:22rpx; border:5rpx solid var(--color-paper); border-radius:50%; background:var(--color-brand); box-shadow:0 0 0 2rpx var(--color-brand); }
.directory-label { flex:1; min-width:0; }
.directory-item--pressed { color:var(--color-action); opacity:.72; }
.document-section { padding:52rpx 0 10rpx; scroll-margin-top:32rpx; }
.document-section + .document-section { margin-top:22rpx; border-top:1rpx solid var(--color-line); }
.section-title { display:inline-block; margin-bottom:26rpx; padding-bottom:12rpx; border-bottom:4rpx solid var(--color-brand); font-size:38rpx; font-weight:700; line-height:1.35; overflow-wrap:break-word; word-break:break-word; }
.section-body { max-width:70ch; color:var(--color-ink); font-size:28rpx; line-height:1.9; white-space:pre-wrap; overflow-wrap:break-word; word-break:break-word; }
.section-body--pending { box-sizing:border-box; padding:24rpx; border-left:6rpx solid var(--color-brand); border-radius:0 12rpx 12rpx 0; background:var(--color-wash); color:var(--color-muted); }
.facts-table { overflow:hidden; border:1rpx solid var(--color-line); border-radius:18rpx; background:var(--color-paper); box-shadow:0 14rpx 36rpx rgba(18,55,69,.06); }
.fact-row { display:flex; align-items:stretch; border-bottom:1rpx solid var(--color-line); background:var(--color-paper); }
.fact-row:last-child { border-bottom:0; }
.fact-row:nth-child(even) { background:var(--color-paper); }
.fact-label,.fact-value { box-sizing:border-box; padding:24rpx 22rpx; font-size:27rpx; line-height:1.55; overflow-wrap:break-word; word-break:break-word; }
.fact-label { display:flex; flex-shrink:0; width:36%; align-items:center; background:var(--color-wash); color:var(--color-navy); font-weight:700; }
.fact-value { flex:1; min-width:0; color:var(--color-ink); font-weight:600; }
.actions { display:flex; box-sizing:border-box; gap:16rpx; padding:4rpx 0 24rpx; background:var(--color-paper); }
.primary,.secondary { display:flex; box-sizing:border-box; min-width:0; min-height:104rpx; margin:0; padding:18rpx 12rpx; align-items:center; justify-content:center; border-radius:12rpx; font-size:27rpx; font-weight:700; line-height:1.5; }
.primary { flex:1.4; background:var(--color-action); color:var(--color-paper); }
.secondary { flex:1; background:var(--color-wash); color:var(--color-navy); }
.secondary--active { background:var(--color-mint); color:var(--color-action); }
.secondary[disabled] { background:var(--color-wash); color:var(--color-muted); }
.state-wrap { padding:80rpx 28rpx 40rpx; }
.control--pressed { opacity:.75; }

/* Editorial detail layout: photography, quiet rows and compact navigation. */
.programme-page { background:#fff; color:#20352f; }
.programme-document { padding-right:32rpx; padding-left:32rpx; }
.programme-cover { height:420rpx; margin-right:-32rpx; margin-left:-32rpx; }
.identity-row { position:relative; display:block; padding:30rpx 0 0; border:0; }
.university-logo { display:none; }
.identity-copy { margin:0; }
.university-name { margin:0 0 12rpx; color:var(--color-action); font-size:24rpx; font-weight:600; }
.programme-title { margin:0; color:#20352f; font-size:40rpx; line-height:1.45; }
.programme-title-en { margin-top:12rpx; font-size:25rpx; line-height:1.6; }
.headline-facts { gap:16rpx 28rpx; padding:26rpx 0; }
.headline-fact { min-width:0; flex-direction:row; gap:10rpx; align-items:baseline; }
.headline-fact text { font-size:23rpx; }
.headline-fact .headline-fact-value { margin:0; color:#20352f; font-size:24rpx; font-weight:500; }
.actions { padding:6rpx 0 30rpx; background:#fff; }
.primary,.secondary { min-height:88rpx; border-radius:12rpx; font-size:26rpx; }
.secondary { border:1rpx solid #dce5e0; background:#fff; color:var(--color-action); }
.section-directory { margin:0 -32rpx; padding:0; border:0; border-top:1rpx solid #edf1ee; border-bottom:1rpx solid #edf1ee; border-radius:0; background:#fff; box-shadow:none; }
.directory-list { width:100%; white-space:nowrap; }
.directory-list::before { display:none; }
.directory-item { display:inline-flex; width:auto; min-height:88rpx; padding:0 24rpx; color:#536a63; font-size:25rpx; font-weight:500; vertical-align:middle; }
.directory-item:first-child { color:var(--color-action); }
.directory-label { flex:none; }
.document-section { padding:40rpx 0 12rpx; }
.document-section + .document-section { margin-top:28rpx; border-top:1rpx solid #edf1ee; }
.section-title { display:flex; align-items:baseline; gap:20rpx; margin-bottom:24rpx; padding:0; border:0; font-size:32rpx; color:#20352f; }
.section-number { color:var(--color-action); font-size:28rpx; font-weight:600; }
.section-body { font-size:27rpx; line-height:1.95; color:#53635e; }
.section-body--pending { padding:22rpx 24rpx; border:0; border-radius:12rpx; background:#f5f8f6; font-size:25rpx; }
.facts-table { border:0; border-top:1rpx solid #edf1ee; border-radius:0; background:#fff; box-shadow:none; }
.fact-row,.fact-row:nth-child(even) { background:#fff; border-color:#edf1ee; }
.fact-label,.fact-value { padding:22rpx 4rpx; font-size:26rpx; font-weight:400; }
.fact-label { width:32%; background:transparent; color:#7b8782; }
.fact-value { color:#20352f; }

/* Programme content: calm green cards and a vertical bilingual study-area list. */
.document-section--INTRODUCTION,.document-section--CAREER_PROSPECTS,.document-section--CURRICULUM { padding-top:48rpx; }
.section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20rpx; }
.section-meta { flex-shrink:0; color:#819088; font-size:22rpx; }
.section-body--INTRODUCTION { box-sizing:border-box; max-width:none; padding:30rpx 30rpx 32rpx; border:1rpx solid #e1ece6; border-radius:20rpx; background:linear-gradient(145deg,#f7fbf8 0%,#fff 72%); color:#3f5750; font-size:28rpx; line-height:2; box-shadow:0 14rpx 34rpx rgba(22,91,63,.06); }
.career-grid { display:grid; grid-template-columns:1fr; gap:16rpx; }
.career-card { box-sizing:border-box; padding:26rpx 28rpx; border:1rpx solid #e2ece7; border-radius:18rpx; background:#fbfdfc; }
.career-card:first-child { border-color:#cfe5d9; background:#f2f9f5; }
.career-label { margin-bottom:10rpx; color:#087a4e; font-size:23rpx; font-weight:700; letter-spacing:1rpx; }
.career-copy { color:#405850; font-size:27rpx; line-height:1.82; overflow-wrap:break-word; word-break:break-word; }
.curriculum-card { overflow:hidden; border:1rpx solid #dce9e2; border-radius:20rpx; background:#fff; box-shadow:0 16rpx 38rpx rgba(22,91,63,.07); }
.curriculum-notice { display:flex; align-items:center; padding:22rpx 26rpx; background:#eef8f3; color:#246a4d; font-size:24rpx; font-weight:600; line-height:1.55; }
.notice-mark { display:flex; width:34rpx; height:34rpx; flex-shrink:0; align-items:center; justify-content:center; margin-right:14rpx; border-radius:50%; background:#0b8755; color:#fff; font-size:21rpx; font-weight:700; }
.curriculum-list { padding:0 26rpx; }
.curriculum-row { display:flex; min-height:116rpx; align-items:center; border-bottom:1rpx solid #e8efeb; }
.curriculum-row:last-child { border-bottom:0; }
.curriculum-number { width:68rpx; flex-shrink:0; color:#0a8754; font-size:25rpx; font-weight:700; font-variant-numeric:tabular-nums; }
.curriculum-copy { min-width:0; flex:1; padding:20rpx 0; }
.curriculum-name-zh { color:#203d32; font-size:28rpx; font-weight:650; line-height:1.48; overflow-wrap:break-word; word-break:break-word; }
.curriculum-name-en { margin-top:7rpx; color:#7b8983; font-size:22rpx; line-height:1.5; overflow-wrap:break-word; word-break:break-word; }
.curriculum-name-en--primary { margin-top:0; color:#203d32; font-size:27rpx; font-weight:650; }
.curriculum-footnote { padding:22rpx 26rpx 24rpx; border-top:1rpx solid #e8efeb; background:#fafcfb; color:#7a8882; font-size:22rpx; line-height:1.65; }
.section-provenance { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-top:18rpx; padding:20rpx 22rpx; border:1rpx solid #dce9e2; border-radius:16rpx; background:#eef8f3; color:#246a4d; }
.provenance-copy { display:flex; min-width:0; flex:1; align-items:flex-start; gap:12rpx; font-size:22rpx; line-height:1.55; }
.source-button { flex-shrink:0; min-height:58rpx; margin:0; padding:0 20rpx; border:1rpx solid #aad5c0; border-radius:999rpx; background:#fff; color:#087f51; font-size:21rpx; font-weight:700; line-height:56rpx; }

@media (min-width:600px) {
  .career-grid { grid-template-columns:1fr 1fr; }
  .curriculum-row { min-height:106rpx; }
}

.curriculum-module-meta { margin-top:10rpx; color:#7a8882; font-size:22rpx; line-height:1.6; overflow-wrap:break-word; }
.curriculum-copy .source-button { max-width:100%; margin-top:12rpx; white-space:normal; }
