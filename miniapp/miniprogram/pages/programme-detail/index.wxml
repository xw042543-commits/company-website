<view class="programme-page">
  <view class="custom-header" style="padding-top:{{statusBarHeight}}px;">
    <view class="navigation-row" style="min-height:{{navigationHeight}}px; padding-right:{{navigationRight}}px;">
      <button class="back-button" bindtap="back" aria-label="返回" hover-class="control--pressed">‹</button>
      <text class="navigation-title">专业详情</text>
    </view>
  </view>

  <view wx:if="{{state === 'ready'}}" class="programme-document">
    <view class="programme-cover">
      <image wx:if="{{programme.imageUrl && !coverFailed}}" class="programme-cover-image" src="{{programme.imageUrl}}" mode="aspectFill" fade-show binderror="coverError" aria-label="{{programme.nameZh}}专业图片" />
      <view wx:else class="programme-cover-fallback"><text class="programme-cover-brand">洋豆角</text><text>专业图片暂未提供</text></view>
    </view>
    <view class="identity-row">
      <view class="university-logo">
        <image wx:if="{{universityLogoUrl && !imageFailed}}" class="university-logo-image" src="{{universityLogoUrl}}" mode="aspectFit" binderror="imageError" aria-label="{{programme.universityNameZh}}校徽" />
        <text wx:else aria-hidden="true">{{logoLetter}}</text>
      </view>
      <view class="identity-copy">
        <view class="university-name">{{programme.universityNameZh}}</view>
        <view class="programme-title" aria-role="heading" aria-level="1">{{programme.nameZh}}</view>
        <view class="programme-title-en">{{programme.nameEn}}</view>
      </view>
    </view>

    <view class="headline-facts" aria-label="专业摘要">
      <view wx:for="{{headlineFacts}}" wx:key="label" class="headline-fact"><text>{{item.label}}</text><text class="headline-fact-value">{{item.value}}</text></view>
    </view>

    <view class="actions">
      <button class="primary" bindtap="consult" hover-class="control--pressed">咨询顾问</button>
      <button class="secondary {{favorite ? 'secondary--active' : ''}}" loading="{{saving}}" disabled="{{saving}}" bindtap="toggleFavorite" aria-label="{{favorite ? '取消收藏专业' : '收藏专业'}}" hover-class="control--pressed">{{favorite ? '♥ 已收藏' : '♡ 收藏'}}</button>
    </view>

    <view class="section-directory" aria-role="navigation" aria-label="专业详情目录">
      <scroll-view class="directory-list" scroll-x enhanced show-scrollbar="{{false}}">
        <button wx:for="{{documentSections}}" wx:key="key" class="directory-item" data-target="section-{{item.key}}" bindtap="scrollToSection" hover-class="directory-item--pressed">
          <text class="directory-label">{{item.title}}</text>
        </button>
      </scroll-view>
    </view>

    <view wx:for="{{documentSections}}" wx:key="key" wx:for-item="section" id="section-{{section.key}}" class="document-section document-section--{{section.key}}">
      <view class="section-heading"><view class="section-title" aria-role="heading" aria-level="2"><text class="section-number">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text>{{section.title}}</view><text wx:if="{{section.key === 'CURRICULUM' && curriculumCount}}" class="section-meta">{{curriculumCount}} 门官网课程</text></view>
      <view wx:if="{{section.key === 'BASIC_INFORMATION'}}" class="facts-table" aria-role="table" aria-label="专业基本信息">
        <view wx:for="{{basicFacts}}" wx:key="label" aria-role="row" class="fact-row">
          <view class="fact-label" aria-role="rowheader">{{item.label}}</view>
          <view class="fact-value" aria-role="cell">{{item.value}}</view>
        </view>
      </view>
      <view wx:elif="{{section.key === 'CURRICULUM' && section.curriculumItems.length}}" class="curriculum-card">
        <view class="curriculum-list" aria-label="学校官网课程">
          <view wx:for="{{section.curriculumItems}}" wx:key="number" class="curriculum-row">
            <text class="curriculum-number">{{item.number}}</text>
            <view class="curriculum-copy">
              <view class="curriculum-name-zh">{{item.nameZh}}</view>
              <view wx:if="{{item.descriptionZh}}" class="curriculum-footnote">{{item.descriptionZh}}</view>
              <view wx:if="{{item.courseCode || item.credits || item.requirement}}" class="curriculum-footnote">{{item.courseCode}}{{item.credits ? ' · 学分：' + item.credits : ''}}{{item.requirement ? ' · ' + item.requirement : ''}}</view>
              <view class="curriculum-footnote">采集于 {{item.sourceCheckedLabel}} · {{item.curriculumVersion || '官网未注明适用版本'}}</view>
              <button class="source-button" data-name-en="{{item.nameEn}}" data-course-code="{{item.courseCode}}" data-source-url="{{item.sourceUrl}}" bindtap="copyCourseEvidence">复制原名、代码与官网来源</button>
            </view>
          </view>
        </view>
        <view class="curriculum-footnote">课程名称为平台中文译名；未核实的介绍、代码、学分等不补写。学校原文和官网来源可复制核验。</view>
      </view>
      <view wx:elif="{{section.key === 'CAREER_PROSPECTS' && section.contentBlocks.length}}" class="career-grid">
        <view wx:for="{{section.contentBlocks}}" wx:key="label" class="career-card">
          <view class="career-label">{{item.label}}</view><view class="career-copy">{{item.text}}</view>
        </view>
      </view>
      <view wx:else class="section-body section-body--{{section.key}} {{section.available ? '' : 'section-body--pending'}}">{{section.body}}</view>
      <view wx:if="{{section.notice}}" class="section-provenance">
        <view class="provenance-copy"><text class="notice-mark">i</text><text>{{section.notice}}{{section.sourceCheckedLabel ? ' · 采集于 ' + section.sourceCheckedLabel : ''}}</text></view>
        <button wx:if="{{section.sourceUrl}}" class="source-button" data-source-url="{{section.sourceUrl}}" bindtap="copySourceUrl" hover-class="control--pressed">复制官网链接</button>
      </view>
    </view>

  </view>
  <view wx:else class="state-wrap">
    <app-state wx:if="{{state === 'loading'}}" kind="loading" title="正在读取专业资料" description="学费、学制与录取要求正在加载。" />
    <app-state wx:elif="{{state === 'offline'}}" kind="offline" title="网络暂时不可用" description="请检查网络后重新加载。" retryable="{{true}}" bind:retry="retry" />
    <app-state wx:else kind="failed" title="专业资料加载失败" description="服务暂时无法返回有效资料。" retryable="{{true}}" bind:retry="retry" />
  </view>
</view>
