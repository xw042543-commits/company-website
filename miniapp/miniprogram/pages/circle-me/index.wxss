.personal-page { background: var(--color-paper); }.personal-title { color: var(--color-deep); font-size: 44rpx; font-weight: 800; }.personal-copy { margin-top: 12rpx; color: var(--color-muted); font-size: 25rpx; line-height: 1.65; }.personal-tabs { display: flex; gap: 12rpx; margin: 28rpx 0 22rpx; padding: 8rpx; border-radius: 20rpx; background: #e9f1ed; }.personal-tab { min-height: 88rpx; flex: 1; margin: 0; border-radius: 16rpx; background: transparent; color: var(--color-muted); font-size: 26rpx; line-height: 88rpx; }.personal-tab.active { background: #fff; color: var(--color-action); font-weight: 750; box-shadow: 0 8rpx 20rpx rgba(21, 63, 54, .08); }.personal-list { display: flex; flex-direction: column; gap: 18rpx; }.personal-card { padding: 26rpx; }.card-head, .item-foot { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.status { padding: 10rpx 16rpx; border-radius: 999rpx; background: #eef2f0; color: var(--color-muted); font-size: 22rpx; font-weight: 700; }.status--PUBLISHED { background: #e5f5ee; color: var(--color-action); }.status--PENDING_REVIEW { background: #fff3dc; color: #9a5700; }.status--HIDDEN, .status--REJECTED, .status--DELETED { background: #f5eaea; color: var(--color-danger); }.item-time { color: var(--color-muted); font-size: 22rpx; }.item-body { padding: 22rpx 0; color: var(--color-ink); font-size: 28rpx; line-height: 1.68; overflow-wrap: anywhere; }.item-foot { min-height: 88rpx; border-top: 1rpx solid var(--color-line); color: var(--color-muted); font-size: 23rpx; }.delete-button { min-width: 112rpx; min-height: 88rpx; margin: 0; background: transparent; color: var(--color-danger); font-size: 24rpx; line-height: 88rpx; }.delete-button[disabled] { opacity: .46; }.list-foot { padding: 26rpx; color: var(--color-muted); font-size: 23rpx; text-align: center; }
.item-body--link { cursor: pointer; }.open-hint { display: block; min-height: 44rpx; margin-top: 8rpx; color: var(--color-action); font-size: 22rpx; font-weight: 700; }
.personal-page { --color-paper: #F5F7F6; --color-ink: #183C30; --color-deep: #183C30; --color-muted: #65736B; --color-action: #087C49; --color-line: #E1E7E3; background: #FFFFFF; }.personal-page .personal-title { font-size: 32rpx; font-weight: 600; }.personal-page .personal-list { gap: 0; }.personal-page .personal-card { padding: 26rpx 0; border: 0; border-bottom: 1rpx solid var(--color-line); border-radius: 0; box-shadow: none; }.personal-page .personal-tabs { border-radius: 12rpx; background: var(--color-paper); }.personal-page .personal-tab { min-height: 44px; }.personal-page .personal-tab.active { box-shadow: none; }.personal-page .delete-button { min-height: 44px; min-width: 44px; }.personal-page .open-hint { min-height: 44px; line-height: 44px; }.post-context { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; margin-top: 16rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.6; overflow-wrap: anywhere; word-break: break-all; }.post-school { color: var(--color-action); }.post-title { margin-bottom: 12rpx; color: var(--color-deep); font-size: 32rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }.personal-page .item-body { word-break: break-all; }.personal-page .card-head { flex-wrap: wrap; }
@media (min-width: 600px) { .personal-page { max-width: 720px; margin: 0 auto; padding-right: 32px; padding-left: 32px; } }
