.detail-page{min-height:100vh;box-sizing:border-box;padding:20rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));background:#fff;color:#172b3c;}.detail-tabs{display:flex;position:sticky;top:0;z-index:2;background:#fff;border-bottom:1rpx solid #e9efed;margin:12rpx 0 0;}.tab{flex:1;position:relative;padding:20rpx 0;margin:0;background:transparent;border-radius:0;font-size:25rpx;line-height:48rpx;color:#63718a;white-space:nowrap;}.tab--active{color:#07884d;font-weight:700;}.tab--active::before{content:'';position:absolute;bottom:0;left:12rpx;right:12rpx;height:5rpx;background:#079a58;border-radius:5rpx;}.timeline{padding-top:12rpx;}.timeline-step{display:flex;padding:0 14rpx;border-radius:18rpx;}.timeline-step--current{background:#eafff4;}.track{display:flex;flex-direction:column;align-items:center;width:46rpx;flex-shrink:0;margin-right:18rpx;padding-top:12rpx;}.node{width:44rpx;height:44rpx;line-height:44rpx;border-radius:50%;text-align:center;font-size:27rpx;background:#edf0f4;color:#26374a;}.node--green{background:#079652;color:#fff;}.connector{flex:1;width:3rpx;min-height:22rpx;background:#dce5e0;margin-top:4rpx;}.step-body{flex:1;min-width:0;padding-bottom:10rpx;}.step-heading{display:flex;align-items:center;gap:10rpx;text-align:left;min-height:88rpx;background:transparent;margin:0;padding:10rpx 0;line-height:1.45;}.step-heading-copy{flex:1;min-width:0;}.step-title{font-size:28rpx;font-weight:650;color:#172b3c;}.step-date,.step-note{font-size:24rpx;color:#63718a;margin-top:3rpx;line-height:1.5;}.disclosure{font-size:27rpx;color:#63718a;}.stage-panel{background:#fff;border:1rpx solid #e2f0e9;border-radius:16rpx;margin:4rpx 0 12rpx;padding:20rpx;}.panel-heading{display:flex;justify-content:space-between;padding-bottom:10rpx;font-size:26rpx;font-weight:600;border-bottom:1rpx solid #edf1ef;}.document-row{display:flex;align-items:center;gap:12rpx;padding:10rpx 0;font-size:26rpx;}.document-name{flex:1;min-width:0;overflow-wrap:break-word;}.status-text{font-size:24rpx;color:#63718a;flex-shrink:0;}.status-text--green{color:#087748;}.status-text--warning{color:#9a5d00;}.status-symbol{width:32rpx;height:32rpx;border-radius:50%;text-align:center;line-height:32rpx;color:#fff;font-size:24rpx;background:#738393;}.status-symbol--green{background:#079652;}.status-symbol--warning{background:#b87100;}.stage-fees,.fee-row{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;padding:12rpx 0 0;font-size:24rpx;color:#63718a;}.stage-fees{border-top:1rpx solid #edf1ef;margin-top:6rpx;}.stage-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx;}.stage-actions button{flex:1;min-width:180rpx;}.action-primary,.action-secondary{box-sizing:border-box;min-height:80rpx;padding:10rpx 16rpx;line-height:56rpx;font-size:25rpx;border-radius:12rpx;margin:0;}.action-primary{color:#fff;background:#07884d;}.action-secondary{color:#087748;background:#fff;border:1rpx solid #07884d;}.quiet,.section-copy,.empty-copy{font-size:25rpx;line-height:1.7;color:#63718a;padding:16rpx 0;}.empty-copy{padding:50rpx 20rpx;text-align:center;}.notice{display:flex;align-items:flex-start;gap:14rpx;margin-top:20rpx;padding:20rpx;background:#eafff4;color:#087448;border-radius:14rpx;font-size:24rpx;line-height:1.6;}.notice-icon{flex-shrink:0;border:2rpx solid #087448;border-radius:50%;width:28rpx;height:28rpx;line-height:28rpx;text-align:center;margin-top:4rpx;}.document-card,.fee-card{padding:22rpx 0;border-bottom:1rpx solid #edf1ef;}.filename{font-size:24rpx;color:#63718a;overflow-wrap:anywhere;}.review-note{margin-top:12rpx;padding:16rpx;background:#f5f8f6;font-size:25rpx;line-height:1.6;}.upload{margin-top:18rpx;display:inline-block;}.amount{font-size:34rpx;font-weight:650;margin-top:12rpx;}.history-event{border-left:3rpx solid #dcece3;padding:0 0 30rpx 24rpx;margin:26rpx 0 0 10rpx;}.event-date{font-size:23rpx;color:#63718a;}.event-message{font-size:27rpx;line-height:1.6;margin-top:8rpx;}button[disabled]{opacity:.5;}
