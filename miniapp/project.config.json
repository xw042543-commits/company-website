{
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "3.9.2",
  "miniprogramRoot": "miniprogram/",
  "projectname": "udajo-miniapp",
  "setting": {
    "checkSiteMap": true,
    "coverView": true,
    "es6": true,
    "minified": true,
    "postcss": true,
    "useCompilerPlugins": [
      "typescript"
    ],
    "minifyWXML": true,
    "minifyWXSS": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "assets/README.md"
      },
      {
        "type": "folder",
        "value": "components/university-card"
      }
    ],
    "include": []
  }
}
