<view class="page detail-page">
  <view wx:if="{{loading}}" class="empty">正在加载真实专业资料…</view>
  <view wx:elif="{{error}}" class="empty"><view class="empty-title">暂时无法打开</view><view>{{error}}</view><button class="secondary retry" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="hero card">
      <image wx:if="{{programme.imageUrl}}" class="hero-image" src="{{programme.imageUrl}}" mode="aspectFill" />
      <view class="eyebrow">{{programme.universityName}}</view>
      <view class="title">{{programme.displayName}}</view>
      <view class="subtitle">{{programme.nameEn}}</view>
      <view class="chips"><text>{{programme.studyLevelLabel}}</text><text>{{programme.duration}}</text><text>{{programme.city}}</text></view>
      <view class="actions"><button class="primary" bindtap="consult">咨询顾问</button><button class="secondary" loading="{{savingFavorite}}" disabled="{{savingFavorite}}" bindtap="toggleFavorite">{{favorite ? '已收藏' : '收藏'}}</button></view>
    </view>
    <scroll-view scroll-x class="tabs">
      <view class="tab {{active === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTab">{{item.label}}</view>
    </scroll-view>
    <view wx:if="{{active === 'intro'}}" class="card section"><view class="number">01</view><view class="section-title">介绍</view><view class="body">{{programme.description}}</view></view>
    <view wx:if="{{active === 'basic'}}" class="card section"><view class="number">02</view><view class="section-title">基本信息</view><view class="fact"><text>学历</text><text>{{programme.studyLevelLabel}}</text></view><view class="fact"><text>学制</text><text>{{programme.duration}}</text></view><view class="fact"><text>校区</text><text>{{programme.city}}</text></view><view class="fact"><text>授课语言</text><text>{{programme.languages}}</text></view><view class="fact"><text>入学时间</text><text>{{programme.intakes}}</text></view><view class="fact"><text>学费</text><text>{{programme.tuition}}</text></view></view>
    <view wx:if="{{active === 'admissions'}}" class="card section"><view class="number">03</view><view class="section-title">录取要求</view><block wx:if="{{programme.admissions.length}}"><view class="detail-block" wx:for="{{programme.admissions}}" wx:key="sortOrder"><view class="block-title">{{item.title}}</view><view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="body">{{paragraph}}</view></view></block><view wx:else class="muted">该专业的官方录取要求正在核验，请咨询顾问获取最新要求。</view></view>
    <view wx:if="{{active === 'curriculum'}}" class="card section"><view class="number">04</view><view class="section-title">课程安排</view><block wx:if="{{programme.curriculum.length}}"><view class="detail-block" wx:for="{{programme.curriculum}}" wx:key="sortOrder"><view class="block-title">{{item.title}}</view><view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="body">{{paragraph}}</view></view></block><view wx:else class="muted">课程模块正在完善，最终安排以大学最新课程手册为准。</view></view>
    <view wx:if="{{active === 'career'}}" class="card section"><view class="number">05</view><view class="section-title">就业方向</view><block wx:if="{{programme.careers.length}}"><view class="detail-block" wx:for="{{programme.careers}}" wx:key="sortOrder"><view class="block-title">{{item.title}}</view><view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="body">{{paragraph}}</view></view></block><view wx:else class="muted">就业方向资料正在完善，可提交咨询获得个性化职业建议。</view></view>
  </block>
</view>
