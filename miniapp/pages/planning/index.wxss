.heading { margin: 12rpx 0 32rpx; }.heading > view { flex: 1; }.me-link { color: #078e50; border: 1rpx solid #8fcdae; border-radius: 28rpx; padding: 10rpx 22rpx; margin-left: 20rpx; }.steps { display: flex; align-items: flex-start; justify-content: center; margin-bottom: 18rpx; }.step { width: 140rpx; text-align: center; color: #98a29d; }.step text { display: block; margin: auto; width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; background: #dfe6e2; color: #fff; }.step label { display: block; font-size: 22rpx; margin-top: 10rpx; }.step.done { color: #078e50; }.step.done text { background: #079653; }.line { height: 4rpx; width: 65rpx; background: #dfe6e2; margin-top: 22rpx; }.line.done { background: #079653; }.progress { height: 5rpx; background: #e5ece8; border-radius: 5rpx; margin-bottom: 26rpx; }.progress view { height: 100%; background: #079653; transition: width .2s; }.options { display: flex; flex-wrap: wrap; gap: 16rpx; }.option { min-width: 138rpx; text-align: center; box-sizing: border-box; padding: 20rpx 24rpx; border: 1rpx solid #dce7e1; background: #fafcfb; border-radius: 12rpx; }.option.selected { color: #078e50; background: #e9f8f0; border-color: #079653; }.block-space { margin-top: 38rpx; }.summary { line-height: 2.2; color: #526158; background: #f6faf8; border-radius: 14rpx; padding: 22rpx; }.footer { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 16rpx; }
