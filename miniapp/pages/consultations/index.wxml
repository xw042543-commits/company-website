<view class="page"><button class="primary new" bindtap="create">发起新咨询</button><view wx:if="{{loading}}" class="empty">正在同步咨询记录…</view><view wx:elif="{{error && !items.length}}" class="empty"><view class="empty-title">暂时无法加载</view><view>{{error}}</view><button class="secondary retry" bindtap="load">重新加载</button></view><block wx:else><view wx:if="{{error}}" class="error">{{error}}，当前显示上次同步内容。</view><view wx:if="{{!items.length}}" class="empty"><view class="empty-title">暂无咨询记录</view><view>提交咨询后，这里会显示成功编号。</view></view><view wx:for="{{items}}" wx:key="id" class="card record"><view class="row between"><view class="section-title">{{item.school || '留学咨询'}}</view><text class="status">{{item.statusText}}</text></view><view>{{item.course || '未指定专业'}}</view><view class="reference">咨询编号：{{item.referenceCode}}</view><view class="subtitle">提交时间：{{item.date}}</view></view></block></view>
