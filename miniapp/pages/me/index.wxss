.me-page { padding-top: 0; }.profile { margin: 0 -28rpx 26rpx; padding: 72rpx 36rpx 80rpx; background: linear-gradient(145deg, #087d48, #0aa562); color: #fff; display: flex; align-items: center; }.avatar { width: 104rpx; height: 104rpx; line-height: 104rpx; text-align: center; border-radius: 50%; background: rgba(255,255,255,.92); color: #078e50; font-size: 45rpx; margin-right: 24rpx; }.profile-name { font-size: 35rpx; font-weight: 700; }.profile-note { opacity: .8; margin-top: 8rpx; font-size: 24rpx; }.stats { display: flex; justify-content: space-around; margin-top: -55rpx; position: relative; }.stats view { flex: 1; text-align: center; border-right: 1rpx solid #edf1ee; }.stats view:last-child { border: 0; }.stats text, .stats label { display: block; }.stats text { font-size: 36rpx; font-weight: 700; color: #087f49; }.stats label { font-size: 23rpx; color: #7a857f; margin-top: 4rpx; }.menu { padding: 0 28rpx; }.menu-item { display: grid; grid-template-columns: 64rpx 1fr 30rpx; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #edf1ee; }.menu-item:last-child { border: 0; }.menu-item view text, .menu-item view label { display: block; }.menu-item view text { font-weight: 650; }.menu-item view label { color: #8a958f; font-size: 22rpx; margin-top: 5rpx; }.icon { color: #079653; font-size: 38rpx; }.arrow { color: #a8b0ac; font-size: 40rpx; }.account view:not(.section-title) { display: flex; justify-content: space-between; padding: 14rpx 0; color: #69756e; }.logout { margin-top: 24rpx; }
