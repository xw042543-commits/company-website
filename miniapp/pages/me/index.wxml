<view class="page me-page">
  <view class="profile">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-copy" wx:if="{{session && session.authenticated}}"><view class="profile-name">{{session.fullName}}</view><view class="profile-note">{{account ? (account.phone || account.email || '已登录用户') : '正在同步账户资料…'}}</view></view>
    <view class="profile-copy" wx:else bindtap="login"><view class="profile-name">点击登录</view><view class="profile-note">登录后保存你的留学旅程</view></view>
  </view>
  <view class="stats card"><view><text>{{counts.favorites}}</text><label>收藏</label></view><view><text>{{counts.plans}}</text><label>规划</label></view><view><text>{{counts.consultations}}</text><label>咨询</label></view></view>
  <view class="menu card">
    <view class="menu-item" data-url="/pages/favorites/index" bindtap="open"><text class="icon">♡</text><view><text>我的收藏</text><label>已收藏的院校与专业</label></view><text class="arrow">›</text></view>
    <view class="menu-item" data-url="/pages/plans/index" bindtap="open"><text class="icon">▣</text><view><text>我的规划</text><label>查看和继续编辑规划</label></view><text class="arrow">›</text></view>
    <view class="menu-item" data-url="/pages/consultations/index" bindtap="open"><text class="icon">◇</text><view><text>咨询记录</text><label>查看咨询编号和状态</label></view><text class="arrow">›</text></view>
  </view>
  <view class="card account" wx:if="{{account}}"><view class="section-title">账户信息</view><view><text>姓名</text><text>{{account.fullName}}</text></view><view><text>联系方式</text><text>{{account.phone || account.email || '未设置'}}</text></view><view><text>验证状态</text><text>{{account.phoneVerified || account.emailVerified ? '已验证' : '待验证'}}</text></view></view>
  <button wx:if="{{session && session.authenticated}}" class="secondary logout" bindtap="logout">退出登录</button>
</view>
