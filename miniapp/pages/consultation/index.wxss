.intro { margin-bottom: 28rpx; }.qualifications { display: flex; gap: 12rpx; flex-wrap: wrap; }.qualifications text { padding: 16rpx 24rpx; background: #f4f7f5; border: 1rpx solid #dce6e0; border-radius: 10rpx; }.qualifications .selected { color: #078e50; background: #e8f8ef; border-color: #079653; }.consent { display: flex; align-items: flex-start; color: #66736c; font-size: 24rpx; line-height: 1.6; }.submit { margin-top: 28rpx; }.result { text-align: center; margin-top: 80rpx; }.check { margin: 0 auto 26rpx; width: 92rpx; height: 92rpx; line-height: 92rpx; border-radius: 50%; color: #fff; background: #079653; font-size: 50rpx; }.reference { margin: 32rpx 0; padding: 24rpx; background: #eff8f3; border-radius: 12rpx; color: #087847; word-break: break-all; }
