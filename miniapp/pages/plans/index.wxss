.new { margin-bottom: 24rpx; }.status { color: #078e50; background: #e9f8f0; padding: 7rpx 14rpx; border-radius: 24rpx; font-size: 22rpx; }.meta { color: #89948e; font-size: 23rpx; margin: 22rpx 0; }.actions { display: grid; grid-template-columns: 1fr 120rpx; gap: 14rpx; }.delete { color: #b04b3a; background: #fff5f2; border: 0; height: 84rpx; line-height: 84rpx; border-radius: 12rpx; }.delete::after { border: 0; }
