<view class="page"><button class="primary new" bindtap="create">新建留学规划</button><view wx:if="{{loading}}" class="empty">正在同步规划…</view><view wx:elif="{{error && !items.length}}" class="empty"><view class="empty-title">暂时无法加载</view><view>{{error}}</view><button class="secondary retry" bindtap="load">重新加载</button></view><block wx:else><view wx:if="{{error}}" class="error">{{error}}，当前显示上次同步内容。</view><view wx:if="{{!items.length}}" class="empty"><view class="empty-title">暂无规划</view><view>用三步表单记录你的留学目标。</view></view><view wx:for="{{items}}" wx:key="id" class="card plan"><view class="row between"><view class="section-title">{{item.form.goal}} · {{item.form.country}}</view><text class="status">{{item.statusText}}</text></view><view class="subtitle">{{item.subjectsText}}</view><view class="meta">{{item.form.intake || '入学时间待确认'}} · 更新于 {{item.date}}</view><view class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="edit">继续编辑</button><button class="delete" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></block></view>
