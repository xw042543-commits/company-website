# Spring Boot
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 留学咨询（本地开发默认开启；生产环境必须使用已批准的隐私声明版本）
APP_CONSULTATION_SUBMISSION_ENABLED=true
APP_CONSULTATION_PRIVACY_NOTICE_VERSION=local-enquiry-v1
APP_CONSULTATION_MAXIMUM_BODY_SIZE=16KB
APP_CONSULTATION_RATE_LIMIT_MAXIMUM_SUBMISSIONS=5
APP_CONSULTATION_RATE_LIMIT_WINDOW=10m
# 站点统一可信代理：只填写可直连后端的精确 IPv4/IPv6，多个用逗号分隔；本地直连留空。
# 旧 APP_CONSULTATION_TRUSTED_PROXIES / APP_AUTH_TRUSTED_PROXIES 可暂时回退，配置冲突时启动失败。
APP_TRUSTED_PROXIES=

# 用户认证（生产默认关闭；正式协议和通知服务验收后再开启）
APP_AUTH_REGISTRATION_ENABLED=false
APP_AUTH_PHONE_REGISTRATION_ENABLED=true
APP_AUTH_AGREEMENT_VERSION=
APP_AUTH_PRIVACY_VERSION=
APP_AUTH_SESSION_TIMEOUT=24h
# Set true in production; the production profile rejects false at startup.
APP_SESSION_COOKIE_SECURE=false
APP_AUTH_REMEMBERED_SESSION_TIMEOUT=30d
APP_AUTH_EMAIL_VERIFICATION_TTL=30m
APP_AUTH_PHONE_VERIFICATION_TTL=10m
APP_AUTH_PASSWORD_RESET_TTL=30m
APP_AUTH_MAXIMUM_BODY_SIZE=8KB
APP_AUTH_REGISTRATION_PER_IP=5
APP_AUTH_REGISTRATION_PER_IDENTIFIER=3
APP_AUTH_RESEND_PER_IP=10
APP_AUTH_RESEND_PER_IDENTIFIER=3
APP_AUTH_VERIFICATION_PER_IP=30
APP_AUTH_LOGIN_PER_IP=20
APP_AUTH_LOGIN_PER_IDENTIFIER=10
APP_AUTH_RATE_LIMIT_WINDOW=1h
# 生产代理入口需删除客户端 Forwarded 并覆盖 X-Forwarded-Proto 为 https/http。
# APP_TRUSTED_PROXIES 不支持 CIDR；留空时生产仅接受直接 TLS 请求。
# 生产注册门控：Task 5 接入并验收正式邮件/短信实现后才可配置 EXTERNAL
APP_AUTH_PRODUCTION_NOTIFICATION_PROVIDER=NONE
# 域名验收后仅可设 YANGDOUJIAO_COM（含其点分子域）
APP_AUTH_APPROVED_DOMAIN=NONE
# 生产即使关闭注册，也必须设置已批准的 HTTPS 官网来源，并令 CORS_ALLOWED_ORIGINS 与之完全相同。
APP_AUTH_PUBLIC_SITE_ORIGIN=
APP_AUTH_PRODUCTION_LAUNCH_APPROVED=false
# 本地 dev/test 可通过 /api/dev/auth/notifications/latest?identifier=... 读取一次性验证码；生产环境不存在该接口。

# PostgreSQL
POSTGRES_DB=company_website
POSTGRES_USER=company_app
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_local_password

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# Next.js server
API_BASE_URL=http://localhost:8080

# Production deployments use deploy/.env.production.example instead.
# Keep real production values in an untracked file or hosting-provider secret store.
